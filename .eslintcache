:"84"},{"filePath":"135","messages":"136","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"137","messages":"138","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"139","messages":"140","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"141","messages":"142","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"143","messages":"144","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"145","messages":"146","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"147","messages":"148","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"149","messages":"150","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"151","messages":"152","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"153","messages":"154","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"155","messages":"156","errorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":"157","usedDeprecatedRules":"84"},{"filePath":"158","messages":"159","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"160","usedDeprecatedRules":"84"},{"filePath":"161","messages":"162","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"163","messages":"164","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},{"filePath":"165","messages":"166","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"84"},"D:\\Old.St Labs\\project-measure-frontend\\src\\index.js",[],["167","168","169"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\store.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\reportWebVitals.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\App\\AppContainer.js",["170"],"import React from 'react';\r\nimport { Switch, Route, Redirect, useHistory } from 'react-router-dom';\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport Spinner from 'react-bootstrap/Spinner';\r\nimport routes from '../../config/routes';\r\nimport AppLoadingContainer from '../AppLoading/AppLoadingContainer';\r\nimport AppModal from '../../components/base/Modal/Modal';\r\nimport FlashNotification from '../../components/modules/FlashNotification/FlashNotification';\r\nimport WrapperBackground from '../../components/base/WrapperBackground/WrapperBackground';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Navbar from '../../components/base/Navbar/Navbar';\r\nimport { clearModalContent } from '../../redux/modules/modalEvent';\r\nimport { setLoggingOut } from '../../redux/modules/authentication';\r\nimport navbarBrand from '../../assets/logos/mariana_logo.png';\r\n\r\nimport {\r\n    Nav,\r\n    UncontrolledDropdown,\r\n    DropdownItem,\r\n    DropdownMenu,\r\n    DropdownToggle\r\n} from 'reactstrap';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\n\r\nconst loading = () => (\r\n    <WrapperBackground>\r\n        <Spinner animation='border' role='status'>\r\n            <span className='sr-only'>Loading...</span>\r\n        </Spinner>\r\n    </WrapperBackground>\r\n);\r\n\r\nfunction App() {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n    const { modalContent, onToggle, ...modalEvent } = useSelector(({ modalEvent }) => modalEvent);\r\n    const { isAuthed } = useSelector(({ authentication }) => authentication);\r\n\r\n    const sidebarMenu = [{\r\n        label: 'Dashboard',\r\n        onClick: () => history.push('/dashboard'),\r\n        key: 'dashboard'\r\n    }, {\r\n        label: 'Alerts',\r\n        onClick: () => history.push('/alerts'),\r\n        key: 'alerts'\r\n    }, {\r\n        label: 'Behaviours',\r\n        onClick: () => history.push('/behaviours'),\r\n        key: 'behaviours'\r\n    }];\r\n\r\n    const handleCloseModal = () => {\r\n        dispatch(clearModalContent());\r\n        onToggle && onToggle();\r\n\r\n        // To show modal, do this something like this:\r\n        // dispatch(setModalContent({\r\n        //     modalContent: <LoginContainer />,\r\n        //     title: 'Login'\r\n        // }));\r\n    };\r\n\r\n    const NavbarLinks = () => {\r\n        return (\r\n            <Nav className='navlinks-right'>\r\n                <UncontrolledDropdown nav={true} direction='down' className='d-flex align-self-center mr-4'>\r\n                    <Notifications />\r\n                </UncontrolledDropdown>\r\n                <UncontrolledDropdown nav={true} direction='down' className='mr-4'>\r\n                    <NavbarAccount />\r\n                </UncontrolledDropdown>\r\n            </Nav>\r\n        );\r\n    };\r\n\r\n    return (\r\n        <AppLoadingContainer>\r\n            <div id='outer-container'>\r\n                {/* {isAuthed && <Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>} */}\r\n                {<Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>}\r\n                <React.Suspense fallback={loading()}>\r\n                    <Switch>\r\n                        {routes.map((route, i) => (\r\n                            route.authedRoute\r\n                                ? <PrivateRoute key={i} {...route} sidebarMenu={sidebarMenu}\r\n                                    handleCloseModal={handleCloseModal}\r\n                                    isAuthed={isAuthed} />\r\n                                : <RouteWithSubRoutes key={i} {...route} handleCloseModal={handleCloseModal} />\r\n                        ))}\r\n                    </Switch>\r\n                </React.Suspense>\r\n            </div>\r\n\r\n            <FlashNotification/>\r\n            <AppModal\r\n                {...modalEvent}\r\n                isShow={!!modalContent}\r\n                onToggle={handleCloseModal}>\r\n                {modalContent}\r\n            </AppModal>\r\n        </AppLoadingContainer>\r\n    );\r\n}\r\n\r\nconst Notifications = () => {\r\n    return (\r\n        <div className='navbar__notifications'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__notification-bell' icon='bell' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true} className='mt-2 pb-4 navbar__navbar__notifications-dropdown'>\r\n                <DropdownItem header={true} tag='div' style={{ cursor: 'default' }}>\r\n                    <Typography weight='semi-bold' className='py-2 pb-4'>Notifications</Typography>\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\nconst NavbarAccount = () => {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n\r\n    const logout = () => {\r\n        localStorage.clear();\r\n        dispatch(setLoggingOut());\r\n        history.push('/login');\r\n    };\r\n\r\n    return (\r\n        <div className='navbar__account'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__user-icon' icon='user-circle' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true}>\r\n                <DropdownItem onClick={() => history.push('/reset-password')}>\r\n                    Change Password\r\n                </DropdownItem>\r\n                <DropdownItem onClick={logout}>\r\n                    Logout\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\n// A special wrapper for <Route> that knows how to\r\n// handle \"sub\"-routes by passing them in a `routes`\r\n// prop to the component it renders.\r\nfunction RouteWithSubRoutes({ component: Component, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route\r\n            {...rest}\r\n            render={props => (\r\n                // pass the sub-routes down to keep nesting\r\n                <Component {...props} routes={props.routes} handleCloseModal={handleCloseModal} />\r\n            )} />\r\n    );\r\n}\r\n\r\nfunction PrivateRoute({ component: Component, isAuthed, sidebarMenu, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route {...rest} render={(routeProps) => (\r\n            <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            // isAuthed\r\n            //     ? <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            //     : <Redirect to={{\r\n            //         pathname: '/login',\r\n            //         state: { from: routeProps.location }\r\n            //     }}/>\r\n        )}/>\r\n    );\r\n}\r\n\r\nexport default App;\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\reducers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AppLoading\\AppLoadingContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\modalEvent.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\routes.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\WrapperBackground\\WrapperBackground.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Modal\\Modal.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Navbar\\Navbar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\FlashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",["171","172","173","174"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport { useHistory } from 'react-router-dom';\r\n\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport { faCoffee } from '@fortawesome/free-solid-svg-icons';\r\nimport Login from './LoginScreen';\r\nimport { isValidEmail } from '../../utils/helpers';\r\nimport { authUser } from '../../redux/modules/authentication';\r\nimport { saveAuthorizationToken, checkAuthorization } from '../../utils/Auth';\r\nimport { setFlashNotification } from '../../redux/modules/flashNotification';\r\n\r\ntype Props = {\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function LoginContainer({\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const history = useHistory();\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [errMsg, setErrMsg] = useState('');\r\n    const [loginForm, setLoginForm] = useState({\r\n        email: '',\r\n        password: ''\r\n    });\r\n\r\n    // check if user is logged in\r\n    // useEffect(() => {\r\n    //     checkAuth();\r\n    // }, []);\r\n\r\n    // const checkAuth = async () => {\r\n    //     const auth = await checkAuthorization();\r\n\r\n    //     if (auth) history.push('/dashboard');\r\n    // };\r\n\r\n    const onSubmit = async e => {\r\n        setIsLoading(true);\r\n        setErrMsg('');\r\n        e.preventDefault();\r\n\r\n        try {\r\n            if (isValidEmail(loginForm.email) && loginForm.password) {\r\n                // const response = await userLogin(loginForm);\r\n\r\n                // if (Object.keys(response).length === 0) {\r\n                //     setErrMsg('Invalid email!');\r\n                // } else if (response.data.message) {\r\n                //     setErrMsg(response.data.message);\r\n                // } else {\r\n                //     const { data } = response;\r\n\r\n                //     localStorage.setItem('userId', data.userId);\r\n                //     saveAuthorizationToken(data.token);\r\n                //     dispatch(authUser({\r\n                //         email: loginForm.email\r\n                //     }));\r\n\r\n                //     history.replace('/dashboard');\r\n                // }\r\n\r\n                localStorage.setItem('userId', 1);\r\n                saveAuthorizationToken('temp_token');\r\n                dispatch(authUser({\r\n                    email: loginForm.email\r\n                }));\r\n\r\n                history.replace('/dashboard');\r\n            }\r\n        } catch (err) {\r\n            dispatch(setFlashNotification({\r\n                message: 'ERROR',\r\n                isError: true\r\n            }));\r\n        }\r\n    };\r\n\r\n    const onChange = e => {\r\n        const { name, value } = e.target;\r\n\r\n        setLoginForm({\r\n            ...loginForm,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    return <Login\r\n        onSubmit={onSubmit}\r\n        onChange={onChange}\r\n        isLoading={isLoading}\r\n        errMsg={errMsg}\r\n        setErrMsg={setErrMsg}\r\n        handleCloseModal={handleCloseModal} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CustomDropdown\\CustomDropdown.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Table\\Table.js",["175","176","177","178","179","180","181","182","183","184","185"],"// @flow\nimport React, { useState } from 'react';\nimport moment from 'moment';\nimport { useTable, useFilters, useGlobalFilter, useAsyncDebounce } from 'react-table';\nimport Button from '../Button/Button';\nimport CustomDropdown from '../CustomDropdown/CustomDropdown';\nimport Typography from '../Typography/Typography';\nimport { Table as ReactTable, FormGroup, Label, Input } from 'reactstrap';\nimport { matchSorter } from 'match-sorter';\nimport { makeData } from '../../../utils/helpers';\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\nimport './table.scss';\n\ntype Props = {\n    className?: string\n}\n\nexport default function Table({ className = '' }: Props): React$Element<any> {\n    const [dummy, setDummy] = useState({\n        dummy: [\n            {\n                alertType: 'Insider Trading',\n                assigned: 'Mark Thomson',\n                broker: 'Peter Davidson',\n                client: 'Client 1',\n                date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 4, 7).getTime())),\n                escalation: 'Base',\n                identifier: 'MUA312',\n                quantity: 89,\n                status: 'Resolved',\n                subRows: undefined,\n                ticker: 'BP'\n            },\n            {\n                alertType: 'Marking the Close',\n                assigned: 'Mark Jonas',\n                broker: 'Peter Jonas',\n                client: 'Client 2',\n                date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 4, 20).getTime())),\n                escalation: 'Manager',\n                identifier: 'MUA311',\n                quantity: 25,\n                status: 'Open',\n                subRows: undefined,\n                ticker: 'SDR'\n            },\n            {\n                alertType: 'Marking the Close',\n                assigned: 'Mark Jonas',\n                broker: 'Peter Jonas',\n                client: 'Client 2',\n                date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 4, 20).getTime())),\n                escalation: 'Manager',\n                identifier: 'MUA311',\n                quantity: 25,\n                status: 'Open',\n                subRows: undefined,\n                ticker: 'SDR'\n            },\n            {\n                alertType: 'Marking the Close',\n                assigned: 'Mark Jonas',\n                broker: 'Peter Jonas',\n                client: 'Client 2',\n                date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 4, 20).getTime())),\n                escalation: 'Manager',\n                identifier: 'MUA311',\n                quantity: 25,\n                status: 'Open',\n                subRows: undefined,\n                ticker: 'SDR'\n            },\n            {\n                alertType: 'Marking the Close',\n                assigned: 'Mark Jonas',\n                broker: 'Peter Jonas',\n                client: 'Client 2',\n                date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 4, 20).getTime())),\n                escalation: 'Manager',\n                identifier: 'MUA311',\n                quantity: 25,\n                status: 'Open',\n                subRows: undefined,\n                ticker: 'SDR'\n            }\n        ],\n        filtered: []\n    })\n;\n\n    // Define a default UI for filtering\n    function GlobalFilter({\n        preGlobalFilteredRows,\n        globalFilter,\n        setGlobalFilter\n    }) {\n        const count = preGlobalFilteredRows.length;\n        const [value, setValue] = React.useState(globalFilter);\n        const onChange = useAsyncDebounce(value => {\n            setGlobalFilter(value || undefined);\n        }, 200);\n\n        return (\n            <span>\n                Search:{' '}\n                <input\n                    value={value || ''}\n                    onChange={e => {\n                        setValue(e.target.value);\n                        onChange(e.target.value);\n                    }}\n                    placeholder={`${count} records...`}\n                    style={{\n                        fontSize: '1.1rem',\n                        border: '0'\n                    }}/>\n            </span>\n        );\n    }\n\n    // Define a default UI for filtering\n    function DefaultColumnFilter({\n        column: { filterValue, preFilteredRows, setFilter }\n    }) {\n        const count = preFilteredRows.length;\n\n        return (\n            <input\n                value={filterValue || ''}\n                onChange={e => {\n                    setFilter(e.target.value || undefined); // Set undefined to remove the filter entirely\n                }}\n                placeholder={`Search ${count} records...`}/>\n        );\n    }\n\n    // Define a default UI for filtering\n    function onFilteredChangeCustom(value, accessor) {\n        setDummy({\n            ...dummy,\n            filtered: [{\n                id: accessor,\n                value\n            }]\n        });\n    }\n\n    // This is a custom filter UI for selecting\n    // a unique option from a list\n    function SelectColumnFilter({\n        column: { filterValue, setFilter, preFilteredRows, id }\n    }) {\n    // Calculate the options for filtering\n    // using the preFilteredRows\n        const options = React.useMemo(() => {\n            const options = new Set();\n\n            preFilteredRows.forEach(row => {\n                options.add(row.values[id]);\n            });\n\n            return [...options.values()];\n        }, [id, preFilteredRows]);\n\n        // Render a multi-select box\n        return (\n            <select\n                value={filterValue}\n                onChange={e => {\n                    setFilter(e.target.value || undefined);\n                }}>\n                <option value=''>All</option>\n                {options.map((option, i) => (\n                    <option key={i} value={option}>\n                        {option}\n                    </option>\n                ))}\n            </select>\n        );\n    }\n\n    // This is a custom filter UI that uses a\n    // slider to set the filter value between a column's\n    // min and max values\n    function SliderColumnFilter({\n        column: { filterValue, setFilter, preFilteredRows, id }\n    }) {\n    // Calculate the min and max\n    // using the preFilteredRows\n        const [min, max] = React.useMemo(() => {\n            let min = preFilteredRows.length ? preFilteredRows[0].values[id] : 0;\n            let max = preFilteredRows.length ? preFilteredRows[0].values[id] : 0;\n\n            preFilteredRows.forEach(row => {\n                min = Math.min(row.values[id], min);\n                max = Math.max(row.values[id], max);\n            })\n            ;\n\n            return [min, max];\n        }, [id, preFilteredRows]);\n\n        return (\n            <>\n                <input\n                    type='range'\n                    min={min}\n                    max={max}\n                    value={filterValue || min}\n                    onChange={e => {\n                        setFilter(parseInt(e.target.value, 10));\n                    }}/>\n                <button onClick={() => setFilter(undefined)}>Off</button>\n            </>\n        );\n    }\n\n    // This is a custom UI for our 'between' or number range\n    // filter. It uses two number boxes and filters rows to\n    // ones that have values between the two\n    function NumberRangeColumnFilter({\n        column: { filterValue = [], preFilteredRows, setFilter, id }\n    }) {\n        const [min, max] = React.useMemo(() => {\n            let min = preFilteredRows.length ? preFilteredRows[0].values[id] : 0;\n            let max = preFilteredRows.length ? preFilteredRows[0].values[id] : 0;\n\n            preFilteredRows.forEach(row => {\n                min = Math.min(row.values[id], min);\n                max = Math.max(row.values[id], max);\n            });\n\n            return [min, max];\n        }, [id, preFilteredRows]);\n\n        return (\n            <div\n                style={{\n                    display: 'flex'\n                }}>\n                <input\n                    value={filterValue[0] || ''}\n                    type='number'\n                    onChange={e => {\n                        const val = e.target.value;\n\n                        setFilter((old = []) => [val ? parseInt(val, 10) : undefined, old[1]]);\n                    }}\n                    placeholder={`Min (${min})`}\n                    style={{\n                        width: '70px',\n                        marginRight: '0.5rem'\n                    }}/>\n                to\n                <input\n                    value={filterValue[1] || ''}\n                    type='number'\n                    onChange={e => {\n                        const val = e.target.value;\n\n                        setFilter((old = []) => [old[0], val ? parseInt(val, 10) : undefined]);\n                    }}\n                    placeholder={`Max (${max})`}\n                    style={{\n                        width: '70px',\n                        marginLeft: '0.5rem'\n                    }}/>\n            </div>\n        );\n    }\n\n    function fuzzyTextFilterFn(rows, id, filterValue) {\n        return matchSorter(rows, filterValue, { keys: [row => row.values[id]] });\n    }\n\n    // Let the table remove the filter if the string is empty\n    fuzzyTextFilterFn.autoRemove = val => !val;\n\n    // Our table component\n    function Table({ columns, data }) {\n        const filterTypes = React.useMemo(\n            () => ({\n                // Add a new fuzzyTextFilterFn filter type.\n                fuzzyText: fuzzyTextFilterFn,\n                // Or, override the default text filter to use\n                // \"startWith\"\n                text: (rows, id, filterValue) => {\n                    return rows.filter(row => {\n                        const rowValue = row.values[id]\n;\n\n                        return rowValue !== undefined\n                            ? String(rowValue)\n                                .toLowerCase()\n                                .startsWith(String(filterValue).toLowerCase())\n                            : true;\n                    });\n                }\n            }),\n            []\n        );\n\n        const defaultColumn = React.useMemo(() => ({\n            // Let's set up our default Filter UI\n            Filter: DefaultColumnFilter\n        }), []);\n\n        const {\n            getTableProps,\n            getTableBodyProps,\n            headerGroups,\n            rows,\n            prepareRow,\n            state,\n            visibleColumns,\n            preGlobalFilteredRows,\n            setGlobalFilter\n        } = useTable(\n            {\n                columns,\n                data,\n                defaultColumn, // Be sure to pass the defaultColumn option\n                filterTypes\n            },\n            useFilters, // useFilters!\n            useGlobalFilter // useGlobalFilter!\n        );\n\n        // We don't want to render all of the rows for this example, so cap\n        // it for this use case\n        const firstPageRows = rows.slice(0, 10);\n\n        return (\n            <>\n                <ReactTable {...getTableProps()} filterable='true' filtered={dummy.filtered}\n                    className='react-table'>\n                    <thead>\n                        {headerGroups.map(headerGroup => (\n                            <tr {...headerGroup.getHeaderGroupProps()} className='react-table__table-head-rows'>\n                                {headerGroup.headers.map(column => (\n                                    <th {...column.getHeaderProps()}>\n                                        {column.render('Header').toLowerCase() !== 'identifier'\n                                            ? <CustomDropdown tag='span' direction='down' toggle={<Typography variant='size-16' color='color-3' weight='bold'\n                                                className='text-decoration-none cursor-pointer d-flex align-items-center'>\n                                                {column.render('Header')}\n                                                {column.render('Header').toLowerCase() !== 'Identifier'\n                                                    ? <FontAwesomeIcon className='ml-2' icon='filter' size='xs'\n                                                        color='black' />\n                                                    : null\n                                                }\n                                            </Typography>}>\n                                                <div className='react-table__column-dropdown-filter'>\n                                                    <div className='react-table__column-dropdown-header'>\n                                                        <FontAwesomeIcon icon='filter' color='black' size='sm' />\n                                                    </div>\n                                                    <div className='react-table__column-dropdown-options'>\n                                                        {column.render('Header').toLowerCase() === 'date'\n                                                            ? <>\n                                                                <FormGroup check={true}>\n                                                                    <Label check={true}>\n                                                                        <Input type='radio' name='radio1'\n                                                                            onChange={entry => {\n                                                                                onFilteredChangeCustom(\n                                                                                    moment().format('L'),\n                                                                                    'Today'\n                                                                                );\n                                                                            }} />{' '}\n                                                                        Today\n                                                                    </Label>\n                                                                </FormGroup>\n                                                                <FormGroup check={true}>\n                                                                    <Label check={true}>\n                                                                        <Input type='radio' name='radio2'\n                                                                            onChange={entry => {\n                                                                                onFilteredChangeCustom(\n                                                                                    moment().utc().subtract(7, 'd').format('L'),\n                                                                                    'Last 7 Days'\n                                                                                );\n                                                                            }} />{' '}\n                                                                        Last 7 Days\n                                                                    </Label>\n                                                                </FormGroup>\n                                                                <FormGroup check={true}>\n                                                                    <Label check={true}>\n                                                                        <Input type='radio' name='radio3'\n                                                                            onChange={entry => {\n                                                                                onFilteredChangeCustom(\n                                                                                    'specific',\n                                                                                    'Specific Date'\n                                                                                );\n                                                                            }} />{' '}\n                                                                        Specific Date\n                                                                    </Label>\n                                                                </FormGroup>\n                                                            </>\n                                                            : null\n                                                        }\n                                                    </div>\n                                                    <div className='react-table__column-dropdown-footer'>\n                                                        <Button label='Reset' color='primary' />\n                                                    </div>\n                                                </div>\n                                            </CustomDropdown>\n                                            : <Typography variant='size-16' color='color-3' weight='bold'\n                                                className='text-decoration-none'>\n                                                {column.render('Header')}\n                                            </Typography>\n                                        }\n                                        {/* Render the columns filter UI */}\n                                        <div>{column.canFilter ? column.render('Filter') : null}</div>\n                                    </th>\n                                ))}\n                            </tr>\n                        ))}\n                        {/* <tr>\n                            <th\n                                colSpan={visibleColumns.length}\n                                style={{\n                                    textAlign: 'left'\n                                }}>\n                                <GlobalFilter\n                                    preGlobalFilteredRows={preGlobalFilteredRows}\n                                    globalFilter={state.globalFilter}\n                                    setGlobalFilter={setGlobalFilter}/>\n                            </th>\n                        </tr> */}\n                    </thead>\n                    <tbody {...getTableBodyProps()}>\n                        {firstPageRows.map((row, i) => {\n                            prepareRow(row);\n\n                            return (\n                                <tr {...row.getRowProps()} className='react-table__table-body-rows'>\n                                    {row.cells.map(cell => {\n                                        return <td {...cell.getCellProps()}>{cell.render('Cell')}</td>;\n                                    })}\n                                </tr>\n                            );\n                        })}\n                    </tbody>\n                </ReactTable>\n            </>\n        );\n    }\n\n    // Define a custom filter filter function!\n    function filterGreaterThan(rows, id, filterValue) {\n        return rows.filter(row => {\n            const rowValue = row.values[id];\n\n            return rowValue >= filterValue;\n        });\n    }\n\n    // This is an autoRemove method on the filter function that\n    // when given the new filter value and returns true, the filter\n    // will be automatically removed. Normally this is just an undefined\n    // check, but here, we want to remove the filter if it's not a number\n    filterGreaterThan.autoRemove = val => typeof val !== 'number';\n\n    function dateFilter(rows, id, filterValue) {\n        return rows.filter(row => {\n            const rowValue = row.values[id];\n\n            if (filterValue.toLowerCase() === 'last 7 days') {\n                return moment(rowValue).isBetween(moment.utc().subtract(7, 'd').format('L'));\n            } else if (filterValue.toLowerCase() === 'today') {\n                return rowValue === moment().format('L');\n            } else {\n                return rowValue;\n            }\n        });\n    }\n\n    const columns = React.useMemo(\n        () => [\n            {\n                Header: 'Identifier',\n                accessor: 'identifier'\n            },\n            {\n                Header: 'Alert Type',\n                accessor: 'alertType',\n                // Use our custom `fuzzyText` filter on this column\n                filter: 'fuzzyText'\n            },\n            {\n                Header: 'Date',\n                accessor: d => {\n                    return moment(d.date).format('L');\n                }\n            },\n            {\n                Header: 'Broker',\n                accessor: 'broker'\n            },\n            {\n                Header: 'Ticker',\n                accessor: 'ticker'\n            },\n            {\n                Header: 'Quantity',\n                accessor: 'quantity'\n            },\n            {\n                Header: 'Client',\n                accessor: 'client'\n            },\n            {\n                Header: 'Escalation',\n                accessor: 'escalation'\n            },\n            {\n                Header: 'Assigned',\n                accessor: 'assigned'\n            },\n            {\n                Header: 'Status',\n                accessor: 'status'\n            }\n        ]\n    );\n\n    const filtered = () => {\n        if (dummy.filtered.length > 0) {\n            return dummy.dummy.filter(dum => {\n                if (dummy.filtered[0].id.toLowerCase() === 'today') {\n                    if (moment(dum.date).format('L') === moment().format('L')) {\n                        return dum;\n                    }\n                } else if (dummy.filtered[0].id.toLowerCase() === 'last 7 days') {\n                    if (moment.utc(dum.date).isBetween(moment.utc().subtract(7, 'd').format('L'))) {\n                        return dum;\n                    }\n                } else {\n                    return dum;\n                }\n            });\n        } else {\n            return dummy.dummy;\n        }\n    };\n\n    // const data = React.useMemo(() => makeData(20), []);\n    return (\n        <div className={`table-responsive w-100 ${className}`} >\n            <Table columns={columns} data={filtered()}/>\n        </div>\n    );\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Breadcrumbs\\Breadcrumbs.js",["186"],"// @flow\nimport React from 'react';\nimport './breadcrumbs.scss';\nimport { Spinner, Breadcrumb, BreadcrumbItem } from 'reactstrap';\n\ntype Props = {\n    links: Array,\n    isLoading: Boolean,\n    className?: string\n}\n\nexport default function Breadcrumbs({\n    links = [],\n    isLoading = false,\n    className = ''\n}: Props): React$Element<any> {\n    return (\n        <div className={`breadcrumbs ${className}`} >\n            <Breadcrumb className='w-100'>\n                {isLoading\n                    ? (\n                        <Spinner size='sm' color='secondary' className='m-2'/>\n                    )\n                    : (\n                        links.map((link, idx) => {\n                            return <BreadcrumbItem key={idx} active={links.length === idx + 1}><a href='#'>{link}</a></BreadcrumbItem>;\n                        })\n                    )}\n            </Breadcrumb>\n        </div>\n    );\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],{"ruleId":"187","replacedBy":"188"},{"ruleId":"189","replacedBy":"190"},{"ruleId":"191","replacedBy":"192"},{"ruleId":"193","severity":1,"message":"194","line":2,"column":25,"nodeType":"195","messageId":"196","endLine":2,"endColumn":33},{"ruleId":"193","severity":1,"message":"197","line":2,"column":27,"nodeType":"195","messageId":"196","endLine":2,"endColumn":36},{"ruleId":"193","severity":1,"message":"198","line":6,"column":10,"nodeType":"195","messageId":"196","endLine":6,"endColumn":25},{"ruleId":"193","severity":1,"message":"199","line":7,"column":10,"nodeType":"195","messageId":"196","endLine":7,"endColumn":18},{"ruleId":"193","severity":1,"message":"200","line":11,"column":34,"nodeType":"195","messageId":"196","endLine":11,"endColumn":52},{"ruleId":"193","severity":1,"message":"201","line":10,"column":10,"nodeType":"195","messageId":"196","endLine":10,"endColumn":18},{"ruleId":"193","severity":1,"message":"202","line":92,"column":14,"nodeType":"195","messageId":"196","endLine":92,"endColumn":26},{"ruleId":"193","severity":1,"message":"203","line":150,"column":14,"nodeType":"195","messageId":"196","endLine":150,"endColumn":32},{"ruleId":"193","severity":1,"message":"204","line":185,"column":14,"nodeType":"195","messageId":"196","endLine":185,"endColumn":32},{"ruleId":"193","severity":1,"message":"205","line":221,"column":14,"nodeType":"195","messageId":"196","endLine":221,"endColumn":37},{"ruleId":"193","severity":1,"message":"206","line":314,"column":13,"nodeType":"195","messageId":"196","endLine":314,"endColumn":18},{"ruleId":"193","severity":1,"message":"207","line":315,"column":13,"nodeType":"195","messageId":"196","endLine":315,"endColumn":27},{"ruleId":"193","severity":1,"message":"208","line":316,"column":13,"nodeType":"195","messageId":"196","endLine":316,"endColumn":34},{"ruleId":"193","severity":1,"message":"209","line":317,"column":13,"nodeType":"195","messageId":"196","endLine":317,"endColumn":28},{"ruleId":"193","severity":1,"message":"210","line":461,"column":14,"nodeType":"195","messageId":"196","endLine":461,"endColumn":24},{"ruleId":"211","severity":1,"message":"212","line":526,"column":43,"nodeType":"213","messageId":"214","endLine":526,"endColumn":45},{"ruleId":"215","severity":1,"message":"216","line":26,"column":96,"nodeType":"217","endLine":26,"endColumn":108},"valid-jsdoc",[],"no-native-reassign",["218"],"no-negated-in-lhs",["219"],"no-unused-vars","'Redirect' is defined but never used.","Identifier","unusedVar","'useEffect' is defined but never used.","'FontAwesomeIcon' is defined but never used.","'faCoffee' is defined but never used.","'checkAuthorization' is defined but never used.","'makeData' is defined but never used.","'GlobalFilter' is defined but never used.","'SelectColumnFilter' is defined but never used.","'SliderColumnFilter' is defined but never used.","'NumberRangeColumnFilter' is defined but never used.","'state' is assigned a value but never used.","'visibleColumns' is assigned a value but never used.","'preGlobalFilteredRows' is assigned a value but never used.","'setGlobalFilter' is assigned a value but never used.","'dateFilter' is defined but never used.","array-callback-return","Array.prototype.filter() expects a value to be returned at the end of arrow function.","ArrowFunctionExpression","expectedAtEnd","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","JSXOpeningElement","no-global-assign","no-unsafe-negation"]