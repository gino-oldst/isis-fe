unt":0,"fixableWarningCount":0,"source":"186","usedDeprecatedRules":"124"},{"filePath":"187","messages":"188","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"189","messages":"190","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"191","messages":"192","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"193","messages":"194","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"195","messages":"196","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"197","usedDeprecatedRules":"124"},{"filePath":"198","messages":"199","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"200","messages":"201","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"202","messages":"203","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"204","messages":"205","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"206","messages":"207","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"208","messages":"209","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"210"},{"filePath":"211","messages":"212","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"213","messages":"214","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"215","messages":"216","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"217","messages":"218","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"219","messages":"220","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"221","messages":"222","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"223","messages":"224","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"225","messages":"226","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"227","messages":"228","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"229"},{"filePath":"230","messages":"231","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"232","messages":"233","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"234","messages":"235","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"236","messages":"237","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"238"},{"filePath":"239","messages":"240","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"241","messages":"242","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"243","messages":"244","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"245","messages":"246","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},{"filePath":"247","messages":"248","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"124"},"D:\\Old.St Labs\\project-measure-frontend\\src\\index.js",[],["249","250","251"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\store.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\reportWebVitals.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\App\\AppContainer.js",["252"],"import React, { useState, useEffect } from 'react';\r\nimport { Switch, Route, useHistory, Redirect } from 'react-router-dom';\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport moment from 'moment';\r\nimport routes from '../../config/routes';\r\nimport AppLoadingContainer from '../AppLoading/AppLoadingContainer';\r\nimport AppModal from '../../components/base/Modal/Modal';\r\nimport FlashNotification from '../../components/modules/FlashNotification/FlashNotification';\r\nimport WrapperBackground from '../../components/base/WrapperBackground/WrapperBackground';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Badge from '../../components/base/Badge/Badge';\r\nimport Tooltip from '../../components/base/Tooltip/Tooltip';\r\nimport Navbar from '../../components/base/Navbar/Navbar';\r\nimport { clearModalContent } from '../../redux/modules/modalEvent';\r\nimport { setLoggingOut } from '../../redux/modules/authentication';\r\nimport navbarBrand from '../../assets/logos/mariana_logo.png';\r\nimport bellIcon from '../../assets/images/ic_bell-solid-white.svg';\r\nimport { checkAuthorization } from '../../utils/Auth';\r\nimport { getNotifications } from '../../api/notifications';\r\nimport { setNotifications } from '../../redux/modules/notifications';\r\nimport './app.scss';\r\n\r\nimport {\r\n    Nav,\r\n    UncontrolledDropdown,\r\n    DropdownItem,\r\n    DropdownMenu,\r\n    DropdownToggle,\r\n    Spinner\r\n} from 'reactstrap';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\n\r\nconst loading = () => (\r\n    <WrapperBackground>\r\n        <Spinner animation='border' role='status'>\r\n            <span className='sr-only'>Loading...</span>\r\n        </Spinner>\r\n    </WrapperBackground>\r\n);\r\n\r\nfunction App() {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n    const { modalContent, onToggle, ...modalEvent } = useSelector(({ modalEvent }) => modalEvent);\r\n    const { data } = useSelector(({ notifications }) => notifications);\r\n    const { isAuthed } = useSelector(({ authentication }) => authentication);\r\n    const [fetching, setFetching] = useState(false);\r\n\r\n    useEffect(() => {\r\n        checkAuth();\r\n    }, []);\r\n\r\n    const checkAuth = async () => {\r\n        const auth = await checkAuthorization();\r\n\r\n        if (!auth) history.push('/login');\r\n        else loadNotifications();\r\n    };\r\n\r\n    const sidebarMenu = [{\r\n        label: 'Dashboard',\r\n        onClick: () => history.push('/dashboard'),\r\n        key: 'dashboard'\r\n    }, {\r\n        label: 'Alerts',\r\n        onClick: () => history.push('/alerts'),\r\n        key: 'alert'\r\n    }, {\r\n        label: 'Behaviours',\r\n        onClick: () => history.push('/behaviours'),\r\n        key: 'behaviour'\r\n    }];\r\n\r\n    const loadNotifications = async () => {\r\n        setFetching(true);\r\n\r\n        try {\r\n            const notifications = await getNotifications();\r\n\r\n            dispatch(setNotifications(notifications.data.data));\r\n        } catch (e) {\r\n            console.error(e);\r\n        }\r\n\r\n        setFetching(false);\r\n    };\r\n\r\n    const handleCloseModal = () => {\r\n        dispatch(clearModalContent());\r\n        onToggle && onToggle();\r\n\r\n        // To show modal, do this something like this:\r\n        // dispatch(setModalContent({\r\n        //     modalContent: <LoginContainer />,\r\n        //     title: 'Login'\r\n        // }));\r\n    };\r\n\r\n    const NavbarLinks = () => {\r\n        return (\r\n            <Nav className='navlinks-right'>\r\n                <UncontrolledDropdown nav={true} direction='down' className='d-flex align-self-center mr-4'>\r\n                    <Notifications loading={fetching} today={data.today} yesterday={data.yesterday} />\r\n                </UncontrolledDropdown>\r\n                <UncontrolledDropdown nav={true} direction='down' className='mr-4'>\r\n                    <NavbarAccount />\r\n                </UncontrolledDropdown>\r\n            </Nav>\r\n        );\r\n    };\r\n\r\n    return (\r\n        <AppLoadingContainer>\r\n            <div id='outer-container'>\r\n                {window.location.pathname !== '/login' && <Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>}\r\n                <React.Suspense fallback={loading()}>\r\n                    <Switch>\r\n                        {routes.map((route, i) => (\r\n                            route.authedRoute\r\n                                ? <PrivateRoute key={i} {...route} sidebarMenu={sidebarMenu}\r\n                                    handleCloseModal={handleCloseModal}\r\n                                    isAuthed={isAuthed} />\r\n                                : <RouteWithSubRoutes key={i} {...route} handleCloseModal={handleCloseModal} />\r\n                        ))}\r\n                    </Switch>\r\n                </React.Suspense>\r\n            </div>\r\n\r\n            <FlashNotification/>\r\n            <AppModal\r\n                {...modalEvent}\r\n                isShow={!!modalContent}\r\n                onToggle={handleCloseModal}>\r\n                {modalContent}\r\n            </AppModal>\r\n        </AppLoadingContainer>\r\n    );\r\n}\r\n\r\nconst Notifications = ({\r\n    loading,\r\n    today,\r\n    yesterday\r\n}) => {\r\n    return (\r\n        <div className='navbar__notifications'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__notification-bell' icon='bell' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true} className='mt-2 navbar__notifications-dropdown'>\r\n                <div className='navbar__notifications-title px-4 pt-2'>\r\n                    <Typography color='color-3' weight='semi-bold' variant='size-16'\r\n                        className='mb-2'>Notifications</Typography>\r\n                </div>\r\n                {loading\r\n                    ? <Spinner animation='border' role='status' className='d-flex mx-auto my-5 text-center'>\r\n                        <span className='sr-only'>Loading...</span>\r\n                    </Spinner>\r\n                    : <>\r\n                        <div className='navbar__notifications-today'>\r\n                            {today.length > 0 &&\r\n                        <div className='navbar__notifications-today-title px-4 py-1'>\r\n                            <Typography color='color-3' weight='light' variant='size-10'>TODAY</Typography>\r\n                        </div>\r\n                            }\r\n                            {today.map((now, idx) => {\r\n                                return (\r\n                                    <DropdownItem key={`today-${idx}`} className='px-4 py-4 d-flex align-items-center'>\r\n                                        <div className='navbar__notifications__icon'>\r\n                                            <img src={bellIcon} alt='Notification_Bell_Icon' className='notification_icon' />\r\n                                        </div>\r\n                                        <div className='navbar__notifications__details mr-auto'>\r\n                                            <Typography color='color-3' variant='size-14' weight='semi-bold'\r\n                                                className='mb-2'>{now.description}</Typography>\r\n                                            <Typography color='color-3' variant='size-16' className='mb-2'>\r\n                                                <span className='mr-3'>{now.identifier} | {now.behaviour}</span>\r\n                                                <Badge status={now.status} />\r\n                                            </Typography>\r\n                                            <Typography color='color-3' variant='size-12' className='text-muted'>Today, {moment(now.date).format('hh:mm a')}</Typography>\r\n                                        </div>\r\n                                        <div className='navbar__notifications__read-icon mr-2'>\r\n                                            <FontAwesomeIcon className='navbar__notification-read' icon='circle' size='xs'\r\n                                                data-tip={true} data-for='notif-1'/>\r\n                                        </div>\r\n                                        <Tooltip place='left' id='notif-1'>\r\n                                            <Typography variant='size-10' weight='light' color='color-3'>{now.resolved ? 'Unread' : 'Mark as read'}</Typography>\r\n                                        </Tooltip>\r\n                                    </DropdownItem>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        <div className='navbar__notifications-past'>\r\n                            {yesterday.length > 0 &&\r\n                        <div className='navbar__notifications-past-title px-4 py-1'>\r\n                            <Typography color='color-3' weight='light' variant='size-10'>YESTERDAY AND EARLIER</Typography>\r\n                        </div>\r\n                            }\r\n                            {yesterday.map((yes, idx) => {\r\n                                return (\r\n                                    <DropdownItem key={`yesterdat-${idx}`} className='px-4 py-4 d-flex align-items-center'>\r\n                                        <div className='navbar__notifications__icon'>\r\n                                            <img src={bellIcon} alt='Notification_Bell_Icon' className='notification_icon' />\r\n                                        </div>\r\n                                        <div className='navbar__notifications__details mr-auto'>\r\n                                            <Typography color='color-3' variant='size-12' weight='semi-bold'\r\n                                                className='mb-2'>{yes.message}</Typography>\r\n                                            <Typography color='color-3' variant='size-14' className='mb-2'>\r\n                                                <span className='mr-3'>{yes.behaviorCode} | {yes.behaviorDescription}</span>\r\n                                                <Badge status={yes.status} />\r\n                                            </Typography>\r\n                                            <Typography color='color-3' variant='size-12' className='text-muted'>{moment(yes.dateCreated).format('DD MMM yyyy, hh:mm a')}</Typography>\r\n                                        </div>\r\n                                        <div className='navbar__notifications__read-icon mr-2'>\r\n                                            <FontAwesomeIcon className='navbar__notification-read' icon='circle' size='xs'\r\n                                                data-tip={true} data-for={yes.id} />\r\n                                        </div>\r\n                                        <Tooltip place='left' id={yes.id}>\r\n                                            <Typography variant='size-10' weight='light' color='color-3'>{yes.status}</Typography>\r\n                                        </Tooltip>\r\n                                    </DropdownItem>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                    </>\r\n                }\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\nconst NavbarAccount = () => {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n\r\n    const logout = () => {\r\n        localStorage.clear();\r\n        dispatch(setLoggingOut());\r\n        window.location.href = '/login';\r\n    };\r\n\r\n    return (\r\n        <div className='navbar__account'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__user-icon' icon='user-circle' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true}>\r\n                <DropdownItem className='px-4 py-2' onClick={() => history.push('/reset-password')}>\r\n                    Change Password\r\n                </DropdownItem>\r\n                <DropdownItem className='px-4 py-2' onClick={logout}>\r\n                    Logout\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\n// A special wrapper for <Route> that knows how to\r\n// handle \"sub\"-routes by passing them in a `routes`\r\n// prop to the component it renders.\r\nfunction RouteWithSubRoutes({ component: Component, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route\r\n            {...rest}\r\n            render={props => (\r\n                // pass the sub-routes down to keep nesting\r\n                <Component {...props} routes={props.routes} handleCloseModal={handleCloseModal} />\r\n            )} />\r\n    );\r\n}\r\n\r\nfunction PrivateRoute({ component: Component, isAuthed, sidebarMenu, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route {...rest} render={(routeProps) => (\r\n            <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            // isAuthed\r\n            //     ? <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            //     : <Redirect to={{\r\n            //         pathname: '/login',\r\n            //         state: { from: routeProps.location }\r\n            //     }}/>\r\n        )}/>\r\n    );\r\n}\r\n\r\nexport default App;\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\reducers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AppLoading\\AppLoadingContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\modalEvent.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\routes.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\WrapperBackground\\WrapperBackground.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Modal\\Modal.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Navbar\\Navbar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\FlashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsContainer.js",["253","254"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { checkAuthorization } from '../../utils/Auth';\r\nimport { useHistory } from 'react-router-dom';\r\nimport AlertsScreen from './AlertsScreen';\r\nimport type { Menu } from '../../types';\r\nimport { getAlerts } from '../../api/alerts';\r\n\r\nimport { setAlertsData } from '../../redux/modules/alerts';\r\n\r\ntype Props = {\r\n    sidebarMenu: Array<Menu>,\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function AlertsContainer({\r\n    sidebarMenu,\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n    const [loading, setLoading] = useState(false);\r\n    const { isRowsSelected } = useSelector(({ table }) => table);\r\n    const { table } = useSelector(({ alerts }) => alerts);\r\n    const breadcrumb = [\r\n        {\r\n            label: 'Home',\r\n            path: '/dashboard'\r\n        },\r\n        {\r\n            label: 'Alerts',\r\n            path: '/alerts'\r\n        }\r\n    ];\r\n    const [data, setData] = useState({\r\n        table: {\r\n            columns: [\r\n                {\r\n                    header: 'Identifier',\r\n                    accessor: 'identifier',\r\n                    disableFilters: true,\r\n                    clickable: true\r\n                },\r\n                {\r\n                    header: 'Alert Type',\r\n                    accessor: 'alertType',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Date',\r\n                    accessor: 'date',\r\n                    disableFilters: true,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Broker',\r\n                    accessor: 'broker',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Ticker',\r\n                    accessor: 'ticker',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Book',\r\n                    accessor: 'book',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Quantity',\r\n                    accessor: 'quantity',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Client',\r\n                    accessor: 'client',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Escalation',\r\n                    accessor: 'escalation',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Assigned',\r\n                    accessor: 'assigned',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Status',\r\n                    accessor: 'status',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                }\r\n            ],\r\n            data: [\r\n                {\r\n                    id: 1,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 12,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 2,\r\n                    identifier: 'MUA313',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 2',\r\n                    quantity: 11,\r\n                    client: 'Client 1',\r\n                    escalation: 'CO',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'In Review',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 3,\r\n                    identifier: 'MUA314',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 2',\r\n                    quantity: 1500000,\r\n                    client: 'Client 1',\r\n                    escalation: 'CO',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 4,\r\n                    identifier: 'MUA315',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 2',\r\n                    quantity: 93,\r\n                    client: 'Client 1',\r\n                    escalation: 'Manager',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'In Review',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 5,\r\n                    identifier: 'MUA316',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Jeff Smith',\r\n                    ticker: 'OCDO',\r\n                    book: 'Book 3',\r\n                    quantity: 458000,\r\n                    client: 'Client 1',\r\n                    escalation: 'Manager',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 6,\r\n                    identifier: 'MUA317',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Paul Herbert',\r\n                    ticker: 'BP',\r\n                    book: 'Book 4',\r\n                    quantity: 223560,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Archived',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 7,\r\n                    identifier: 'MUA318',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'OCDO',\r\n                    book: 'Book 4',\r\n                    quantity: 21,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Gergana Tsoneva',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 8,\r\n                    identifier: 'MUA319',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'SDR',\r\n                    book: 'Book 5',\r\n                    quantity: 789233,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Gergana Tsoneva',\r\n                    status: 'Archived',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 9,\r\n                    identifier: 'MUA320',\r\n                    alertType: 'Marking the Close',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BNZL',\r\n                    book: 'Book 6',\r\n                    quantity: 1044,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Darren Hibbitt',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 10,\r\n                    identifier: 'MUA321',\r\n                    alertType: 'High Volume',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 7',\r\n                    quantity: 985000,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Darren Hibbitt',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 11,\r\n                    identifier: 'MUA322',\r\n                    alertType: 'Flash Execution',\r\n                    date: new Date(),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BNZL',\r\n                    book: 'Book 7',\r\n                    quantity: 122,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Darren Hibbitt',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 12,\r\n                    identifier: 'MUA323',\r\n                    alertType: 'Flash Order',\r\n                    date: new Date(2021, 3, 20, 10, 33, 30, 0),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'WPP',\r\n                    book: 'Book 8',\r\n                    quantity: 102,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 13,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 1000502,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 14,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 12,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 15,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(2021, 3, 18, 18, 33, 30, 0),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 12,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                }\r\n            ]\r\n        },\r\n        selected: {\r\n            data: {},\r\n            activity: []\r\n        }\r\n    }); // table dummy data\r\n\r\n    // check if user is logged in\r\n    useEffect(() => {\r\n        checkAuth();\r\n    }, []);\r\n\r\n    const checkAuth = async () => {\r\n        const auth = await checkAuthorization();\r\n\r\n        if (!auth) history.push('/login');\r\n        else loadAlertsData();\r\n    };\r\n\r\n    const viewAlertDetails = async (row) => {\r\n        localStorage.setItem('selectedAlertId', row.id);\r\n\r\n        history.push(`/alert/${row.behaviourCode}`);\r\n    };\r\n\r\n    const loadAlertsData = async () => {\r\n        setLoading(true);\r\n\r\n        try {\r\n            const alerts = await getAlerts();\r\n\r\n            dispatch(setAlertsData(alerts.data.data));\r\n        } catch (e) {\r\n            console.error(e);\r\n        }\r\n\r\n        setLoading(false);\r\n    };\r\n\r\n    return <AlertsScreen\r\n        loading={loading}\r\n        breadcrumb={breadcrumb}\r\n        tableColumns={table.columns}\r\n        tableData={table.data}\r\n        isRowsSelected={isRowsSelected}\r\n        viewAlertDetails={viewAlertDetails}\r\n        handleCloseModal={handleCloseModal}\r\n        sidebarMenu={sidebarMenu} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CustomDropdown\\CustomDropdown.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Table\\Table.js",["255"],"// @flow\r\nimport React, { useMemo, useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport moment from 'moment';\r\nimport { matchSorter } from 'match-sorter';\r\nimport Button from '../../base/Button/Button';\r\nimport Badge from '../../base/Badge/Badge';\r\nimport Typography from '../../base/Typography/Typography';\r\nimport DatePicker from 'react-datepicker';\r\nimport 'react-datepicker/dist/react-datepicker.css';\r\nimport CustomDropdown from '../../base/CustomDropdown/CustomDropdown';\r\nimport { kFormatter, getTextColor } from '../../../utils/helpers';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport {\r\n    Table as ReactstrapTable,\r\n    DropdownItem,\r\n    FormGroup,\r\n    Input,\r\n    Label\r\n} from 'reactstrap';\r\nimport filterIcon from '../../../assets/images/ic_filter.svg';\r\nimport './table.scss';\r\n\r\nimport { useTable, useRowSelect, useFilters, useGlobalFilter, usePagination, useSortBy, useAsyncDebounce } from 'react-table';\r\nimport { setIsRowSelected, setAppliedFilters } from '../../../redux/modules/table';\r\n\r\n// Define a default UI for filtering\r\nfunction GlobalFilter({\r\n    preGlobalFilteredRows,\r\n    globalFilter,\r\n    setGlobalFilter\r\n}) {\r\n    const count = preGlobalFilteredRows.length;\r\n    const [value, setValue] = React.useState(globalFilter);\r\n    const onChange = useAsyncDebounce(value => {\r\n        setGlobalFilter(value || undefined);\r\n    }, 200);\r\n\r\n    return (\r\n        <span>\r\n            Search:{' '}\r\n            <input\r\n                value={value || ''}\r\n                onChange={e => {\r\n                    setValue(e.target.value);\r\n                    onChange(e.target.value);\r\n                }}\r\n                placeholder={`${count} records...`}\r\n                style={{\r\n                    fontSize: '1.1rem',\r\n                    border: '0'\r\n                }}/>\r\n        </span>\r\n    );\r\n}\r\n\r\n// Define a default UI for filtering\r\nfunction DefaultColumnFilter({\r\n    column: { filterValue, preFilteredRows, setFilter }\r\n}) {\r\n    const count = preFilteredRows.length;\r\n\r\n    return (\r\n        <input\r\n            value={filterValue || ''}\r\n            onChange={e => {\r\n                setFilter(e.target.value || undefined); // Set undefined to remove the filter entirely\r\n            }}\r\n            placeholder={`Search ${count} records...`}/>\r\n    );\r\n}\r\n\r\nfunction fuzzyTextFilterFn(rows, id, filterValue) {\r\n    return matchSorter(rows, filterValue, { keys: [row => row.values[id]] });\r\n}\r\n\r\n// Let the table remove the filter if the string is empty\r\nfuzzyTextFilterFn.autoRemove = val => !val;\r\n\r\n// This is a custom filter UI for selecting\r\n// a unique option from a list\r\nfunction SelectColumnFilter({\r\n    column: { Header, filterValue, setFilter, preFilteredRows, id }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [selectFilter, setSelectFilter] = useState([]);\r\n    const [searchFilter, setSearchFilter] = useState('');\r\n    const options = useMemo(() => {\r\n        const options = new Set();\r\n\r\n        preFilteredRows.forEach(row => {\r\n            options.add(row.values[id]);\r\n        });\r\n\r\n        return [...options.values()];\r\n    }, [id, preFilteredRows]);\r\n\r\n    useEffect(() => {\r\n        setFilter(selectFilter);\r\n    }, [selectFilter]);\r\n\r\n    const handleFilterChange = (e, value) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        isChecked\r\n            ? setSelectFilter([\r\n                ...selectFilter,\r\n                value\r\n            ])\r\n            : setSelectFilter([...selectFilter.filter(val => val !== value)]);\r\n    };\r\n\r\n    const handleSearch = value => {\r\n        setSearchFilter(value);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter([]);\r\n        setSelectFilter([]);\r\n        setSearchFilter('');\r\n    };\r\n\r\n    // filtered column options\r\n    const choices = options.filter(opt => opt.toString().toLowerCase().includes(searchFilter.toLowerCase()));\r\n\r\n    // Render a multi-select box\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <DropdownItem header={true}>\r\n                <Input type='text' name='search' placeholder='Search...'\r\n                    bsSize='md' value={searchFilter} onChange={e => handleSearch(e.target.value)} />\r\n            </DropdownItem>\r\n            <div className='table__filter-options overflow-auto'>\r\n                {choices.map((option, i) => (\r\n                    <FormGroup key={i} check={true}>\r\n                        <Label check={true}>\r\n                            <Input type='checkbox' checked={selectFilter.includes(option.toString())} onChange={e => handleFilterChange(e, option.toString())}/>\r\n                            {option.toString()}\r\n                        </Label>\r\n                    </FormGroup>\r\n                ))}\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\n// This is a custom filter UI for selecting\r\n// a unique option from a list\r\nfunction RadioColumnFilter({\r\n    column: { setFilter }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [radioFilter, setRadioFilter] = useState(0);\r\n\r\n    useEffect(() => {\r\n        setFilter(radioFilter);\r\n    }, [radioFilter]);\r\n\r\n    const handleRadioFilterChange = (e, value) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        isChecked\r\n            ? setRadioFilter(value)\r\n            : setRadioFilter(0);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter(undefined);\r\n        setRadioFilter(0);\r\n    };\r\n\r\n    // Render a multi-select box\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <div className='table__quantity-filter-options'>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio1'\r\n                            checked={radioFilter === 1} onChange={e => handleRadioFilterChange(e, 1)} />{' '}\r\n                        Below 100K\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio2'\r\n                            checked={radioFilter === 2} onChange={e => handleRadioFilterChange(e, 2)} />{' '}\r\n                        100K - 500K\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio3'\r\n                            checked={radioFilter === 3} onChange={e => handleRadioFilterChange(e, 3)} />{' '}\r\n                        501K - 1M\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio4'\r\n                            checked={radioFilter === 4} onChange={e => handleRadioFilterChange(e, 4)} />{' '}\r\n                        Above 1M\r\n                    </Label>\r\n                </FormGroup>\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\nfunction DateColumnFilter({\r\n    column: { setFilter }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [dateFilter, setDateFilter] = useState(0);\r\n    const [defaultDate, setDefaultDate] = useState(new Date());\r\n    const [selectedDate, setDateChange] = useState(3);\r\n    const datepickerOpen = React.createRef();\r\n\r\n    useEffect(() => {\r\n        setFilter(dateFilter);\r\n    }, [dateFilter]);\r\n\r\n    useEffect(() => {\r\n        setFilter(selectedDate);\r\n    }, [selectedDate]);\r\n\r\n    const handleDateFilterChange = (isChecked, value) => {\r\n        isChecked\r\n            ? setDateFilter(value)\r\n            : setDateFilter(0);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter(undefined);\r\n        setDateFilter(3);\r\n        setDateChange(3);\r\n        setDefaultDate(new Date());\r\n    };\r\n\r\n    const handleDateChange = value => {\r\n        setDateChange(value);\r\n        setDefaultDate(value);\r\n        setDateFilter(3);\r\n    };\r\n\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <div className='table__date-filter-options'>\r\n                <FormGroup tag='fieldset'>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 1} onChange={e => handleDateFilterChange(e.target.checked, 1)}/>{' '}\r\n                        Today\r\n                        </Label>\r\n                    </FormGroup>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 2} onChange={e => handleDateFilterChange(e.target.checked, 2)} />{' '}\r\n                        Last 7 Days\r\n                        </Label>\r\n                    </FormGroup>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 3} onChange={e => {\r\n                                    handleDateFilterChange(e.target.checked, 3);\r\n                                }} onClick={() => datepickerOpen.current.setOpen(true)} />{' '}\r\n                            <span className='mr-2'>Specific Date</span>\r\n                        </Label>\r\n                        <FontAwesomeIcon icon='calendar-alt' size='md' className='date-picker__icon' />\r\n                        <DatePicker ref={datepickerOpen} selected={defaultDate}\r\n                            className='table__date-picker'\r\n                            dateFormat='dd MMM yyyy'\r\n                            onChange={date => {\r\n                                handleDateChange(date);\r\n                            }} />\r\n                    </FormGroup>\r\n                </FormGroup>\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\n// For row selection\r\nconst IndeterminateCheckbox = React.forwardRef(\r\n    ({ indeterminate, ...rest }, ref) => {\r\n        const defaultRef = React.useRef();\r\n        const resolvedRef = ref || defaultRef;\r\n\r\n        React.useEffect(() => {\r\n            resolvedRef.current.indeterminate = indeterminate;\r\n        }, [resolvedRef, indeterminate]);\r\n\r\n        return (\r\n            <>\r\n                <input type='checkbox' ref={resolvedRef} {...rest} />\r\n            </>\r\n        );\r\n    }\r\n);\r\n\r\n// Our table component\r\nfunction Table({\r\n    columns,\r\n    data,\r\n    selectableRows,\r\n    globalFilter,\r\n    pagination,\r\n    sortable\r\n}) {\r\n    const filterTypes = useMemo(\r\n        () => ({\r\n            fuzzyText: fuzzyTextFilterFn,\r\n            // Or, override the default text filter to use\r\n            // \"startWith\"\r\n            text: (rows, id, filterValue) => {\r\n                return rows.filter(row => {\r\n                    const rowValue = row.values[id];\r\n\r\n                    return rowValue !== undefined\r\n                        ? String(rowValue)\r\n                            .toLowerCase()\r\n                            .startsWith(String(filterValue).toLowerCase())\r\n                        : true;\r\n                });\r\n            }\r\n        }),\r\n        []\r\n    );\r\n\r\n    const defaultColumn = useMemo(\r\n        () => ({\r\n            // Let's set up our default Filter UI\r\n            Filter: DefaultColumnFilter\r\n        }),\r\n        []\r\n    );\r\n\r\n    const {\r\n        getTableProps,\r\n        getTableBodyProps,\r\n        headerGroups,\r\n        rows,\r\n        prepareRow,\r\n        state,\r\n        visibleColumns,\r\n        preGlobalFilteredRows,\r\n        setGlobalFilter,\r\n        page,\r\n        gotoPage,\r\n        previousPage,\r\n        nextPage,\r\n        canPreviousPage,\r\n        canNextPage\r\n    } = useTable(\r\n        {\r\n            columns,\r\n            data,\r\n            defaultColumn,\r\n            filterTypes\r\n        },\r\n        useFilters,\r\n        useGlobalFilter,\r\n        useSortBy,\r\n        usePagination,\r\n        useRowSelect,\r\n        hooks => { // push column for the checkbox\r\n            selectableRows && hooks.visibleColumns.push(columns => [\r\n                {\r\n                    id: 'selection',\r\n                    Header: ({ getToggleAllRowsSelectedProps }) => (\r\n                        <div>\r\n                            <IndeterminateCheckbox {...getToggleAllRowsSelectedProps()} />\r\n                        </div>\r\n                    ),\r\n                    Cell: ({ row }) => (\r\n                        <div>\r\n                            <IndeterminateCheckbox {...row.getToggleRowSelectedProps()} />\r\n                        </div>\r\n                    )\r\n                },\r\n                ...columns\r\n            ]);\r\n        }\r\n    );\r\n\r\n    useEffect(() => {\r\n        dispatch(setAppliedFilters(state.filters));\r\n    }, [state.filters]);\r\n\r\n    const dispatch = useDispatch();\r\n    const maxPage = 3; // max page for pagination button\r\n    const paginationLoopLength = (rows.length % state.pageSize) > 0 ? parseInt(rows.length / state.pageSize + 1) : rows.length / state.pageSize;\r\n    // collect all applied filters from table\r\n\r\n    const selectedRows = page.filter(row => row.isSelected === true).length;\r\n\r\n    useEffect(() => {\r\n        dispatch(setIsRowSelected(selectedRows > 0));\r\n    }, [selectedRows]);\r\n\r\n    return (\r\n        <>\r\n            <ReactstrapTable responsive={true} {...getTableProps()}>\r\n                <thead>\r\n                    {globalFilter &&\r\n                        <tr>\r\n                            <th\r\n                                colSpan={visibleColumns.length}\r\n                                style={{\r\n                                    textAlign: 'left'\r\n                                }}>\r\n                                <GlobalFilter\r\n                                    preGlobalFilteredRows={preGlobalFilteredRows}\r\n                                    globalFilter={state.globalFilter}\r\n                                    setGlobalFilter={setGlobalFilter}/>\r\n                            </th>\r\n                        </tr>\r\n                    }\r\n                    {headerGroups.map(headerGroup => (\r\n                        <tr {...headerGroup.getHeaderGroupProps()}>\r\n                            {headerGroup.headers.map(column => (\r\n                                <th {...column.getHeaderProps()}>\r\n                                    {/* Render the columns filter UI */}\r\n                                    <span {...column.getHeaderProps(sortable && column.getSortByToggleProps())}>\r\n                                        {column.render('Header')}\r\n                                        {sortable &&\r\n                                            column.isSorted\r\n                                            ? column.isSortedDesc\r\n                                                ? ' 🔽'\r\n                                                : ' 🔼'\r\n                                            : ''\r\n                                        }\r\n                                    </span>\r\n                                    {column.canFilter ? column.render('Filter') : null}\r\n                                </th>\r\n                            ))}\r\n                        </tr>\r\n                    ))}\r\n                </thead>\r\n                <tbody {...getTableBodyProps()}>\r\n                    {page.length > 0\r\n                        ? (\r\n                            page.map((row, i) => {\r\n                                prepareRow(row);\r\n\r\n                                return (\r\n                                    <tr {...row.getRowProps()} className={`${row.isSelected ? 'selected-row' : ''}`}>\r\n                                        {row.cells.map(cell => {\r\n                                            return <td {...cell.getCellProps()}>{cell.render('Cell')}</td>;\r\n                                        })}\r\n                                    </tr>\r\n                                );\r\n                            })\r\n                        )\r\n                        : (\r\n                            <tr>\r\n                                <th className='text-muted'>\r\n                                    No data available\r\n                                </th>\r\n                            </tr>\r\n                        )}\r\n                </tbody>\r\n            </ReactstrapTable>\r\n            {pagination &&\r\n                <div className='pagination'>\r\n                    <span className={`cursor-pointer ${!canPreviousPage ? 'text-muted' : ''}`} onClick={() => previousPage()}>Prev</span>\r\n                    {Array.from(Array(paginationLoopLength), (_, i) => {\r\n                        const dynamicPageIndex = state.pageIndex > maxPage ? state.pageIndex - 2 + i : i + 1;\r\n\r\n                        return i <= maxPage && <span className={`cursor-pointer ${state.pageIndex + 1 === dynamicPageIndex ? 'active' : ''}`} onClick={() => gotoPage(dynamicPageIndex - 1)}>{dynamicPageIndex}</span>;\r\n                    })}\r\n                    <span className={`cursor-pointer ${!canNextPage ? 'text-muted' : ''}`} onClick={() => nextPage()}>Next</span>\r\n                </div>\r\n            }\r\n        </>\r\n    );\r\n}\r\n\r\n/* Custom filter function */\r\nfunction multiSelectFilter(rows, columnIds, filterValue) {\r\n    // Filters only if filters are selected\r\n    return filterValue.length === 0 ? rows : rows.filter((row) => filterValue.includes(String(row.original[columnIds])));\r\n}\r\n\r\n// Quantity custom filter function!\r\nfunction filterGreaterThan(rows, id, filterValue) {\r\n    const result = rows.filter(row => {\r\n        const rowValue = row.values[id];\r\n\r\n        switch (filterValue) {\r\n            case 1:\r\n                return rowValue <= 100000;\r\n            case 2:\r\n                return rowValue > 100000 && rowValue <= 500000;\r\n            case 3:\r\n                return rowValue > 500001 && rowValue <= 1000000;\r\n            case 4:\r\n                return rowValue > 1000000;\r\n            default:\r\n                return rowValue;\r\n        }\r\n    });\r\n\r\n    return result;\r\n}\r\n\r\ntype Props = {\r\n    children?: string | React.Node,\r\n    className?: string,\r\n    tableData: Array,\r\n    tableColumns: Array,\r\n    selectableRows: Boolean,\r\n    globalFilter: Boolean,\r\n    viewDetails: Function,\r\n}\r\n\r\nexport default function ReactTable({\r\n    children,\r\n    className = '',\r\n    tableData,\r\n    tableColumns,\r\n    selectableRows = false,\r\n    globalFilter = false,\r\n    pagination = false,\r\n    sortable = false,\r\n    viewDetails\r\n}: Props): React$Element<any> {\r\n    const columns = useMemo(\r\n        () => tableColumns.map(column => {\r\n            const rootPath = window.location.pathname.split('/')[1];\r\n\r\n            return {\r\n                Header: column.header,\r\n                accessor: column.accessor,\r\n                disableFilters: column.disableFilters,\r\n                Filter: column.accessor !== 'quantity' ? SelectColumnFilter : RadioColumnFilter,\r\n                filter: column.accessor !== 'quantity' ? multiSelectFilter : filterGreaterThan,\r\n                Cell: e => column.accessor === 'dateCreated'\r\n                    ? <span>{moment(e.value).format('DD/MM/YY')}</span>\r\n                    : <span className={`${column.clickable\r\n                        ? 'color-link-text cursor-pointer'\r\n                        : ''}`} onClick={() => rootPath === 'alerts' && column.accessor === 'behaviourCode'\r\n                        ? viewDetails(e.cell.row.original)\r\n                        : rootPath === 'behaviours' && column.accessor === 'internalCode'\r\n                            ? viewDetails(e.cell.row)\r\n                            : column.accessor === 'name'\r\n                                ? viewDetails(e.cell.row.original)\r\n                                : null}>{column.accessor === 'quantity'\r\n                            ? kFormatter(e.value)\r\n                            : column.accessor === 'escalation'\r\n                                ? <span className='font-weight-bold'>{getTextColor(e.value)}</span>\r\n                                : column.accessor === 'status'\r\n                                    ? <Badge status={e.value} />\r\n                                    : e.value}</span>,\r\n                sortType: column.accessor === 'date'\r\n                    ? (a, b, c, d) => {\r\n                        a = new Date(a.values.date).getTime();\r\n                        b = new Date(b.values.date).getTime();\r\n\r\n                        return b > a ? -1 : 1;\r\n                    }\r\n                    : 'alphanumeric'\r\n            };\r\n        }),\r\n        []\r\n    );\r\n\r\n    return (\r\n        <div className={`w-100 ${className}`}>\r\n            <Table columns={columns} data={tableData}\r\n                selectableRows={selectableRows}\r\n                globalFilter={globalFilter}\r\n                pagination={pagination}\r\n                sortable={sortable} />\r\n        </div>\r\n    );\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Breadcrumbs\\Breadcrumbs.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Badge\\Badge.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Pagination\\Pagination.js",[],["256","257","258"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Select\\Select.js",[],"D:\\Old.St Labs\\project-measure-front