const onSubmit = async e => {\r\n        setIsLoading(true);\r\n        setErrMsg('');\r\n        e.preventDefault();\r\n\r\n        try {\r\n            if (isValidEmail(loginForm.email) && loginForm.password) {\r\n                // const response = await userLogin(loginForm);\r\n\r\n                // if (Object.keys(response).length === 0) {\r\n                //     setErrMsg('Invalid email!');\r\n                // } else if (response.data.message) {\r\n                //     setErrMsg(response.data.message);\r\n                // } else {\r\n                //     const { data } = response;\r\n\r\n                //     localStorage.setItem('userId', data.userId);\r\n                //     saveAuthorizationToken(data.token);\r\n                //     dispatch(authUser({\r\n                //         email: loginForm.email\r\n                //     }));\r\n\r\n                //     history.replace('/dashboard');\r\n                // }\r\n\r\n                localStorage.setItem('userId', 1);\r\n                saveAuthorizationToken('temp_token');\r\n                dispatch(authUser({\r\n                    email: loginForm.email\r\n                }));\r\n\r\n                history.replace('/dashboard');\r\n            }\r\n        } catch (err) {\r\n            dispatch(setFlashNotification({\r\n                message: 'ERROR',\r\n                isError: true\r\n            }));\r\n        }\r\n    };\r\n\r\n    const onChange = e => {\r\n        const { name, value } = e.target;\r\n\r\n        setLoginForm({\r\n            ...loginForm,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    return <Login\r\n        onSubmit={onSubmit}\r\n        onChange={onChange}\r\n        isLoading={isLoading}\r\n        errMsg={errMsg}\r\n        setErrMsg={setErrMsg}\r\n        handleCloseModal={handleCloseModal} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measu