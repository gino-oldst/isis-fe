104"},{"filePath":"159","messages":"160","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"161","messages":"162","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"163","messages":"164","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"165","messages":"166","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"167","messages":"168","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"169","messages":"170","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"171","messages":"172","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"173","usedDeprecatedRules":"104"},{"filePath":"174","messages":"175","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"176","messages":"177","errorCount":0,"warningCount":14,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"178","messages":"179","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"180","usedDeprecatedRules":"104"},{"filePath":"181","messages":"182","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"183","messages":"184","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"185","messages":"186","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"187","messages":"188","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"189","messages":"190","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"191","messages":"192","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"193","messages":"194","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"195","messages":"196","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"197","messages":"198","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"199","messages":"200","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"201","messages":"202","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"203","messages":"204","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"205","messages":"206","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},"D:\\Old.St Labs\\project-measure-frontend\\src\\index.js",[],["207","208","209"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\store.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\reportWebVitals.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\App\\AppContainer.js",["210"],"import React, { useState, useEffect } from 'react';\r\nimport { Switch, Route, useHistory, Redirect } from 'react-router-dom';\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport moment from 'moment';\r\nimport routes from '../../config/routes';\r\nimport AppLoadingContainer from '../AppLoading/AppLoadingContainer';\r\nimport AppModal from '../../components/base/Modal/Modal';\r\nimport FlashNotification from '../../components/modules/FlashNotification/FlashNotification';\r\nimport WrapperBackground from '../../components/base/WrapperBackground/WrapperBackground';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Badge from '../../components/base/Badge/Badge';\r\nimport Tooltip from '../../components/base/Tooltip/Tooltip';\r\nimport Navbar from '../../components/base/Navbar/Navbar';\r\nimport { clearModalContent } from '../../redux/modules/modalEvent';\r\nimport { setLoggingOut } from '../../redux/modules/authentication';\r\nimport navbarBrand from '../../assets/logos/mariana_logo.png';\r\nimport bellIcon from '../../assets/images/ic_bell-solid-white.svg';\r\nimport './app.scss';\r\n\r\nimport {\r\n    Nav,\r\n    UncontrolledDropdown,\r\n    DropdownItem,\r\n    DropdownMenu,\r\n    DropdownToggle,\r\n    Spinner\r\n} from 'reactstrap';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\n\r\nconst loading = () => (\r\n    <WrapperBackground>\r\n        <Spinner animation='border' role='status'>\r\n            <span className='sr-only'>Loading...</span>\r\n        </Spinner>\r\n    </WrapperBackground>\r\n);\r\n\r\nfunction App() {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n    const { modalContent, onToggle, ...modalEvent } = useSelector(({ modalEvent }) => modalEvent);\r\n    const { data } = useSelector(({ notifications }) => notifications);\r\n    const { isAuthed } = useSelector(({ authentication }) => authentication);\r\n    const [todaysNotification, setTodaysNotification] = useState({});\r\n    const [yesterdaysNotification, setYesterdaysNotification] = useState({});\r\n\r\n    useEffect(() => {\r\n        const today = [];\r\n        const yesterday = [];\r\n\r\n        data.map(notif => {\r\n            return moment(notif.date).isSame(moment(), 'day')\r\n                ? today.push(notif)\r\n                : yesterday.push(notif);\r\n        });\r\n\r\n        setTodaysNotification(today);\r\n        setYesterdaysNotification(yesterday);\r\n    }, []);\r\n\r\n    const sidebarMenu = [{\r\n        label: 'Dashboard',\r\n        onClick: () => history.push('/dashboard'),\r\n        key: 'dashboard'\r\n    }, {\r\n        label: 'Alerts',\r\n        onClick: () => history.push('/alerts'),\r\n        key: 'alert'\r\n    }, {\r\n        label: 'Behaviours',\r\n        onClick: () => history.push('/behaviours'),\r\n        key: 'behaviour'\r\n    }];\r\n\r\n    const handleCloseModal = () => {\r\n        dispatch(clearModalContent());\r\n        onToggle && onToggle();\r\n\r\n        // To show modal, do this something like this:\r\n        // dispatch(setModalContent({\r\n        //     modalContent: <LoginContainer />,\r\n        //     title: 'Login'\r\n        // }));\r\n    };\r\n\r\n    const NavbarLinks = () => {\r\n        return (\r\n            <Nav className='navlinks-right'>\r\n                <UncontrolledDropdown nav={true} direction='down' className='d-flex align-self-center mr-4'>\r\n                    <Notifications today={todaysNotification} yesterday={yesterdaysNotification} />\r\n                </UncontrolledDropdown>\r\n                <UncontrolledDropdown nav={true} direction='down' className='mr-4'>\r\n                    <NavbarAccount />\r\n                </UncontrolledDropdown>\r\n            </Nav>\r\n        );\r\n    };\r\n\r\n    return (\r\n        <AppLoadingContainer>\r\n            <div id='outer-container'>\r\n                {/* {isAuthed && <Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>} */}\r\n                {<Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>}\r\n                <React.Suspense fallback={loading()}>\r\n                    <Switch>\r\n                        {routes.map((route, i) => (\r\n                            route.authedRoute\r\n                                ? <PrivateRoute key={i} {...route} sidebarMenu={sidebarMenu}\r\n                                    handleCloseModal={handleCloseModal}\r\n                                    isAuthed={isAuthed} />\r\n                                : <RouteWithSubRoutes key={i} {...route} handleCloseModal={handleCloseModal} />\r\n                        ))}\r\n                    </Switch>\r\n                </React.Suspense>\r\n            </div>\r\n\r\n            <FlashNotification/>\r\n            <AppModal\r\n                {...modalEvent}\r\n                isShow={!!modalContent}\r\n                onToggle={handleCloseModal}>\r\n                {modalContent}\r\n            </AppModal>\r\n        </AppLoadingContainer>\r\n    );\r\n}\r\n\r\nconst Notifications = ({\r\n    today,\r\n    yesterday\r\n}) => {\r\n    return (\r\n        <div className='navbar__notifications'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__notification-bell' icon='bell' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true} className='mt-2 navbar__notifications-dropdown'>\r\n                <div className='navbar__notifications-title px-4 pt-2'>\r\n                    <Typography color='color-3' weight='semi-bold' variant='size-16'\r\n                        className='mb-2'>Notifications</Typography>\r\n                </div>\r\n                <div className='navbar__notifications-today'>\r\n                    {today.length > 0 &&\r\n                        <div className='navbar__notifications-today-title px-4 py-1'>\r\n                            <Typography color='color-3' weight='light' variant='size-10'>TODAY</Typography>\r\n                        </div>\r\n                    }\r\n                    {today.map((now, idx) => {\r\n                        return (\r\n                            <DropdownItem key={`today-${idx}`} className='px-4 py-4 d-flex align-items-center'>\r\n                                <div className='navbar__notifications__icon'>\r\n                                    <img src={bellIcon} alt='Notification_Bell_Icon' className='notification_icon' />\r\n                                </div>\r\n                                <div className='navbar__notifications__details mr-auto'>\r\n                                    <Typography color='color-3' variant='size-14' weight='semi-bold'\r\n                                        className='mb-2'>{now.description}</Typography>\r\n                                    <Typography color='color-3' variant='size-16' className='mb-2'>\r\n                                        <span className='mr-3'>{now.identifier} | {now.behaviour}</span>\r\n                                        <Badge status={now.status} />\r\n                                    </Typography>\r\n                                    <Typography color='color-3' variant='size-12' className='text-muted'>Today, {moment(now.date).format('hh:mm a')}</Typography>\r\n                                </div>\r\n                                <div className='navbar__notifications__read-icon mr-2'>\r\n                                    <FontAwesomeIcon className='navbar__notification-read' icon='circle' size='xs'\r\n                                        data-tip={true} data-for='notif-1'/>\r\n                                </div>\r\n                                <Tooltip place='left' id='notif-1'>\r\n                                    <Typography variant='size-10' weight='light' color='color-3'>{now.resolved ? 'Unread' : 'Mark as read'}</Typography>\r\n                                </Tooltip>\r\n                            </DropdownItem>\r\n                        );\r\n                    })}\r\n                </div>\r\n                <div className='navbar__notifications-past'>\r\n                    {yesterday.length > 0 &&\r\n                        <div className='navbar__notifications-past-title px-4 py-1'>\r\n                            <Typography color='color-3' weight='light' variant='size-10'>YESTERDAY AND EARLIER</Typography>\r\n                        </div>\r\n                    }\r\n                    {yesterday.map((yes, idx) => {\r\n                        return (\r\n                            <DropdownItem key={`yesterdat-${idx}`} className='px-4 py-4 d-flex align-items-center'>\r\n                                <div className='navbar__notifications__icon'>\r\n                                    <img src={bellIcon} alt='Notification_Bell_Icon' className='notification_icon' />\r\n                                </div>\r\n                                <div className='navbar__notifications__details mr-auto'>\r\n                                    <Typography color='color-3' variant='size-14' weight='semi-bold'\r\n                                        className='mb-2'>{yes.description}</Typography>\r\n                                    <Typography color='color-3' variant='size-16' className='mb-2'>\r\n                                        <span className='mr-3'>{yes.identifier} | {yes.behaviour}</span>\r\n                                        <Badge status={yes.status} />\r\n                                    </Typography>\r\n                                    <Typography color='color-3' variant='size-12' className='text-muted'>{moment(yes.date).format('DD MMM yyyy, hh:mm a')}</Typography>\r\n                                </div>\r\n                                <div className='navbar__notifications__read-icon mr-2'>\r\n                                    <FontAwesomeIcon className='navbar__notification-read' icon='circle' size='xs'\r\n                                        data-tip={true} data-for='notif-2'/>\r\n                                </div>\r\n                                <Tooltip place='left' id='notif-2'>\r\n                                    <Typography variant='size-10' weight='light' color='color-3'>{yes.resolved ? 'Unread' : 'Mark as read'}</Typography>\r\n                                </Tooltip>\r\n                            </DropdownItem>\r\n                        );\r\n                    })}\r\n                </div>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\nconst NavbarAccount = () => {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n\r\n    const logout = () => {\r\n        localStorage.clear();\r\n        dispatch(setLoggingOut());\r\n        window.location.href = '/login';\r\n    };\r\n\r\n    return (\r\n        <div className='navbar__account'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__user-icon' icon='user-circle' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true}>\r\n                <DropdownItem className='px-4 py-2' onClick={() => history.push('/reset-password')}>\r\n                    Change Password\r\n                </DropdownItem>\r\n                <DropdownItem className='px-4 py-2' onClick={logout}>\r\n                    Logout\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\n// A special wrapper for <Route> that knows how to\r\n// handle \"sub\"-routes by passing them in a `routes`\r\n// prop to the component it renders.\r\nfunction RouteWithSubRoutes({ component: Component, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route\r\n            {...rest}\r\n            render={props => (\r\n                // pass the sub-routes down to keep nesting\r\n                <Component {...props} routes={props.routes} handleCloseModal={handleCloseModal} />\r\n            )} />\r\n    );\r\n}\r\n\r\nfunction PrivateRoute({ component: Component, isAuthed, sidebarMenu, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route {...rest} render={(routeProps) => (\r\n            <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            // isAuthed\r\n            //     ? <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            //     : <Redirect to={{\r\n            //         pathname: '/login',\r\n            //         state: { from: routeProps.location }\r\n            //     }}/>\r\n        )}/>\r\n    );\r\n}\r\n\r\nexport default App;\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\reducers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AppLoading\\AppLoadingContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\modalEvent.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\routes.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\WrapperBackground\\WrapperBackground.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Modal\\Modal.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Navbar\\Navbar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\FlashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",["211","212","213","214"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport { useHistory } from 'react-router-dom';\r\n\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport { faCoffee } from '@fortawesome/free-solid-svg-icons';\r\nimport Login from './LoginScreen';\r\nimport { isValidEmail } from '../../utils/helpers';\r\nimport { authUser } from '../../redux/modules/authentication';\r\nimport { saveAuthorizationToken, checkAuthorization } from '../../utils/Auth';\r\nimport { setFlashNotification } from '../../redux/modules/flashNotification';\r\n\r\ntype Props = {\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function LoginContainer({\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const history = useHistory();\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [errMsg, setErrMsg] = useState('');\r\n    const [loginForm, setLoginForm] = useState({\r\n        email: '',\r\n        password: ''\r\n    });\r\n\r\n    // check if user is logged in\r\n    // useEffect(() => {\r\n    //     checkAuth();\r\n    // }, []);\r\n\r\n    // const checkAuth = async () => {\r\n    //     const auth = await checkAuthorization();\r\n\r\n    //     if (auth) history.push('/dashboard');\r\n    // };\r\n\r\n    const onSubmit = async e => {\r\n        setIsLoading(true);\r\n        setErrMsg('');\r\n        e.preventDefault();\r\n\r\n        try {\r\n            if (isValidEmail(loginForm.email) && loginForm.password) {\r\n                // const response = await userLogin(loginForm);\r\n\r\n                // if (Object.keys(response).length === 0) {\r\n                //     setErrMsg('Invalid email!');\r\n                // } else if (response.data.message) {\r\n                //     setErrMsg(response.data.message);\r\n                // } else {\r\n                //     const { data } = response;\r\n\r\n                //     localStorage.setItem('userId', data.userId);\r\n                //     saveAuthorizationToken(data.token);\r\n                //     dispatch(authUser({\r\n                //         email: loginForm.email\r\n                //     }));\r\n\r\n                //     history.replace('/dashboard');\r\n                // }\r\n\r\n                localStorage.setItem('userId', 1);\r\n                saveAuthorizationToken('temp_token');\r\n                dispatch(authUser({\r\n                    email: loginForm.email\r\n                }));\r\n\r\n                history.replace('/dashboard');\r\n            }\r\n        } catch (err) {\r\n            dispatch(setFlashNotification({\r\n                message: 'ERROR',\r\n                isError: true\r\n            }));\r\n        }\r\n    };\r\n\r\n    const onChange = e => {\r\n        const { name, value } = e.target;\r\n\r\n        setLoginForm({\r\n            ...loginForm,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    return <Login\r\n        onSubmit={onSubmit}\r\n        onChange={onChange}\r\n        isLoading={isLoading}\r\n        errMsg={errMsg}\r\n        setErrMsg={setErrMsg}\r\n        handleCloseModal={handleCloseModal} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base