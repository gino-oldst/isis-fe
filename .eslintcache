ashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",["264","265","266","267"],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",["268"],"// @flow\nimport React, { useState, useEffect } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport { useHistory } from 'react-router-dom';\nimport { checkAuthorization } from '../../utils/Auth';\nimport BehavioursScreen from './BehavioursScreen';\nimport type { Menu } from '../../types';\nimport { setBehavioursData } from '../../redux/modules/behaviours';\nimport { getBehaviours } from '../../api/behaviours';\n\ntype Props = {\n    sidebarMenu: Array<Menu>\n}\n\nexport default function BehavioursContainer({\n    sidebarMenu\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const history = useHistory();\n    const [loading, setLoading] = useState(false);\n    const { table } = useSelector(({ behaviours }) => behaviours);\n    const breadcrumb = [\n        {\n            label: 'Home',\n            path: '/dashboard'\n        },\n        {\n            label: 'Behaviours',\n            path: '/behaviours'\n        }\n    ];\n\n    // check if user is logged in\n    useEffect(() => {\n        loadBehavioursData();\n    }, []);\n\n    const loadBehavioursData = async () => {\n        setLoading(true);\n\n        try {\n            const behaviours = await getBehaviours();\n\n            dispatch(setBehavioursData(behaviours.data.data));\n        } catch (e) {\n            console.error(e);\n        }\n\n        setLoading(false);\n    };\n\n    const viewBehaviourDetails = async row => {\n        localStorage.setItem('selectedBehaviourCode', row.original.code);\n\n        history.push(`/behaviour/${row.original.internalCode}`);\n    };\n\n    return <BehavioursScreen\n        loading={loading}\n        breadcrumb={breadcrumb}\n        tableColumns={table.columns}\n        tableData={table.data}\n        viewBehaviourDetails={viewBehaviourDetails}\n        sidebarMenu={sidebarMenu} />;\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CustomDropdown\\CustomDropdown.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Table\\Table.js",["269"],"// @flow\r\nimport React, { useMemo, useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport moment from 'moment';\r\nimport { matchSorter } from 'match-sorter';\r\nimport Button from '../../base/Button/Button';\r\nimport Badge from '../../base/Badge/Badge';\r\nimport Typography from '../../base/Typography/Typography';\r\nimport DatePicker from 'react-datepicker';\r\nimport 'react-datepicker/dist/react-datepicker.css';\r\nimport CustomDropdown from '../../base/CustomDropdown/CustomDropdown';\r\nimport { kFormatter, getTextColor } from '../../../utils/helpers';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport {\r\n    Table as ReactstrapTable,\r\n    DropdownItem,\r\n    FormGroup,\r\n    Input,\r\n    Label\r\n} from 'reactstrap';\r\nimport filterIcon from '../../../assets/images/ic_filter.svg';\r\nimport './table.scss';\r\n\r\nimport { useTable, useRowSelect, useFilters, useGlobalFilter, usePagination, useSortBy, useAsyncDebounce } from 'react-table';\r\nimport { setIsRowSelected, setAppliedFilters } from '../../../redux/modules/table';\r\n\r\n// Define a default UI for filtering\r\nfunction GlobalFilter({\r\n    preGlobalFilteredRows,\r\n    globalFilter,\r\n    setGlobalFilter\r\n}) {\r\n    const count = preGlobalFilteredRows.length;\r\n    const [value, setValue] = React.useState(globalFilter);\r\n    const onChange = useAsyncDebounce(value => {\r\n        setGlobalFilter(value || undefined);\r\n    }, 200);\r\n\r\n    return (\r\n        <span>\r\n            Search:{' '}\r\n            <input\r\n                value={value || ''}\r\n                onChange={e => {\r\n                    setValue(e.target.value);\r\n                    onChange(e.target.value);\r\n                }}\r\n                placeholder={`${count} records...`}\r\n                style={{\r\n                    fontSize: '1.1rem',\r\n                    border: '0'\r\n                }}/>\r\n        </span>\r\n    );\r\n}\r\n\r\n// Define a default UI for filtering\r\nfunction DefaultColumnFilter({\r\n    column: { filterValue, preFilteredRows, setFilter }\r\n}) {\r\n    const count = preFilteredRows.length;\r\n\r\n    return (\r\n        <input\r\n            value={filterValue || ''}\r\n            onChange={e => {\r\n                setFilter(e.target.value || undefined); // Set undefined to remove the filter entirely\r\n            }}\r\n            placeholder={`Search ${count} records...`}/>\r\n    );\r\n}\r\n\r\nfunction fuzzyTextFilterFn(rows, id, filterValue) {\r\n    return matchSorter(rows, filterValue, { keys: [row => row.values[id]] });\r\n}\r\n\r\n// Let the table remove the filter if the string is empty\r\nfuzzyTextFilterFn.autoRemove = val => !val;\r\n\r\n// This is a custom filter UI for selecting\r\n// a unique option from a list\r\nfunction SelectColumnFilter({\r\n    column: { Header, filterValue, setFilter, preFilteredRows, id }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [selectFilter, setSelectFilter] = useState([]);\r\n    const [searchFilter, setSearchFilter] = useState('');\r\n    const options = useMemo(() => {\r\n        const options = new Set();\r\n\r\n        preFilteredRows.forEach(row => {\r\n            options.add(row.values[id]);\r\n        });\r\n\r\n        return [...options.values()];\r\n    }, [id, preFilteredRows]);\r\n\r\n    useEffect(() => {\r\n        setFilter(selectFilter);\r\n    }, [selectFilter]);\r\n\r\n    const handleFilterChange = (e, value) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        isChecked\r\n            ? setSelectFilter([\r\n                ...selectFilter,\r\n                value\r\n            ])\r\n            : setSelectFilter([...selectFilter.filter(val => val !== value)]);\r\n    };\r\n\r\n    const handleSearch = value => {\r\n        setSearchFilter(value);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter([]);\r\n        setSelectFilter([]);\r\n        setSearchFilter('');\r\n    };\r\n\r\n    // filtered column options\r\n    const choices = options.filter(opt => opt.toString().toLowerCase().includes(searchFilter.toLowerCase()));\r\n\r\n    // Render a multi-select box\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <DropdownItem header={true}>\r\n                <Input type='text' name='search' placeholder='Search...'\r\n                    bsSize='md' value={searchFilter} onChange={e => handleSearch(e.target.value)} />\r\n            </DropdownItem>\r\n            <div className='table__filter-options overflow-auto'>\r\n                {choices.map((option, i) => (\r\n                    <FormGroup key={i} check={true}>\r\n                        <Label check={true}>\r\n                            <Input type='checkbox' checked={selectFilter.includes(option.toString())} onChange={e => handleFilterChange(e, option.toString())}/>\r\n                            {option.toString()}\r\n                        </Label>\r\n                    </FormGroup>\r\n                ))}\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\n// This is a custom filter UI for selecting\r\n// a unique option from a list\r\nfunction RadioColumnFilter({\r\n    column: { setFilter }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [radioFilter, setRadioFilter] = useState(0);\r\n\r\n    useEffect(() => {\r\n        setFilter(radioFilter);\r\n    }, [radioFilter]);\r\n\r\n    const handleRadioFilterChange = (e, value) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        isChecked\r\n            ? setRadioFilter(value)\r\n            : setRadioFilter(0);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter(undefined);\r\n        setRadioFilter(0);\r\n    };\r\n\r\n    // Render a multi-select box\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <div className='table__quantity-filter-options'>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio1'\r\n                            checked={radioFilter === 1} onChange={e => handleRadioFilterChange(e, 1)} />{' '}\r\n                        Below 100K\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio2'\r\n                            checked={radioFilter === 2} onChange={e => handleRadioFilterChange(e, 2)} />{' '}\r\n                        100K - 500K\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio3'\r\n                            checked={radioFilter === 3} onChange={e => handleRadioFilterChange(e, 3)} />{' '}\r\n                        501K - 1M\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio4'\r\n                            checked={radioFilter === 4} onChange={e => handleRadioFilterChange(e, 4)} />{' '}\r\n                        Above 1M\r\n                    </Label>\r\n                </FormGroup>\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\nfunction DateColumnFilter({\r\n    column: { setFilter }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [dateFilter, setDateFilter] = useState(0);\r\n    const [defaultDate, setDefaultDate] = useState(new Date());\r\n    const [selectedDate, setDateChange] = useState(3);\r\n    const datepickerOpen = React.createRef();\r\n\r\n    useEffect(() => {\r\n        setFilter(dateFilter);\r\n    }, [dateFilter]);\r\n\r\n    useEffect(() => {\r\n        setFilter(selectedDate);\r\n    }, [selectedDate]);\r\n\r\n    const handleDateFilterChange = (isChecked, value) => {\r\n        isChecked\r\n            ? setDateFilter(value)\r\n            : setDateFilter(0);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter(undefined);\r\n        setDateFilter(3);\r\n        setDateChange(3);\r\n        setDefaultDate(new Date());\r\n    };\r\n\r\n    const handleDateChange = value => {\r\n        setDateChange(value);\r\n        setDefaultDate(value);\r\n        setDateFilter(3);\r\n    };\r\n\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <div className='table__date-filter-options'>\r\n                <FormGroup tag='fieldset'>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 1} onChange={e => handleDateFilterChange(e.target.checked, 1)}/>{' '}\r\n                        Today\r\n                        </Label>\r\n                    </FormGroup>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 2} onChange={e => handleDateFilterChange(e.target.checked, 2)} />{' '}\r\n                        Last 7 Days\r\n                        </Label>\r\n                    </FormGroup>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 3} onChange={e => {\r\n                                    handleDateFilterChange(e.target.checked, 3);\r\n                                }} onClick={() => datepickerOpen.current.setOpen(true)} />{' '}\r\n                            <span className='mr-2'>Specific Date</span>\r\n                        </Label>\r\n                        <FontAwesomeIcon icon='calendar-alt' size='md' className='date-picker__icon' />\r\n                        <DatePicker ref={datepickerOpen} selected={defaultDate}\r\n                            className='table__date-picker'\r\n                            dateFormat='dd MMM yyyy'\r\n                            onChange={date => {\r\n                                handleDateChange(date);\r\n                            }} />\r\n                    </FormGroup>\r\n                </FormGroup>\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\n// For row selection\r\nconst IndeterminateCheckbox = React.forwardRef(\r\n    ({ indeterminate, ...rest }, ref) => {\r\n        const defaultRef = React.useRef();\r\n        const resolvedRef = ref || defaultRef;\r\n\r\n        React.useEffect(() => {\r\n            resolvedRef.current.indeterminate = indeterminate;\r\n        }, [resolvedRef, indeterminate]);\r\n\r\n        return (\r\n            <>\r\n                <input type='checkbox' ref={resolvedRef} {...rest} />\r\n            </>\r\n        );\r\n    }\r\n);\r\n\r\n// Our table component\r\nfunction Table({\r\n    columns,\r\n    data,\r\n    selectableRows,\r\n    globalFilter,\r\n    pagination,\r\n    sortable\r\n}) {\r\n    const filterTypes = useMemo(\r\n        () => ({\r\n            fuzzyText: fuzzyTextFilterFn,\r\n            // Or, override the default text filter to use\r\n            // \"startWith\"\r\n            text: (rows, id, filterValue) => {\r\n                return rows.filter(row => {\r\n                    const rowValue = row.values[id];\r\n\r\n                    return rowValue !== undefined\r\n                        ? String(rowValue)\r\n                            .toLowerCase()\r\n                            .startsWith(String(filterValue).toLowerCase())\r\n                        : true;\r\n                });\r\n            }\r\n        }),\r\n        []\r\n    );\r\n\r\n    const defaultColumn = useMemo(\r\n        () => ({\r\n            // Let's set up our default Filter UI\r\n            Filter: DefaultColumnFilter\r\n        }),\r\n        []\r\n    );\r\n\r\n    const {\r\n        getTableProps,\r\n        getTableBodyProps,\r\n        headerGroups,\r\n        rows,\r\n        prepareRow,\r\n        state,\r\n        visibleColumns,\r\n        preGlobalFilteredRows,\r\n        setGlobalFilter,\r\n        page,\r\n        gotoPage,\r\n        previousPage,\r\n        nextPage,\r\n        canPreviousPage,\r\n        canNextPage\r\n    } = useTable(\r\n        {\r\n            columns,\r\n            data,\r\n            defaultColumn,\r\n            filterTypes\r\n        },\r\n        useFilters,\r\n        useGlobalFilter,\r\n        useSortBy,\r\n        usePagination,\r\n        useRowSelect,\r\n        hooks => { // push column for the checkbox\r\n            selectableRows && hooks.visibleColumns.push(columns => [\r\n                {\r\n                    id: 'selection',\r\n                    Header: ({ getToggleAllRowsSelectedProps }) => (\r\n                        <div>\r\n                            <IndeterminateCheckbox {...getToggleAllRowsSelectedProps()} />\r\n                        </div>\r\n                    ),\r\n                    Cell: ({ row }) => (\r\n                        <div>\r\n                            <IndeterminateCheckbox {...row.getToggleRowSelectedProps()} />\r\n                        </div>\r\n                    )\r\n                },\r\n                ...columns\r\n            ]);\r\n        }\r\n    );\r\n\r\n    useEffect(() => {\r\n        dispatch(setAppliedFilters(state.filters));\r\n    }, [state.filters]);\r\n\r\n    const dispatch = useDispatch();\r\n    const maxPage = 3; // max page for pagination button\r\n    const paginationLoopLength = (rows.length % state.pageSize) > 0 ? parseInt(rows.length / state.pageSize + 1) : rows.length / state.pageSize;\r\n    // collect all applied filters from table\r\n\r\n    const selectedRows = page.filter(row => row.isSelected === true);\r\n\r\n    useEffect(() => {\r\n        dispatch(setIsRowSelected(selectedRows.length, [...selectedRows.map(row => { return row.original; })]));\r\n    }, [selectedRows.length]);\r\n\r\n    return (\r\n        <>\r\n            <ReactstrapTable responsive={true} {...getTableProps()}>\r\n                <thead>\r\n                    {globalFilter &&\r\n                        <tr>\r\n                            <th\r\n                                colSpan={visibleColumns.length}\r\n                                style={{\r\n                                    textAlign: 'left'\r\n                                }}>\r\n                                <GlobalFilter\r\n                                    preGlobalFilteredRows={preGlobalFilteredRows}\r\n                                    globalFilter={state.globalFilter}\r\n                                    setGlobalFilter={setGlobalFilter}/>\r\n                            </th>\r\n                        </tr>\r\n                    }\r\n                    {headerGroups.map(headerGroup => (\r\n                        <tr {...headerGroup.getHeaderGroupProps()}>\r\n                            {headerGroup.headers.map(column => (\r\n                                <th {...column.getHeaderProps()}>\r\n                                    {/* Render the columns filter UI */}\r\n                                    <span {...column.getHeaderProps(sortable && column.getSortByToggleProps())}>\r\n                                        {column.render('Header')}\r\n                                        {sortable &&\r\n                                            column.isSorted\r\n                                            ? column.isSortedDesc\r\n                                                ? ' 🔽'\r\n                                                : ' 🔼'\r\n                                            : ''\r\n                                        }\r\n                                    </span>\r\n                                    {column.canFilter ? column.render('Filter') : null}\r\n                                </th>\r\n                            ))}\r\n                        </tr>\r\n                    ))}\r\n                </thead>\r\n                <tbody {...getTableBodyProps()}>\r\n                    {page.length > 0\r\n                        ? (\r\n                            page.map((row, i) => {\r\n                                prepareRow(row);\r\n\r\n                                return (\r\n                                    <tr {...row.getRowProps()} className={`${row.isSelected ? 'selected-row' : ''}`}>\r\n                                        {row.cells.map(cell => {\r\n                                            return <td {...cell.getCellProps()}>{cell.render('Cell')}</td>;\r\n                                        })}\r\n                                    </tr>\r\n                                );\r\n                            })\r\n                        )\r\n                        : (\r\n                            <tr>\r\n                                <th className='text-muted'>\r\n                                    No data available\r\n                                </th>\r\n                            </tr>\r\n                        )}\r\n                </tbody>\r\n            </ReactstrapTable>\r\n            {pagination &&\r\n                <div className='pagination'>\r\n                    <span className={`cursor-pointer ${!canPreviousPage ? 'text-muted' : ''}`} onClick={() => previousPage()}>Prev</span>\r\n                    {Array.from(Array(paginationLoopLength), (_, i) => {\r\n                        const dynamicPageIndex = state.pageIndex > maxPage ? state.pageIndex - 2 + i : i + 1;\r\n\r\n                        return i <= maxPage && <span className={`cursor-pointer ${state.pageIndex + 1 === dynamicPageIndex ? 'active' : ''}`} onClick={() => gotoPage(dynamicPageIndex - 1)}>{dynamicPageIndex}</span>;\r\n                    })}\r\n                    <span className={`cursor-pointer ${!canNextPage ? 'text-muted' : ''}`} onClick={() => nextPage()}>Next</span>\r\n                </div>\r\n            }\r\n        </>\r\n    );\r\n}\r\n\r\n/* Custom filter function */\r\nfunction multiSelectFilter(rows, columnIds, filterValue) {\r\n    // Filters only if filters are selected\r\n    return filterValue.length === 0 ? rows : rows.filter((row) => filterValue.includes(String(row.original[columnIds])));\r\n}\r\n\r\n// Quantity custom filter function!\r\nfunction filterGreaterThan(rows, id, filterValue) {\r\n    const result = rows.filter(row => {\r\n        const rowValue = row.values[id];\r\n\r\n        switch (filterValue) {\r\n            case 1:\r\n                return rowValue <= 100000;\r\n            case 2:\r\n                return rowValue > 100000 && rowValue <= 500000;\r\n            case 3:\r\n                return rowValue > 500001 && rowValue <= 1000000;\r\n            case 4:\r\n                return rowValue > 1000000;\r\n            default:\r\n                return rowValue;\r\n        }\r\n    });\r\n\r\n    return result;\r\n}\r\n\r\ntype Props = {\r\n    children?: string | React.Node,\r\n    className?: string,\r\n    tableData: Array,\r\n    tableColumns: Array,\r\n    selectableRows: Boolean,\r\n    globalFilter: Boolean,\r\n    viewDetails: Function,\r\n}\r\n\r\nexport default function ReactTable({\r\n    children,\r\n    className = '',\r\n    tableData,\r\n    tableColumns,\r\n    selectableRows = false,\r\n    globalFilter = false,\r\n    pagination = false,\r\n    sortable = false,\r\n    viewDetails\r\n}: Props): React$Element<any> {\r\n    const columns = useMemo(\r\n        () => tableColumns.map(column => {\r\n            const rootPath = window.location.pathname.split('/')[1];\r\n\r\n            return {\r\n                Header: column.header,\r\n                accessor: column.accessor,\r\n                disableFilters: column.disableFilters,\r\n                Filter: column.accessor !== 'quantity' ? SelectColumnFilter : RadioColumnFilter,\r\n                filter: column.accessor !== 'quantity' ? multiSelectFilter : filterGreaterThan,\r\n                Cell: e => column.accessor === 'dateCreated'\r\n                    ? <span>{moment(e.value).format('DD/MM/YY')}</span>\r\n                    : <span className={`${column.clickable\r\n                        ? 'color-link-text cursor-pointer'\r\n                        : ''}`} onClick={() => rootPath === 'alerts' && column.accessor === 'behaviourCode'\r\n                        ? viewDetails(e.cell.row.original)\r\n                        : rootPath === 'behaviours' && column.accessor === 'internalCode'\r\n                            ? viewDetails(e.cell.row)\r\n                            : column.accessor === 'name'\r\n                                ? viewDetails(e.cell.row.original)\r\n                                : null}>{column.accessor === 'quantity'\r\n                            ? kFormatter(e.value)\r\n                            : column.accessor === 'escalation'\r\n                                ? <span className='font-weight-bold'>{getTextColor(e.value)}</span>\r\n                                : column.accessor === 'status'\r\n                                    ? <Badge status={e.value} />\r\n                                    : e.value}</span>,\r\n                sortType: column.accessor === 'date'\r\n                    ? (a, b, c, d) => {\r\n                        a = new Date(a.values.date).getTime();\r\n                        b = new Date(b.values.date).getTime();\r\n\r\n                        return b > a ? -1 : 1;\r\n                    }\r\n                    : 'alphanumeric'\r\n            };\r\n        }),\r\n        []\r\n    );\r\n\r\n    return (\r\n        <div className={`w-100 ${className}`}>\r\n            <Table columns={columns} data={tableData}\r\n                selectableRows={selectableRows}\r\n                globalFilter={globalFilter}\r\n                pagination={pagination}\r\n                sortable={sortable} />\r\n        </div>\r\n    );\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Breadcrumbs\\Breadcrumbs.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Badge\\Badge.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Pagination\\Pagination.js",[],["270","271","272"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",["273"],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",["274"],"// @flow\nimport React, { useState, useEffect } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport { useHistory } from 'react-router-dom';\nimport BehaviourDetailScreen from './BehaviourDetailScreen';\nimport { setSelectedBehaviour, setParametersData } from '../../redux/modules/behaviours';\nimport { getRule, getBehaviourByCode } from '../../api/behaviours';\nimport { getParametersByRuleId } from '../../api/parameters';\n\ntype Props = {\n    sidebarMenu: Array<Menu>,\n    handleCloseModal: Function\n}\n\nexport default function BehaviourDetailContainer({\n    match,\n    sidebarMenu,\n    handleCloseModal\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const [loading, setLoading] = useState(false);\n    const { selected } = useSelector(({ behaviours }) => behaviours);\n\n    const breadcrumb = [\n        {\n            label: 'Home',\n            path: '/dashboard'\n        },\n        {\n            label: 'Behaviours',\n            path: '/behaviours'\n        },\n        {\n            label: match.params.id,\n            path: `/behaviour/${match.params.id}`\n        }\n    ];\n\n    useEffect(() => {\n        loadBehaviourDetails();\n    }, []);\n\n    const loadBehaviourDetails = async () => {\n        setLoading(true);\n        const behaviourCode = localStorage.getItem('selectedBehaviourCode');\n\n        try {\n            const selectedBehaviour = await getBehaviourByCode(behaviourCode);\n\n            dispatch(setSelectedBehaviour(selectedBehaviour.data));\n\n            const rules = await getRule(selectedBehaviour.data.id);\n\n            localStorage.setItem('ruleId', rules.data.data[0].id);\n\n            const parameters = await getParametersByRuleId(rules.data.data[0].id);\n\n            dispatch(setParametersData(parameters.data.data));\n        } catch (e) {\n            console.error(e);\n        }\n\n        setLoading(false);\n    };\n\n    return <BehaviourDetailScreen\n        loading={loading}\n        breadcrumb={breadcrumb}\n        tableColumns={selected.columns}\n        tableData={selected.data}\n        selectedBehaviour={selected}\n        sidebarMenu={sidebarMenu}\n        handleCloseModal={handleCloseModal} />;\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Select\\Select.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\N