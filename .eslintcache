havioursScreen from './BehavioursScreen';\nimport type { Menu } from '../../types';\nimport { setBehavioursData } from '../../redux/modules/behaviours';\nimport { getBehaviours } from '../../api/behaviours';\n\ntype Props = {\n    sidebarMenu: Array<Menu>\n}\n\nexport default function BehavioursContainer({\n    sidebarMenu\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const history = useHistory();\n    const [loading, setLoading] = useState(false);\n    const { table } = useSelector(({ behaviours }) => behaviours);\n    const breadcrumb = [\n        {\n            label: 'Home',\n            path: '/dashboard'\n        },\n        {\n            label: 'Behaviours',\n            path: '/behaviours'\n        }\n    ];\n\n    const loadBehavioursData = async (activePage, pageSize, sort) => {\n        try {\n            const behaviours = await getBehaviours(activePage, pageSize, sort);\n            const { data, totalNoOfRecords, totalPages } = behaviours.data;\n\n            dispatch(setBehavioursData(data, totalNoOfRecords, totalPages));\n        } catch (e) {\n            console.error(e);\n        }\n    };\n\n    const viewBehaviourDetails = async row => {\n        localStorage.setItem('selectedBehaviourCode', row.original.code);\n\n        history.push(`/behaviour/${row.original.internalCode}`);\n    };\n\n    return <BehavioursScreen\n        loading={loading}\n        breadcrumb={breadcrumb}\n        tableColumns={table.columns}\n        tableData={table.data}\n        loadBehavioursData={loadBehavioursData}\n        viewBehaviourDetails={viewBehaviourDetails}\n        sidebarMenu={sidebarMenu} />;\n}\n","C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Alerts\\AlertsContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",["274"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport AlertDetailScreen from './AlertDetailScreen';\r\n\r\nimport { getUsers } from '../../api/users';\r\nimport { getAlert, downloadAlertsRecord } from '../../api/alerts';\r\nimport { getAlertSpecifics } from '../../api/alertSpecifics';\r\nimport { setAssignees, setSelectedAlert, setAlertSpecificsData } from '../../redux/modules/alerts';\r\n\r\ntype Props = {\r\n    sidebarMenu: Array<Menu>,\r\n    useMediaQuery: Function,\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function AlertDetailContainer({\r\n    match,\r\n    sidebarMenu,\r\n    useMediaQuery,\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const [loading, setLoading] = useState(false);\r\n    const { selected } = useSelector(({ alerts }) => alerts);\r\n    const breadcrumb = [\r\n        {\r\n            label: 'Home',\r\n            path: '/dashboard'\r\n        },\r\n        {\r\n            label: 'Alerts',\r\n            path: '/alerts'\r\n        },\r\n        {\r\n            label: match.params.id,\r\n            path: `/alert/${match.params.id}`\r\n        }\r\n    ];\r\n\r\n    useEffect(() => {\r\n        loadAlertDetails();\r\n        loadUsers();\r\n        loadAlertSpecifics();\r\n    }, []);\r\n\r\n    const loadAlertDetails = async () => {\r\n        setLoading(true);\r\n        const alertId = localStorage.getItem('selectedAlertId');\r\n\r\n        try {\r\n            const alerts = await getAlert(alertId);\r\n\r\n            dispatch(setSelectedAlert(alerts.data));\r\n        } catch (e) {\r\n            console.error(e);\r\n        }\r\n\r\n        setLoading(false);\r\n    };\r\n\r\n    const loadUsers = async () => {\r\n        const users = await getUsers();\r\n        const filteredUsers = users.data.data.filter(user => user.userRegistrationType === 'EMAIL');\r\n\r\n        dispatch(setAssignees(filteredUsers));\r\n    };\r\n\r\n    const loadAlertSpecifics = async () => {\r\n        const alertId = localStorage.getItem('selectedAlertId');\r\n        const alertSpecific = await getAlertSpecifics(alertId);\r\n\r\n        console.log(alertSpecific);\r\n\r\n        if (alertSpecific.status === 200) dispatch(setAlertSpecificsData(alertSpecific.data));\r\n    };\r\n\r\n    const handleDownloadAlertsRecord = async () => {\r\n        await downloadAlertsRecord(selected.data.id);\r\n    };\r\n\r\n    return <AlertDetailScreen\r\n        loading={loading}\r\n        setLoading={setLoading}\r\n        breadcrumb={breadcrumb}\r\n        sidebarMenu={sidebarMenu}\r\n        useMediaQuery={useMediaQuery}\r\n        handleCloseModal={handleCloseModal}\r\n        selectedAlert={selected.data}\r\n        assignees={selected.assignees}\r\n        alertSpecifics={selected.alertSpecifics}\r\n        handleDownloadAlertsRecord={handleDownloadAlertsRecord} />;\r\n}\r\n","C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\RestrictedList\\RestrictedListContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\components\\base\\Typography\\Typography.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\notifications.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\components\\base\\Button\\Button.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\makeApiCall.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\RestrictedList\\RestrictedListScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\restrictedList.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\behaviours.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\users.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\parameters.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\alerts.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",["275"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport moment from 'moment';\r\nimport Badge from '../../components/base/Badge/Badge';\r\nimport Button from '../../components/base/Button/Button';\r\nimport Select from '../../components/base/Select/Select';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\r\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\r\nimport withLoading from '../../components/modules/withLoading/withLoading';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport type { Menu } from '../../types';\r\nimport {\r\n    Row,\r\n    Col,\r\n    Card,\r\n    CardBody,\r\n    FormGroup,\r\n    FormFeedback,\r\n    Alert,\r\n    Input,\r\n    Label,\r\n    Spinner\r\n} from 'reactstrap';\r\nimport './alert-detail.scss';\r\n\r\nimport { updateAlert } from '../../api/alerts';\r\nimport { setModalContent } from '../../redux/modules/modalEvent';\r\nimport { replaceAlertDetails } from '../../redux/modules/alerts';\r\n\r\ntype Props = {\r\n    loading: Boolean,\r\n    breadcrumb: Array,\r\n    sidebarMenu: Array<Menu>,\r\n    useMediaQuery: Function,\r\n    handleCloseModal: Function,\r\n    selectedAlert: Object,\r\n    assignees: Array,\r\n    alertSpecifics: Object,\r\n    handleDownloadAlertsRecord: Function\r\n}\r\n\r\nfunction AlertDetailScreen({\r\n    loading,\r\n    breadcrumb,\r\n    sidebarMenu,\r\n    useMediaQuery,\r\n    handleCloseModal,\r\n    selectedAlert,\r\n    assignees,\r\n    alertSpecifics,\r\n    handleDownloadAlertsRecord\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const isTabletOrMobile = useMediaQuery({ query: '(max-width: 1199px)' });\r\n    const isLaptopScreen = useMediaQuery({ query: '(max-width: 1450px)' });\r\n    const [submit, setSubmit] = useState(false);\r\n    const [alert, setAlert] = useState({\r\n        notes: '',\r\n        status: '',\r\n        assignedUser: '',\r\n        escalation: '',\r\n        resolveReason: '',\r\n        errors: {}\r\n    });\r\n\r\n    useEffect(() => {\r\n        if (alert.status === 'RESOLVED') showResolveAlert();\r\n    }, [alert]);\r\n\r\n    const showError = errMsg => {\r\n        dispatch(setModalContent({\r\n            modalContent: <ErrorMsgModal\r\n                errMsg={errMsg}\r\n                handleCloseModal={handleCloseModal} />\r\n        }));\r\n    };\r\n\r\n    const showResolveAlert = () => {\r\n        dispatch(setModalContent({\r\n            modalContent: <ResolveAlertModal selectedAlert={selectedAlert} handleCloseModal={handleCloseModal}\r\n                handleUpdateAlert={handleUpdateAlert} alert={alert} handleChange={handleChange} />\r\n        }));\r\n    };\r\n\r\n    const handleChange = (e, option) => {\r\n        let name, value;\r\n\r\n        if (option === undefined) {\r\n            name = e.target.name;\r\n            value = e.target.value;\r\n        } else {\r\n            name = option.name;\r\n            value = option.name === 'assignedUser' ? e.id : e.name;\r\n        }\r\n\r\n        if (alert.errors[name] !== undefined) alert.errors[name] = false; // remove error msg for a specific input\r\n\r\n        setAlert({\r\n            ...alert,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    const handleUpdateAlert = async () => {\r\n        setSubmit(true);\r\n        const userId = localStorage.getItem('userId');\r\n\r\n        const payload = {\r\n            id: selectedAlert.id,\r\n            ruleId: selectedAlert.ruleId,\r\n            currentUserId: userId,\r\n            behaviourId: selectedAlert.behaviourId,\r\n            behaviourCode: selectedAlert.behaviourCode,\r\n            broker: selectedAlert.broker,\r\n            book: selectedAlert.book,\r\n            ticker: selectedAlert.ticker,\r\n            quantity: selectedAlert.quantity,\r\n            client: selectedAlert.client,\r\n            orderType: selectedAlert.orderType,\r\n            details: selectedAlert.details,\r\n            behaviourDescription: selectedAlert.behaviourDescription,\r\n            assignedUserId: alert.assignedUser === '' ? null : alert.assignedUser,\r\n            escalation: alert.escalation === '' ? selectedAlert.escalation : alert.escalation,\r\n            status: alert.status === '' ? selectedAlert.status : alert.status,\r\n            notes: alert.notes === '' ? selectedAlert.notes : alert.notes,\r\n            resolveReason: alert.resolveReason === '' ? selectedAlert.resolveReason : alert.resolveReason,\r\n            parameterValues: selectedAlert.parameterValues,\r\n            dateCreated: selectedAlert.dateCreated,\r\n            alertDate: selectedAlert.alertDate\r\n        };\r\n\r\n        const result = await updateAlert(payload);\r\n\r\n        if (result.data.responseStatus === 'success') {\r\n            setTimeout(() => {\r\n                dispatch(replaceAlertDetails(result.data));\r\n                setSubmit(false);\r\n                handleCloseModal();\r\n            }, 1000);\r\n        } else {\r\n            handleCloseModal();\r\n            showError(result.data.exceptionMessage);\r\n            setSubmit(false);\r\n        }\r\n    };\r\n\r\n    // const handleValidation = () => {\r\n    //     const errors = {};\r\n    //     let formIsValid = true;\r\n\r\n    //     if (validator.isEmpty(alert.resolveReason) || typeof alert.resolveReason === 'undefined') {\r\n    //         formIsValid = false;\r\n    //         errors.resolveReason = true;\r\n    //         errors.resolveReasonErrMsg = 'Reason is required';\r\n    //     }\r\n\r\n    //     setAlert({\r\n    //         ...alert,\r\n    //         errors\r\n    //     });\r\n\r\n    //     return formIsValid;\r\n    // };\r\n\r\n    return (\r\n        <div className='alert-detail'>\r\n            <CollapsibleSidebar\r\n                menu={sidebarMenu} />\r\n            <div className='w-100 overflow-auto'>\r\n                <Breadcrumbs links={breadcrumb} />\r\n                <div className='alert-detail__content'>\r\n                    <Card className='px-4 py-2'>\r\n                        <CardBody>\r\n                            <div className='alert-detail__header d-sm-block d-md-flex align-items-start'>\r\n                                <Typography color='color-3' className='alert-detail__title mr-auto'>{selectedAlert.behaviourCode}</Typography>\r\n                                <Button label={<>\r\n                                    <FontAwesomeIcon className='mr-3' icon='file-download' size='sm' />\r\n                                    <Typography weight='light' className='my-1 mx-2'>Download</Typography>\r\n                                </>}\r\n                                className='ml-sm-0 ml-md-4 d-flex align-items-center alert-detail__download-button px-4'\r\n                                size='lg' onClick={handleDownloadAlertsRecord} />\r\n                            </div>\r\n                            <Row className='mt-4'>\r\n                                <Col sm={12} md={12} lg={12}\r\n                                    xl={8}>\r\n                                    <div className='alert-detail__information'>\r\n                                        {loading || Object.keys(selectedAlert).length === 0\r\n                                            ? <Spinner animation='border' role='status' className='d-flex mx-auto my-5 text-center'>\r\n                                                <span className='sr-only'>Loading...</span>\r\n                                            </Spinner>\r\n                                            : <>\r\n                                                <Row>\r\n                                                    <Col lg={12} xl={!isLaptopScreen ? 6 : 12}>\r\n                                                        <table className='alert-detail__information-table'>\r\n                                                            <tbody>\r\n                                                                <tr>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3' className='mr-3' weight='semi-bold'>Alert Type</Typography>\r\n                                                                    </td>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3'>{selectedAlert.behaviourDescription || '—'}</Typography>\r\n                                                                    </td>\r\n                                                                </tr>\r\n                                                                <tr>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3' className='mr-3' weight='semi-bold'>Date</Typography>\r\n                                                                    </td>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3'>{selectedAlert.dateCreated ? moment(selectedAlert.dateCreated).format('DD/MM/YY h:mm A') : '—'}</Typography>\r\n                                                                    </td>\r\n                                                                </tr>\r\n                                                                <tr>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3' className='mr-3' weight='semi-bold'>Mariana Broker</Typography>\r\n                                                                    </td>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3'>{selectedAlert.broker || '—'}</Typography>\r\n                                                                    </td>\r\n                                                                </tr>\r\n                                                                <tr>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3' className='mr-3' weight='semi-bold'>Mariana Branch</Typography>\r\n                                                                    </td>\r\n                                                                    <td className='pb-2'>\r\n                                                                        <Typography color='color-3'>{selectedAlert.book || '—'}</Typography>\r\n                                                                    </td>\r\n                                                                </tr>\r\n                                                                {\r\n                                                                    (selectedAlert.behaviourCode === 'LARGE_ORDER_MUFP' ||\r\n                                                                    selectedAlert.behaviourCode === 'HIGH_VOLUME_MUFP' ||\r\n                                                                    selectedAlert.behaviourCode === 'HIGH_ORDER_MUFP')\r\n                                                                        ? <>\r\n                                                                            <tr>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3' className='mr-3' weight='semi-bold'>Client ID</Typography>\r\n                                                                                </td>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3'>{alertSpecifics.clientIds || '—'}</Typography>\r\n                                                                                </td>\r\n                                                                            </tr>\r\n                                                                            <tr>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3' className='mr-3' weight='semi-bold'>Client Name</Typography>\r\n                                                                                </td>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3'>{alertSpecifics.clientTraders || '—'}</Typography>\r\n                                                                                </td>\r\n                                                                            </tr>\r\n                                                                            <tr>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3' className='mr-3' weight='semi-bold'>Client Trader</Typography>\r\n                                                                                </td>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3'>{'—'}</Typography>\r\n                                                                                </td>\r\n                                                                            </tr>\r\n                                                                        </>\r\n                                                                        : <>\r\n                                                                            <tr>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3' className='mr-3' weight='semi-bold'>Client ID</Typography>\r\n                                                                                </td>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3'>{selectedAlert.client || '—'}</Typography>\r\n                                                                                </td>\r\n                                                                            </tr>\r\n                                                                            <tr>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3' className='mr-3' weight='semi-bold'>Client Name</Typography>\r\n                                                                                </td>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3'>{selectedAlert.clientTrader || '—'}</Typography>\r\n                                                                                </td>\r\n                                                                            </tr>\r\n                                                                            <tr>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3' className='mr-3' weight='semi-bold'>Client Trader</Typography>\r\n                                                                                </td>\r\n                                                                                <td className='pb-2'>\r\n                                                                                    <Typography color='color-3'>{'—'}</Typography>\r\n                                                                                </td>\r\n                                                                            </tr>\r\n                                                                        </>\r\n                                                                }\r\n                                                            </tbody>\r\n                                                        </table>\r\n                                                    </Col>\r\n                                                    <Col lg={12} xl={!isLaptopScreen ? 6 : 12}>\r\n                                                        <table className='alert-detail__information-table__specifics'>\r\n                                                            <tbody>\r\n                                                                {typeof alertSpecifics !== 'undefined' &&\r\n                                                                    selectedAlert.behaviourCode === 'FLASH' &&\r\n                                                                    <>\r\n                                                                        <tr>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3' className='mr-3' weight='semi-bold'>Ticker</Typography>\r\n                                                                            </td>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3'>{selectedAlert.ticker || '—'}</Typography>\r\n                                                                            </td>\r\n                                                                        </tr>\r\n                                                                        <tr>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3' className='mr-3' weight='semi-bold'>Buy Time</Typography>\r\n                                                                            </td>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3'>{alertSpecifics.buyTime ? moment(alertSpecifics.buyTime).format('DD/MM/YY h:mm A') : '—'}</Typography>\r\n                                                                            </td>\r\n                                                                        </tr>\r\n                                                                        <tr>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3' className='mr-3' weight='semi-bold'>Buy Volume</Typography>\r\n                                                                            </td>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3'>{alertSpecifics.buyVolume || '—'}</Typography>\r\n                                                                            </td>\r\n                                                                        </tr>\r\n                                                                        <tr>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3' className='mr-3' weight='semi-bold'>Buy Price</Typography>\r\n                                                                            </td>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3'>{alertSpecifics.buyPrice || '—'}</Typography>\r\n                                                                            </td>\r\n                                                                        </tr>\r\n                                                                        <tr>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3' className='mr-3' weight='semi-bold'>Buy Fill ID</Typography>\r\n                                                                            </td>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3'>{alertSpecifics.buyFillId || '—'}</Typography>\r\n                                                                            </td>\r\n                                                                        </tr>\r\n                                                                        <tr>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3' className='mr-3' weight='semi-bold'>Sell Time</Typography>\r\n                                                                            </td>\r\n                                                                            <td className='pb-2'>\r\n                                                                                <Typography color='color-3'>{alertSpecifics.sellTime ? moment(alertSpecifics.sellTime).format('DD/MM/YY h:mm A') : '—'}</Typography>\r\n                                                                            </td>\r\n                                                                        </tr>\r\n                                                                        <tr>\r\n         