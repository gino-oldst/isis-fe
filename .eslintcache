t":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"191","messages":"192","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"193","messages":"194","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"195"},{"filePath":"196","messages":"197","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"198","messages":"199","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"200","messages":"201","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"202","messages":"203","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"204","messages":"205","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"206","messages":"207","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"208","messages":"209","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"210","messages":"211","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"212","messages":"213","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"214"},"D:\\Old.St Labs\\project-measure-frontend\\src\\index.js",[],["215","216","217"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\store.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\reportWebVitals.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\App\\AppContainer.js",["218"],"import React, { useState, useEffect } from 'react';\r\nimport { Switch, Route, useHistory, Redirect } from 'react-router-dom';\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport moment from 'moment';\r\nimport routes from '../../config/routes';\r\nimport AppLoadingContainer from '../AppLoading/AppLoadingContainer';\r\nimport AppModal from '../../components/base/Modal/Modal';\r\nimport FlashNotification from '../../components/modules/FlashNotification/FlashNotification';\r\nimport WrapperBackground from '../../components/base/WrapperBackground/WrapperBackground';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Badge from '../../components/base/Badge/Badge';\r\nimport Tooltip from '../../components/base/Tooltip/Tooltip';\r\nimport Navbar from '../../components/base/Navbar/Navbar';\r\nimport { clearModalContent } from '../../redux/modules/modalEvent';\r\nimport { setLoggingOut } from '../../redux/modules/authentication';\r\nimport navbarBrand from '../../assets/logos/mariana_logo.png';\r\nimport bellIcon from '../../assets/images/ic_bell-solid-white.svg';\r\nimport './app.scss';\r\n\r\nimport {\r\n    Nav,\r\n    UncontrolledDropdown,\r\n    DropdownItem,\r\n    DropdownMenu,\r\n    DropdownToggle,\r\n    Spinner\r\n} from 'reactstrap';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\n\r\nconst loading = () => (\r\n    <WrapperBackground>\r\n        <Spinner animation='border' role='status'>\r\n            <span className='sr-only'>Loading...</span>\r\n        </Spinner>\r\n    </WrapperBackground>\r\n);\r\n\r\nfunction App() {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n    const { modalContent, onToggle, ...modalEvent } = useSelector(({ modalEvent }) => modalEvent);\r\n    const { data } = useSelector(({ notifications }) => notifications);\r\n    const { isAuthed } = useSelector(({ authentication }) => authentication);\r\n    const [todaysNotification, setTodaysNotification] = useState({});\r\n    const [yesterdaysNotification, setYesterdaysNotification] = useState({});\r\n\r\n    useEffect(() => {\r\n        const today = [];\r\n        const yesterday = [];\r\n\r\n        data.map(notif => {\r\n            return moment(notif.date).isSame(moment(), 'day')\r\n                ? today.push(notif)\r\n                : yesterday.push(notif);\r\n        });\r\n\r\n        setTodaysNotification(today);\r\n        setYesterdaysNotification(yesterday);\r\n    }, []);\r\n\r\n    const sidebarMenu = [{\r\n        label: 'Dashboard',\r\n        onClick: () => history.push('/dashboard'),\r\n        key: 'dashboard'\r\n    }, {\r\n        label: 'Alerts',\r\n        onClick: () => history.push('/alerts'),\r\n        key: 'alert'\r\n    }, {\r\n        label: 'Behaviours',\r\n        onClick: () => history.push('/behaviours'),\r\n        key: 'behaviour'\r\n    }];\r\n\r\n    const handleCloseModal = () => {\r\n        dispatch(clearModalContent());\r\n        onToggle && onToggle();\r\n\r\n        // To show modal, do this something like this:\r\n        // dispatch(setModalContent({\r\n        //     modalContent: <LoginContainer />,\r\n        //     title: 'Login'\r\n        // }));\r\n    };\r\n\r\n    const NavbarLinks = () => {\r\n        return (\r\n            <Nav className='navlinks-right'>\r\n                <UncontrolledDropdown nav={true} direction='down' className='d-flex align-self-center mr-4'>\r\n                    <Notifications today={todaysNotification} yesterday={yesterdaysNotification} />\r\n                </UncontrolledDropdown>\r\n                <UncontrolledDropdown nav={true} direction='down' className='mr-4'>\r\n                    <NavbarAccount />\r\n                </UncontrolledDropdown>\r\n            </Nav>\r\n        );\r\n    };\r\n\r\n    return (\r\n        <AppLoadingContainer>\r\n            <div id='outer-container'>\r\n                {/* {isAuthed && <Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>} */}\r\n                {<Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>}\r\n                <React.Suspense fallback={loading()}>\r\n                    <Switch>\r\n                        {routes.map((route, i) => (\r\n                            route.authedRoute\r\n                                ? <PrivateRoute key={i} {...route} sidebarMenu={sidebarMenu}\r\n                                    handleCloseModal={handleCloseModal}\r\n                                    isAuthed={isAuthed} />\r\n                                : <RouteWithSubRoutes key={i} {...route} handleCloseModal={handleCloseModal} />\r\n                        ))}\r\n                    </Switch>\r\n                </React.Suspense>\r\n            </div>\r\n\r\n            <FlashNotification/>\r\n            <AppModal\r\n                {...modalEvent}\r\n                isShow={!!modalContent}\r\n                onToggle={handleCloseModal}>\r\n                {modalContent}\r\n            </AppModal>\r\n        </AppLoadingContainer>\r\n    );\r\n}\r\n\r\nconst Notifications = ({\r\n    today,\r\n    yesterday\r\n}) => {\r\n    return (\r\n        <div className='navbar__notifications'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__notification-bell' icon='bell' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true} className='mt-2 navbar__notifications-dropdown'>\r\n                <div className='navbar__notifications-title px-4 pt-2'>\r\n                    <Typography color='color-3' weight='semi-bold' variant='size-16'\r\n                        className='mb-2'>Notifications</Typography>\r\n                </div>\r\n                <div className='navbar__notifications-today'>\r\n                    {today.length > 0 &&\r\n                        <div className='navbar__notifications-today-title px-4 py-1'>\r\n                            <Typography color='color-3' weight='light' variant='size-10'>TODAY</Typography>\r\n                        </div>\r\n                    }\r\n                    {today.map((now, idx) => {\r\n                        return (\r\n                            <DropdownItem key={`today-${idx}`} className='px-4 py-4 d-flex align-items-center'>\r\n                                <div className='navbar__notifications__icon'>\r\n                                    <img src={bellIcon} alt='Notification_Bell_Icon' className='notification_icon' />\r\n                                </div>\r\n                                <div className='navbar__notifications__details mr-auto'>\r\n                                    <Typography color='color-3' variant='size-14' weight='semi-bold'\r\n                                        className='mb-2'>{now.description}</Typography>\r\n                                    <Typography color='color-3' variant='size-16' className='mb-2'>\r\n                                        <span className='mr-3'>{now.identifier} | {now.behaviour}</span>\r\n                                        <Badge status={now.status} />\r\n                                    </Typography>\r\n                                    <Typography color='color-3' variant='size-12' className='text-muted'>Today, {moment(now.date).format('hh:mm a')}</Typography>\r\n                                </div>\r\n                                <div className='navbar__notifications__read-icon mr-2'>\r\n                                    <FontAwesomeIcon className='navbar__notification-read' icon='circle' size='xs'\r\n                                        data-tip={true} data-for='notif-1'/>\r\n                                </div>\r\n                                <Tooltip place='left' id='notif-1'>\r\n                                    <Typography variant='size-10' weight='light' color='color-3'>{now.resolved ? 'Unread' : 'Mark as read'}</Typography>\r\n                                </Tooltip>\r\n                            </DropdownItem>\r\n                        );\r\n                    })}\r\n                </div>\r\n                <div className='navbar__notifications-past'>\r\n                    {yesterday.length > 0 &&\r\n                        <div className='navbar__notifications-past-title px-4 py-1'>\r\n                            <Typography color='color-3' weight='light' variant='size-10'>YESTERDAY AND EARLIER</Typography>\r\n                        </div>\r\n                    }\r\n                    {yesterday.map((yes, idx) => {\r\n                        return (\r\n                            <DropdownItem key={`yesterdat-${idx}`} className='px-4 py-4 d-flex align-items-center'>\r\n                                <div className='navbar__notifications__icon'>\r\n                                    <img src={bellIcon} alt='Notification_Bell_Icon' className='notification_icon' />\r\n                                </div>\r\n                                <div className='navbar__notifications__details mr-auto'>\r\n                                    <Typography color='color-3' variant='size-14' weight='semi-bold'\r\n                                        className='mb-2'>{yes.description}</Typography>\r\n                                    <Typography color='color-3' variant='size-16' className='mb-2'>\r\n                                        <span className='mr-3'>{yes.identifier} | {yes.behaviour}</span>\r\n                                        <Badge status={yes.status} />\r\n                                    </Typography>\r\n                                    <Typography color='color-3' variant='size-12' className='text-muted'>{moment(yes.date).format('DD MMM yyyy, hh:mm a')}</Typography>\r\n                                </div>\r\n                                <div className='navbar__notifications__read-icon mr-2'>\r\n                                    <FontAwesomeIcon className='navbar__notification-read' icon='circle' size='xs'\r\n                                        data-tip={true} data-for='notif-2'/>\r\n                                </div>\r\n                                <Tooltip place='left' id='notif-2'>\r\n                                    <Typography variant='size-10' weight='light' color='color-3'>{yes.resolved ? 'Unread' : 'Mark as read'}</Typography>\r\n                                </Tooltip>\r\n                            </DropdownItem>\r\n                        );\r\n                    })}\r\n                </div>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\nconst NavbarAccount = () => {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n\r\n    const logout = () => {\r\n        localStorage.clear();\r\n        dispatch(setLoggingOut());\r\n        window.location.href = '/login';\r\n    };\r\n\r\n    return (\r\n        <div className='navbar__account'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__user-icon' icon='user-circle' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true}>\r\n                <DropdownItem className='px-4 py-2' onClick={() => history.push('/reset-password')}>\r\n                    Change Password\r\n                </DropdownItem>\r\n                <DropdownItem className='px-4 py-2' onClick={logout}>\r\n                    Logout\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\n// A special wrapper for <Route> that knows how to\r\n// handle \"sub\"-routes by passing them in a `routes`\r\n// prop to the component it renders.\r\nfunction RouteWithSubRoutes({ component: Component, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route\r\n            {...rest}\r\n            render={props => (\r\n                // pass the sub-routes down to keep nesting\r\n                <Component {...props} routes={props.routes} handleCloseModal={handleCloseModal} />\r\n            )} />\r\n    );\r\n}\r\n\r\nfunction PrivateRoute({ component: Component, isAuthed, sidebarMenu, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route {...rest} render={(routeProps) => (\r\n            <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            // isAuthed\r\n            //     ? <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            //     : <Redirect to={{\r\n            //         pathname: '/login',\r\n            //         state: { from: routeProps.location }\r\n            //     }}/>\r\n        )}/>\r\n    );\r\n}\r\n\r\nexport default App;\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\reducers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AppLoading\\AppLoadingContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\modalEvent.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\routes.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\WrapperBackground\\WrapperBackground.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Modal\\Modal.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Navbar\\Navbar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\FlashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",["219","220","221","222"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport { useHistory } from 'react-router-dom';\r\n\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport { faCoffee } from '@fortawesome/free-solid-svg-icons';\r\nimport Login from './LoginScreen';\r\nimport { isValidEmail } from '../../utils/helpers';\r\nimport { authUser } from '../../redux/modules/authentication';\r\nimport { saveAuthorizationToken, checkAuthorization } from '../../utils/Auth';\r\nimport { setFlashNotification } from '../../redux/modules/flashNotification';\r\n\r\ntype Props = {\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function LoginContainer({\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const history = useHistory();\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [errMsg, setErrMsg] = useState('');\r\n    const [loginForm, setLoginForm] = useState({\r\n        email: '',\r\n        password: ''\r\n    });\r\n\r\n    // check if user is logged in\r\n    // useEffect(() => {\r\n    //     checkAuth();\r\n    // }, []);\r\n\r\n    // const checkAuth = async () => {\r\n    //     const auth = await checkAuthorization();\r\n\r\n    //     if (auth) history.push('/dashboard');\r\n    // };\r\n\r\n    const onSubmit = async e => {\r\n        setIsLoading(true);\r\n        setErrMsg('');\r\n        e.preventDefault();\r\n\r\n        try {\r\n            if (isValidEmail(loginForm.email) && loginForm.password) {\r\n                // const response = await userLogin(loginForm);\r\n\r\n                // if (Object.keys(response).length === 0) {\r\n                //     setErrMsg('Invalid email!');\r\n                // } else if (response.data.message) {\r\n                //     setErrMsg(response.data.message);\r\n                // } else {\r\n                //     const { data } = response;\r\n\r\n                //     localStorage.setItem('userId', data.userId);\r\n                //     saveAuthorizationToken(data.token);\r\n                //     dispatch(authUser({\r\n                //         email: loginForm.email\r\n                //     }));\r\n\r\n                //     history.replace('/dashboard');\r\n                // }\r\n\r\n                localStorage.setItem('userId', 1);\r\n                saveAuthorizationToken('temp_token');\r\n                dispatch(authUser({\r\n                    email: loginForm.email\r\n                }));\r\n\r\n                history.replace('/dashboard');\r\n            }\r\n        } catch (err) {\r\n            dispatch(setFlashNotification({\r\n                message: 'ERROR',\r\n                isError: true\r\n            }));\r\n        }\r\n    };\r\n\r\n    const onChange = e => {\r\n        const { name, value } = e.target;\r\n\r\n        setLoginForm({\r\n            ...loginForm,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    return <Login\r\n        onSubmit={onSubmit}\r\n        onChange={onChange}\r\n        isLoading={isLoading}\r\n        errMsg={errMsg}\r\n        setErrMsg={setErrMsg}\r\n        handleCloseModal={handleCloseModal} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsContainer.js",["223"],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsScreen.js",["224"],"// @flow\r\nimport React, { useState } from 'react';\r\nimport Table from '../../components/base/Table/Table';\r\nimport Button from '../../components/base/Button/Button';\r\nimport DatePicker from '../../components/base/DatePicker/DatePicker';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\r\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\r\nimport withLoading from '../../components/modules/withLoading/withLoading';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport CustomDropdown from '../../components/base/CustomDropdown/CustomDropdown';\r\nimport filterIcon from '../../assets/images/ic_filter.svg';\r\nimport type { Menu } from '../../types';\r\nimport {\r\n    Card,\r\n    CardBody,\r\n    Spinner,\r\n    DropdownItem,\r\n    FormGroup,\r\n    Input,\r\n    Label\r\n} from 'reactstrap';\r\nimport './alerts.scss';\r\n\r\ntype Props = {\r\n    tableColumns: Array,\r\n    tableData: Array,\r\n    filters: Array,\r\n    setFilters: Function,\r\n    viewAlertDetails: Function,\r\n    sidebarMenu: Array<Menu>\r\n}\r\n\r\nfunction AlertsScreen({\r\n    tableColumns,\r\n    tableData,\r\n    filters,\r\n    setFilters,\r\n    viewAlertDetails,\r\n    sidebarMenu\r\n}: Props): React$Element<any> {\r\n    return (\r\n        <div className='alerts'>\r\n            <CollapsibleSidebar\r\n                menu={sidebarMenu} />\r\n            <div className='w-100 overflow-auto'>\r\n                <Breadcrumbs links={['Home', 'Alerts']} />\r\n                <div className='alerts__content'>\r\n                    <Card className='px-4 py-2'>\r\n                        <CardBody>\r\n                            <div className='alerts__header d-flex align-items-center'>\r\n                                <Typography color='color-3' className='alerts__title mr-auto'>Alerts</Typography>\r\n                                <div className='alerts__date-picker d-flex align-items-center justify-content-end mb-4'>\r\n                                    <CustomDropdown tag='span'\r\n                                        toggle={<input type='date' />}>\r\n                                        <DropdownItem header={true} className='text-center'>\r\n                                            <img src={filterIcon} alt='talbe-filter-icon' />\r\n                                        </DropdownItem>\r\n                                        <DropdownItem divider={true} />\r\n                                        <div className='alerts__date-filter-options'>\r\n                                            <FormGroup tag='fieldset'>\r\n                                                <FormGroup check={true} className='mb-1'>\r\n                                                    <Label check={true}>\r\n                                                        <Input type='radio' name='radio' />{' '}\r\n                                                    Today\r\n                                                    </Label>\r\n                                                </FormGroup>\r\n                                                <FormGroup check={true} className='mb-1'>\r\n                                                    <Label check={true}>\r\n                                                        <Input type='radio' name='radio' />{' '}\r\n                                                    Last 7 Days\r\n                                                    </Label>\r\n                                                </FormGroup>\r\n                                                <FormGroup check={true} className='mb-1'>\r\n                                                    <Label check={true}>\r\n                                                        <Input type='radio' name='radio' />{' '}\r\n                                                        <span className='mr-2'>Specific Date</span>\r\n                                                    </Label>\r\n                                                    <DatePicker width={55} format='dd MMM yyyy' className='alerts__date-filter-picker'\r\n                                                        inputVariant='outlined' />\r\n                                                </FormGroup>\r\n                                            </FormGroup>\r\n                                        </div>\r\n                                        <DropdownItem divider={true} />\r\n                                        <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                                            className='alerts__filter-reset-button float-right mr-2'/>\r\n                                    </CustomDropdown>\r\n                                    <Typography color='color-3' variant='size-16' className='mx-4'>to</Typography>\r\n                                    <CustomDropdown tag='span'\r\n                                        toggle={<input type='date' />}>\r\n                                        <DropdownItem header={true} className='text-center'>\r\n                                            <img src={filterIcon} alt='talbe-filter-icon' />\r\n                                        </DropdownItem>\r\n                                        <DropdownItem divider={true} />\r\n                                        <div className='alerts__date-filter-options'>\r\n                                            <FormGroup tag='fieldset'>\r\n                                                <FormGroup check={true} className='mb-1'>\r\n                                                    <Label check={true}>\r\n                                                        <Input type='radio' name='radio' />{' '}\r\n                                                    Today\r\n                                                    </Label>\r\n                                                </FormGroup>\r\n                                                <FormGroup check={true} className='mb-1'>\r\n                                                    <Label check={true}>\r\n                                                        <Input type='radio' name='radio' />{' '}\r\n                                                    Last 7 Days\r\n                                                    </Label>\r\n                                                </FormGroup>\r\n                                                <FormGroup check={true} className='mb-1'>\r\n                                                    <Label check={true}>\r\n                                                        <Input type='radio' name='radio' />{' '}\r\n                                                        <span className='mr-2'>Specific Date</span>\r\n                                                    </Label>\r\n                                                    <DatePicker width={55} format='dd MMM yyyy' className='alerts__date-filter-picker'\r\n                                                        inputVariant='outlined' />\r\n                                                </FormGroup>\r\n                                            </FormGroup>\r\n                                        </div>\r\n                                        <DropdownItem divider={true} />\r\n                                        <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                                            className='alerts__filter-reset-button float-right mr-2'/>\r\n                                    </CustomDropdown>\r\n                                    <Button label={<>\r\n                                        <FontAwesomeIcon className='mr-3' icon='file-download' size='sm' />\r\n                                        <Typography weight='light' className='my-1 mx-2'>Download</Typography>\r\n                                    </>}\r\n                                    className='ml-4 d-flex align-items-center alerts__download-button'\r\n                                    size='lg' />\r\n                                </div>\r\n                            </div>\r\n                            {tableColumns === undefined || tableData === undefined\r\n                                ? (\r\n                                    <Spinner />\r\n                                )\r\n                                : (\r\n                                    <Table className='alerts__table'\r\n                                        tableData={tableData}\r\n                                        tableColumns={tableColumns}\r\n                                        selectableRows={true}\r\n                                        globalFilter={true}\r\n                                        pagination={true}\r\n                                        sortable={true}\r\n                                        filters={filters}\r\n                                        setFilters={setFilters}\r\n                                        viewDetails={viewAlertDetails} />\r\n                                )}\r\n                        </CardBody>\r\n                    </Card>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nconst Alerts: any = withLoading<React$Element<Props>>(AlertsScreen);\r\n\r\nexport default Alerts;\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",["225"],"// @flow\nimport React, { useState } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport { useHistory } from 'react-router-dom';\nimport BehavioursScreen from './BehavioursScreen';\nimport type { Menu } from '../../types';\nimport { setSelectedBehaviour } from '../../redux/modules/behaviours';\n\ntype Props = {\n    sidebarMenu: Array<Menu>\n}\n\nexport default function BehavioursContainer({\n    sidebarMenu\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const history = useHistory();\n    const { table } = useSelector(({ behaviours }) => behaviours);\n\n    const viewBehaviourDetails = async (path, identifier, behaviour) => {\n        await dispatch(setSelectedBehaviour(identifier, behaviour));\n\n        history.push(path);\n    };\n\n    return <BehavioursScreen\n        tableColumns={table.columns}\n        tableData={table.data}\n        viewBehaviourDetails={viewBehaviourDetails}\n        sidebarMenu={sidebarMenu} />;\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",["226","227","228"],"// @flow\nimport React from 'react';\nimport moment from 'moment';\nimport Badge from '../../components/base/Badge/Badge';\nimport Table from '../../components/base/Table/Table';\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\nimport Typography from '../../components/base/Typography/Typography';\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\nimport withLoading from '../../components/modules/withLoading/withLoading';\nimport { getTextColor } from '../../utils/helpers';\nimport type { Menu } from '../../types';\nimport {\n    Card,\n    CardBody\n} from 'reactstrap';\nimport './behaviours.scss';\n\ntype Props = {\n    sidebarMenu: Array<Menu>,\n    tableColumns: Array,\n    tableData: Array,\n    viewBehaviourDetails: Function\n}\n\nfunction BehavioursScreen({\n    sidebarMenu,\n    tableColumns,\n    tableData,\n    viewBehaviourDetails\n}: Props): React$Element<any> {\n    return (\n        <div className='behaviours'>\n            <CollapsibleSidebar\n                menu={sidebarMenu} />\n            <div className='w-100 overflow-auto'>\n                <Breadcrumbs links={['Home', 'Behaviours']} />\n                <div className='behaviours__content'>\n                    <Card className='px-4 py-2'>\n                        <CardBody>\n                            <Typography color='color-3' className='behaviours__title'>Behaviours</Typography>\n                            <Table className='behaviours__table'\n                                tableColumns={tableColumns}\n                                tableData={tableData}\n                                pagination={true}\n                                viewDetails={viewBehaviourDetails} />\n                        </CardBody>\n                    </Card>\n                </div>\n            </div>\n        </div>\n    );\n}\n\nconst Behaviours: any = withLoading<React$Element<Props>>(BehavioursScreen);\n\nexport default Behaviours;\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CustomDropdown\\CustomDropdown.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Table\\Table.js",["229"],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Breadcrumbs\\Breadcrumbs.js",["230"],"// @flow\nimport React from 'react';\nimport './breadcrumbs.scss';\nimport { Spinner, Breadcrumb, BreadcrumbItem } from 'reactstrap';\n\ntype Props = {\n    links: Array,\n    isLoading: Boolean,\n    className?: string\n}\n\nexport default function Breadcrumbs({\n    links = [],\n    isLoading = false,\n    className = ''\n}: Props): React$Element<any> {\n    return (\n        <div className={`breadcrumbs ${className}`} >\n            <Breadcrumb className='w-100'>\n                {isLoading\n                    ? (\n                        <Spinner size='sm' color='secondary' className='m-2'/>\n                    )\n                    : (\n                        links.map((link, idx) => {\n                            return <BreadcrumbItem key={idx} active={links.length === idx + 1}><a href='#'>{link}</a></BreadcrumbItem>;\n                        })\n                    )}\n            </Breadcrumb>\n        </div>\n    );\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Badge\\Badge.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Pagination\\Pagination.js",[],["231","232","233"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Select\\Select.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\NormalTable\\NormalTable.js",[],["234","235","236"],{"ruleId":"237","replacedBy":"238"},{"ruleId":"239","replacedBy":"240"},{"ruleId":"241","replacedBy":"242"},{"r