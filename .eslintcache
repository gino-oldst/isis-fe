noy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Alerts\\AlertsContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\RestrictedList\\RestrictedListContainer.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\components\\base\\Typography\\Typography.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\notifications.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\components\\base\\Button\\Button.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\makeApiCall.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\RestrictedList\\RestrictedListScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\restrictedList.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\behaviours.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\users.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",["277"],"// @flow\nimport React, { useState, useEffect } from 'react';\nimport moment from 'moment';\nimport { useDispatch, useSelector } from 'react-redux';\nimport Toggle from 'react-toggle';\nimport validator from 'validator';\nimport 'react-toggle/style.css';\nimport Table from '../../components/base/Table/Table';\nimport Button from '../../components/base/Button/Button';\nimport Typography from '../../components/base/Typography/Typography';\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\nimport ReactDatePicker from 'react-datepicker';\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\nimport withLoading from '../../components/modules/withLoading/withLoading';\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\nimport { blockInvalidChar, getDatesBetweenDates } from '../../utils/helpers';\nimport type { Menu } from '../../types';\nimport {\n    Card,\n    CardBody,\n    FormGroup,\n    FormFeedback,\n    Label,\n    Input,\n    Spinner\n} from 'reactstrap';\nimport './behaviour-detail.scss';\n\nimport { setModalContent } from '../../redux/modules/modalEvent';\nimport { updateParameter } from '../../api/parameters';\nimport { updateBehaviour, processBehaviourByDate } from '../../api/behaviours';\nimport { replaceParameterStatus, replaceParametersData, setLoading } from '../../redux/modules/behaviours';\n\ntype Props = {\n    loading: Boolean,\n    breadcrumb: Array,\n    loadBehaviourDetails: Function,\n    sidebarMenu: Array<Menu>,\n    tableColumns: Array,\n    tableData: Array,\n    selectedBehaviour: Object,\n    handleCloseModal: Function\n}\n\nfunction BehaviourDetailScreen({\n    loading,\n    breadcrumb,\n    loadBehaviourDetails,\n    sidebarMenu,\n    tableColumns,\n    tableData,\n    selectedBehaviour,\n    handleCloseModal\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const { profileData: { userId } } = useSelector(({ authentication }) => authentication);\n    const { pageSize, activePage } = useSelector(({ table }) => table);\n    const { selected } = useSelector(({ behaviours }) => behaviours);\n\n    useEffect(() => {\n        dispatch(setLoading());\n        loadBehaviourDetails(activePage, pageSize);\n    }, [pageSize, activePage]);\n\n    const showUpdateParameterModal = rowData => {\n        dispatch(setModalContent({\n            modalContent: <UpdateParameterModal\n                rowData={rowData}\n                handleCloseModal={handleCloseModal} />\n        }));\n    };\n\n    const showRunBehavioursModal = () => {\n        dispatch(setModalContent({\n            modalContent: <RunBehavioursModal\n                handleCloseModal={handleCloseModal} />\n        }));\n    };\n\n    const handleToggleCheck = async (e) => {\n        const result = await updateBehaviour({\n            id: selectedBehaviour.id,\n            code: selectedBehaviour.code,\n            currentUserId: userId,\n            description: selectedBehaviour.behaviour,\n            internalCode: selectedBehaviour.identifier,\n            status: e.target.checked ? 'ACTIVE' : 'IN_ACTIVE'\n        });\n\n        if (result.data.responseStatus === 'success') dispatch(replaceParameterStatus(result.data.status));\n    };\n\n    return (\n        <div className='behaviour-detail'>\n            <CollapsibleSidebar\n                menu={sidebarMenu} />\n            <div className='w-100 overflow-auto'>\n                <Breadcrumbs links={breadcrumb} />\n                <div className='behaviour-detail__content'>\n                    <Card className='px-4 py-2'>\n                        <CardBody>\n                            <div className='behaviour-detail__header d-flex'>\n                                <Typography color='color-3' className='behaviour-detail__title mr-auto'>{selectedBehaviour.behaviour}</Typography>\n                                <div className='d-flex align-items-center mt-2'>\n                                    <div className='d-flex align-items-center justify-content-end'>\n                                        <Button label={<><Typography weight='light' className='my-1 mx-2'>Run Behaviour</Typography></>}\n                                            className='ml-4 mr-4 d-flex align-items-center behaviour-detail__download-button' onClick={showRunBehavioursModal} />\n                                        <Typography color='color-3' className='mr-3' variant='size-18'\n                                            weight='light'>{selectedBehaviour.status}</Typography>\n                                        <Toggle\n                                            icons={false}\n                                            checked={selectedBehaviour.status.toLowerCase() === 'active'}\n                                            onChange={handleToggleCheck} />\n                                    </div>\n                                </div>\n                            </div>\n                            <Typography color='color-3' variant='size-16' className='mb-4'>\n                                {selectedBehaviour.identifier}\n                            </Typography>\n                            {loading || tableData === undefined\n                                ? <Spinner animation='border' role='status' className='d-flex mx-auto my-5 text-center'>\n                                    <span className='sr-only'>Loading...</span>\n                                </Spinner>\n                                : <Table className='behaviours__table'\n                                    tableColumns={tableColumns}\n                                    tableData={tableData}\n                                    tablePagination={selected.totalPages}\n                                    totalNoOfRecords={selected.totalNoOfRecords}\n                                    activePage={activePage}\n                                    pagination={true}\n                                    fetching={selected.loading}\n                                    viewDetails={showUpdateParameterModal} />\n                            }\n                        </CardBody>\n                    </Card>\n                </div>\n            </div>\n        </div>\n    );\n}\n\nconst BehaviourDetail: any = withLoading<React$Element<Props>>(BehaviourDetailScreen);\n\nexport default BehaviourDetail;\n\nconst UpdateParameterModal = ({\n    rowData,\n    handleCloseModal\n}) => {\n    const dispatch = useDispatch();\n    const { profileData: { userId } } = useSelector(({ authentication }) => authentication);\n    const [loading, setLoading] = useState(false);\n    const [params, setParams] = useState({\n        ...rowData,\n        errors: {}\n    });\n\n    console.log(userId);\n\n    const handleUpdate = async () => {\n        setLoading(true);\n\n        if (handleValidation()) {\n            const payload = {\n                id: params.id,\n                currentUserId: userId,\n                ruleId: params.ruleId,\n                behaviourId: params.behaviourId,\n                description: params.description,\n                value: params.value,\n                name: params.name,\n                internalCode: params.internalCode,\n                dateCreated: rowData.dateCreated\n            };\n\n            const result = await updateParameter(payload);\n\n            if (result.data.responseStatus === 'success') {\n                setTimeout(() => {\n                    dispatch(replaceParametersData(payload));\n                    setLoading(false);\n                    handleCloseModal();\n                }, 1000);\n            } else {\n                setLoading(false);\n                setParams({\n                    ...params,\n                    errors: {\n                        ...params.errors,\n                        backendErr: 'Something went wrong. Please try again later.'\n                    }\n                });\n            }\n        }\n    };\n\n    const handleChange = e => {\n        if (params.errors[e.target.name] !== undefined) params.errors[e.target.name] = false; // remove error msg for a specific input\n\n        setParams({\n            ...params,\n            [e.target.name]: e.target.value\n        });\n    };\n\n    const handleValidation = () => {\n        const errors = {};\n        let formIsValid = true;\n\n        if (validator.isEmpty(params.name)) {\n            formIsValid = false;\n            errors.name = true;\n            errors.nameErrMsg = 'Code is required';\n        }\n\n        if (validator.isEmpty(params.description)) {\n            formIsValid = false;\n            errors.description = true;\n            errors.descriptionErrMsg = 'Description is required';\n        }\n\n        if (validator.isEmpty(params.value)) {\n            formIsValid = false;\n            errors.value = true;\n            errors.valueErrMsg = 'Value is required';\n        }\n\n        setParams({\n            ...params,\n            errors\n        });\n\n        return formIsValid;\n    };\n\n    return (\n        <div className='behaviour-detail__edit-parameter p-4'>\n            <FontAwesomeIcon className='color-sidebar-2 cursor-pointer float-right' icon='times' size='lg'\n                onClick={handleCloseModal} />\n            <Typography variant='size-26' color='color-3'\n                className='mb-4 playfair-font'>\n                Update Parameter\n            </Typography>\n            <Typography variant='size-14' className={`my-4 playfair-font text-danger ${params.errors.backendErr !== '' ? 'd-block' : 'd-none'}`}>\n                {params.errors.backendErr}\n            </Typography>\n            <FormGroup className='mb-4'>\n                <Label for='note'><Typography color='color-3' variant='size-16'>Code</Typography></Label>\n                <Input type='text' name='name' bsSize='lg'\n                    defaultValue={rowData.name} onChange={handleChange} invalid={params.errors.name} />\n                <FormFeedback className={`${params.errors.name ? 'd-block' : 'd-none'}`}>\n                    {params.errors.nameErrMsg}\n                </FormFeedback>\n            </FormGroup>\n            <FormGroup className='mb-4'>\n                <Label for='note'><Typography color='color-3' variant='size-16'>Description</Typography></Label>\n                <Input type='text' name='description' bsSize='lg'\n                    defaultValue={rowData.description} onChange={handleChange} invalid={params.errors.description} />\n                <FormFeedback className={`${params.errors.description ? 'd-block' : 'd-none'}`}>\n                    {params.errors.descriptionErrMsg}\n                </FormFeedback>\n            </FormGroup>\n            <FormGroup className='mb-5'>\n                <Label for='note'><Typography color='color-3' variant='size-16'>Value</Typography></Label>\n                <Input type='number' name='value' bsSize='lg'\n                    defaultValue={rowData.value} onChange={handleChange} onKeyDown={blockInvalidChar}\n                    invalid={params.errors.value} />\n                <FormFeedback className={`${params.errors.value ? 'd-block' : 'd-none'}`}>\n                    {params.errors.valueErrMsg}\n                </FormFeedback>\n            </FormGroup>\n            <div className='behaviour-detail__edit-parameter-buttons d-flex justify-content-center'>\n                <Button label='Cancel' variant='light' className='cancel-button px-4 mr-2 py-2'\n                    onClick={handleCloseModal} disabled={loading} />\n                <Button label={!loading ? 'Save' : 'Saving...'} variant='primary' className='save-button px-5 py-2'\n                    onClick={handleUpdate} disabled={loading} />\n            </div>\n        </div>\n    );\n};\n\nconst RunBehavioursModal = ({\n    handleCloseModal\n}) => {\n    const [loading, setLoading] = useState(false);\n    const [fromDate, setFromDate] = useState(new Date());\n    const [toDate, setToDate] = useState(new Date());\n\n    const handleDateChange = async (type, date) => {\n        if (type === 'from') {\n            if (moment(date).isAfter(moment(toDate))) {\n                alert('FROM cannot be greater than TO');\n            } else {\n                setFromDate(date);\n            }\n        } else {\n            if (moment(date).isBefore(moment(fromDate))) {\n                alert('TO cannot be less than FROM');\n            } else {\n                setToDate(date);\n            }\n        }\n    };\n\n    const runBehaviours = async () => {\n        setLoading(true);\n\n        const dates = getDatesBetweenDates(moment(fromDate), moment(toDate));\n\n        dates.forEach(async (date, idx) => {\n            const payload = {\n                importDate: moment(date).format('YYYY-MM-DD'),\n                internalCode: localStorage.getItem('selectedBehaviourCode')\n            };\n\n            const result = await processBehaviourByDate(payload);\n\n            if (result.status === 200) {\n                if ((idx + 1) === dates.length) {\n                    handleCloseModal();\n                }\n            } else {\n                setLoading(false);\n                alert('Something went wrong.');\n            }\n        });\n    };\n\n    return (\n        <div className='behaviour-detail__run-behaviours p-4'>\n            <FontAwesomeIcon className='color-sidebar-2 cursor-pointer float-right' icon='times' size='lg'\n                onClick={handleCloseModal} />\n            <Typography variant='size-26' color='color-3'\n                className='mb-4 playfair-font'>\n                Run Behaviour\n            </Typography>\n            <Typography variant='size-16' color='color-3'\n                className='mt-4 playfair-font'>\n                Select date range\n            </Typography>\n            <div className='mt-3 mb-5 d-flex align-items-center'>\n                <Label for='fromDate'><Typography color='color-3' variant='size-16' className='mr-3 playfair-font'>From</Typography></Label>\n                <ReactDatePicker\n                    id='fromDate'\n                    selected={fromDate}\n                    className='behaviour-detail__date-picker'\n                    dateFormat='dd MMM yyyy'\n                    onChange={e => handleDateChange('from', e)} />\n                <Label for='toDate'><Typography color='color-3' variant='size-16' className='mr-3 playfair-font'>To</Typography></Label>\n                <ReactDatePicker\n                    id='toDate'\n                    selected={toDate}\n                    className='behaviour-detail__date-picker'\n                    dateFormat='dd MMM yyyy'\n                    onChange={e => handleDateChange('to', e)} />\n            </div>\n            <div className='behaviour-detail__run-behaviours-buttons d-flex justify-content-center'>\n                <Button label='Cancel' variant='light' className='cancel-button px-4 mr-2 py-2'\n                    onClick={handleCloseModal} disabled={loading} />\n                <Button label={!loading ? 'OK' : 'Running...'} variant='primary' className='save-button px-5 py-2'\n                    onClick={runBehaviours} disabled={loading} />\n            </div>\n        </div>\n    );\n};\n","C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\parameters.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\alerts.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Alerts\\AlertsScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\dashboard.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\api\\auth.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\containers\\Login\\LoginScreen.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\components\\base\\Badge\\Badge.js",[],"C:\\Users\\Nonoy\\Documents\\Old.St\\measure\\frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"C:\\Users\\Nonoy\\Documents