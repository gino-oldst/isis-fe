],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AppLoading\\AppLoadingContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\modalEvent.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\routes.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\WrapperBackground\\WrapperBackground.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Modal\\Modal.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Navbar\\Navbar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\FlashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",["191","192","193","194"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport { useHistory } from 'react-router-dom';\r\n\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport { faCoffee } from '@fortawesome/free-solid-svg-icons';\r\nimport Login from './LoginScreen';\r\nimport { isValidEmail } from '../../utils/helpers';\r\nimport { authUser } from '../../redux/modules/authentication';\r\nimport { saveAuthorizationToken, checkAuthorization } from '../../utils/Auth';\r\nimport { setFlashNotification } from '../../redux/modules/flashNotification';\r\n\r\ntype Props = {\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function LoginContainer({\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const history = useHistory();\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [errMsg, setErrMsg] = useState('');\r\n    const [loginForm, setLoginForm] = useState({\r\n        email: '',\r\n        password: ''\r\n    });\r\n\r\n    // check if user is logged in\r\n    // useEffect(() => {\r\n    //     checkAuth();\r\n    // }, []);\r\n\r\n    // const checkAuth = async () => {\r\n    //     const auth = await checkAuthorization();\r\n\r\n    //     if (auth) history.push('/dashboard');\r\n    // };\r\n\r\n    const onSubmit = async e => {\r\n        setIsLoading(true);\r\n        setErrMsg('');\r\n        e.preventDefault();\r\n\r\n        try {\r\n            if (isValidEmail(loginForm.email) && loginForm.password) {\r\n                // const response = await userLogin(loginForm);\r\n\r\n                // if (Object.keys(response).length === 0) {\r\n                //     setErrMsg('Invalid email!');\r\n                // } else if (response.data.message) {\r\n                //     setErrMsg(response.data.message);\r\n                // } else {\r\n                //     const { data } = response;\r\n\r\n                //     localStorage.setItem('userId', data.userId);\r\n                //     saveAuthorizationToken(data.token);\r\n                //     dispatch(authUser({\r\n                //         email: loginForm.email\r\n                //     }));\r\n\r\n                //     history.replace('/dashboard');\r\n                // }\r\n\r\n                localStorage.setItem('userId', 1);\r\n                saveAuthorizationToken('temp_token');\r\n                dispatch(authUser({\r\n                    email: loginForm.email\r\n                }));\r\n\r\n                history.replace('/dashboard');\r\n            }\r\n        } catch (err) {\r\n            dispatch(setFlashNotification({\r\n                message: 'ERROR',\r\n                isError: true\r\n            }));\r\n        }\r\n    };\r\n\r\n    const onChange = e => {\r\n        const { name, value } = e.target;\r\n\r\n        setLoginForm({\r\n            ...loginForm,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    return <Login\r\n        onSubmit={onSubmit}\r\n        onChange={onChange}\r\n        isLoading={isLoading}\r\n        errMsg={errMsg}\r\n        setErrMsg={setErrMsg}\r\n        handleCloseModal={handleCloseModal} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",["195","196","197"],"// @flow\nimport React from 'react';\nimport Table from '../../components/base/Table/Table';\nimport Button from '../../components/base/Button/Button';\nimport DatePicker from '../../components/base/DatePicker/DatePicker';\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\nimport Typography from '../../components/base/Typography/Typography';\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\nimport withLoading from '../../components/modules/withLoading/withLoading';\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\nimport type { Menu } from '../../types';\nimport {\n    Card,\n    CardBody\n} from 'reactstrap';\nimport './behaviours.scss';\n\ntype Props = {\n    sidebarMenu: Array<Menu>,\n    tableColumns: Array,\n    tableData: Array\n}\n\nfunction BehavioursScreen({\n    sidebarMenu,\n    tableColumns,\n    tableData\n}: Props): React$Element<any> {\n    return (\n        <div className='behaviours'>\n            <CollapsibleSidebar\n                menu={sidebarMenu} />\n            <div className='w-100 overflow-auto'>\n                <Breadcrumbs links={['Home', 'Behaviours']} />\n                <div className='behaviours__content'>\n                    <Card className='px-4 py-2'>\n                        <CardBody>\n                            <Typography color='color-3' className='behaviours__title'>Behaviours</Typography>\n                            <Table className='behaviours__table'\n                                tableColumns={tableColumns}\n                                tableData={tableData} />\n                        </CardBody>\n                    </Card>\n                </div>\n            </div>\n        </div>\n    );\n}\n\nconst Behaviours: any = withLoading<React$Element<Props>>(BehavioursScreen);\n\nexport default Behaviours;\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CustomDropdown\\CustomDropdown.js",[],["198","199","200"],"D:\\Old.St Labs\\project-measure-frontend\\src\\com