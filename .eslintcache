  header: 'Alert Type',\r\n                    accessor: 'alertType',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Date',\r\n                    accessor: 'date',\r\n                    disableFilters: true,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Broker',\r\n                    accessor: 'broker',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Ticker',\r\n                    accessor: 'ticker',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Book',\r\n                    accessor: 'book',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Quantity',\r\n                    accessor: 'quantity',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Client',\r\n                    accessor: 'client',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Escalation',\r\n                    accessor: 'escalation',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Assigned',\r\n                    accessor: 'assigned',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                },\r\n                {\r\n                    header: 'Status',\r\n                    accessor: 'status',\r\n                    disableFilters: false,\r\n                    clickable: false\r\n                }\r\n            ],\r\n            data: [\r\n                {\r\n                    id: 1,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 12,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 2,\r\n                    identifier: 'MUA313',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 2',\r\n                    quantity: 11,\r\n                    client: 'Client 1',\r\n                    escalation: 'CO',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'In Review',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 3,\r\n                    identifier: 'MUA314',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 2',\r\n                    quantity: 1500000,\r\n                    client: 'Client 1',\r\n                    escalation: 'CO',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 4,\r\n                    identifier: 'MUA315',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 2',\r\n                    quantity: 93,\r\n                    client: 'Client 1',\r\n                    escalation: 'Manager',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'In Review',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 5,\r\n                    identifier: 'MUA316',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Jeff Smith',\r\n                    ticker: 'OCDO',\r\n                    book: 'Book 3',\r\n                    quantity: 458000,\r\n                    client: 'Client 1',\r\n                    escalation: 'Manager',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 6,\r\n                    identifier: 'MUA317',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Paul Herbert',\r\n                    ticker: 'BP',\r\n                    book: 'Book 4',\r\n                    quantity: 223560,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Archived',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 7,\r\n                    identifier: 'MUA318',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'OCDO',\r\n                    book: 'Book 4',\r\n                    quantity: 21,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Gergana Tsoneva',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 8,\r\n                    identifier: 'MUA319',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'SDR',\r\n                    book: 'Book 5',\r\n                    quantity: 789233,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Gergana Tsoneva',\r\n                    status: 'Archived',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 9,\r\n                    identifier: 'MUA320',\r\n                    alertType: 'Marking the Close',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BNZL',\r\n                    book: 'Book 6',\r\n                    quantity: 1044,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Darren Hibbitt',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 10,\r\n                    identifier: 'MUA321',\r\n                    alertType: 'High Volume',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 7',\r\n                    quantity: 985000,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Darren Hibbitt',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 11,\r\n                    identifier: 'MUA322',\r\n                    alertType: 'Flash Execution',\r\n                    date: new Date(),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BNZL',\r\n                    book: 'Book 7',\r\n                    quantity: 122,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Darren Hibbitt',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 12,\r\n                    identifier: 'MUA323',\r\n                    alertType: 'Flash Order',\r\n                    date: new Date(2021, 3, 20, 10, 33, 30, 0),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'WPP',\r\n                    book: 'Book 8',\r\n                    quantity: 102,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Resolved',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 13,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 1000502,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 14,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(new Date(2021, 4, 7).getTime() + Math.random() * (new Date().getTime() - new Date(2021, 1, 7).getTime())),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 12,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                },\r\n                {\r\n                    id: 15,\r\n                    identifier: 'MUA312',\r\n                    alertType: 'Insider Trading',\r\n                    date: new Date(2021, 3, 18, 18, 33, 30, 0),\r\n                    broker: 'Peter Davidson',\r\n                    ticker: 'BP',\r\n                    book: 'Book 1',\r\n                    quantity: 12,\r\n                    client: 'Client 1',\r\n                    escalation: 'Base',\r\n                    assigned: 'Mark Thomson',\r\n                    status: 'Open',\r\n                    detail: '/alert/MUA312'\r\n                }\r\n            ]\r\n        },\r\n        selected: {\r\n            data: {},\r\n            activity: []\r\n        }\r\n    }); // table dummy data\r\n\r\n    const viewAlertDetails = async (path, data) => {\r\n        await dispatch(setSelectedAlert(data)); // redux version\r\n\r\n        // setData({\r\n        //     ...data,\r\n        //     selected: {\r\n        //         ...data.selected,\r\n        //         data\r\n        //     }\r\n        // });\r\n\r\n        history.push(path);\r\n    };\r\n\r\n    return <AlertsScreen\r\n        breadcrumb={breadcrumb}\r\n        tableColumns={data.table.columns}\r\n        tableData={data.table.data}\r\n        isRowsSelected={isRowsSelected}\r\n        viewAlertDetails={viewAlertDetails}\r\n        handleCloseModal={handleCloseModal}\r\n        sidebarMenu={sidebarMenu} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\AlertsScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursContainer.js",["227"],"// @flow\nimport React, { useState } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport { useHistory } from 'react-router-dom';\nimport BehavioursScreen from './BehavioursScreen';\nimport type { Menu } from '../../types';\nimport { setSelectedBehaviour } from '../../redux/modules/behaviours';\n\ntype Props = {\n    sidebarMenu: Array<Menu>\n}\n\nexport default function BehavioursContainer({\n    sidebarMenu\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const history = useHistory();\n    const { table } = useSelector(({ behaviours }) => behaviours);\n    const breadcrumb = [\n        {\n            label: 'Home',\n            path: '/dashboard'\n        },\n        {\n            label: 'Behaviours',\n            path: '/behaviours'\n        }\n    ];\n\n    const viewBehaviourDetails = async (path, identifier, behaviour) => {\n        await dispatch(setSelectedBehaviour(identifier, behaviour));\n\n        history.push(path);\n    };\n\n    return <BehavioursScreen\n        breadcrumb={breadcrumb}\n        tableColumns={table.columns}\n        tableData={table.data}\n        viewBehaviourDetails={viewBehaviourDetails}\n        sidebarMenu={sidebarMenu} />;\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Behaviours\\BehavioursScreen.js",["228","229","230"],"// @flow\nimport React from 'react';\nimport moment from 'moment';\nimport Badge from '../../components/base/Badge/Badge';\nimport Table from '../../components/base/Table/Table';\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\nimport Typography from '../../components/base/Typography/Typography';\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\nimport withLoading from '../../components/modules/withLoading/withLoading';\nimport { getTextColor } from '../../utils/helpers';\nimport type { Menu } from '../../types';\nimport {\n    Card,\n    CardBody\n} from 'reactstrap';\nimport './behaviours.scss';\n\ntype Props = {\n    breadcrumb: Array,\n    sidebarMenu: Array<Menu>,\n    tableColumns: Array,\n    tableData: Array,\n    viewBehaviourDetails: Function\n}\n\nfunction BehavioursScreen({\n    breadcrumb,\n    sidebarMenu,\n    tableColumns,\n    tableData,\n    viewBehaviourDetails\n}: Props): React$Element<any> {\n    return (\n        <div className='behaviours'>\n            <CollapsibleSidebar\n                menu={sidebarMenu} />\n            <div className='w-100 overflow-auto'>\n                <Breadcrumbs links={breadcrumb} />\n                <div className='behaviours__content'>\n                    <Card className='px-4 py-2'>\n                        <CardBody>\n                            <Typography color='color-3' className='behaviours__title'>Behaviours</Typography>\n                            <Table className='behaviours__table'\n                                tableColumns={tableColumns}\n                                tableData={tableData}\n                                pagination={true}\n                                viewDetails={viewBehaviourDetails} />\n                        </CardBody>\n                    </Card>\n                </div>\n            </div>\n        </div>\n    );\n}\n\nconst Behaviours: any = withLoading<React$Element<Props>>(BehavioursScreen);\n\nexport default Behaviours;\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CustomDropdown\\CustomDropdown.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Table\\Table.js",["231"],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Breadcrumbs\\Breadcrumbs.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Badge\\Badge.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Pagination\\Pagination.js",[],["232","233","234"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],