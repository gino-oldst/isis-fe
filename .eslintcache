nimport { matchSorter } from 'match-sorter';\r\nimport Button from '../../base/Button/Button';\r\nimport Badge from '../../base/Badge/Badge';\r\nimport Typography from '../../base/Typography/Typography';\r\nimport DatePicker from 'react-datepicker';\r\nimport 'react-datepicker/dist/react-datepicker.css';\r\nimport CustomDropdown from '../../base/CustomDropdown/CustomDropdown';\r\nimport { kFormatter, getTextColor } from '../../../utils/helpers';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport {\r\n    Table as ReactstrapTable,\r\n    DropdownItem,\r\n    FormGroup,\r\n    Input,\r\n    Label\r\n} from 'reactstrap';\r\nimport filterIcon from '../../../assets/images/ic_filter.svg';\r\nimport './table.scss';\r\n\r\nimport { useTable, useRowSelect, useFilters, useGlobalFilter, usePagination, useSortBy, useAsyncDebounce } from 'react-table';\r\nimport { setIsRowSelected, setAppliedFilters } from '../../../redux/modules/table';\r\n\r\n// Define a default UI for filtering\r\nfunction GlobalFilter({\r\n    preGlobalFilteredRows,\r\n    globalFilter,\r\n    setGlobalFilter\r\n}) {\r\n    const count = preGlobalFilteredRows.length;\r\n    const [value, setValue] = React.useState(globalFilter);\r\n    const onChange = useAsyncDebounce(value => {\r\n        setGlobalFilter(value || undefined);\r\n    }, 200);\r\n\r\n    return (\r\n        <span>\r\n            Search:{' '}\r\n            <input\r\n                value={value || ''}\r\n                onChange={e => {\r\n                    setValue(e.target.value);\r\n                    onChange(e.target.value);\r\n                }}\r\n                placeholder={`${count} records...`}\r\n                style={{\r\n                    fontSize: '1.1rem',\r\n                    border: '0'\r\n                }}/>\r\n        </span>\r\n    );\r\n}\r\n\r\n// Define a default UI for filtering\r\nfunction DefaultColumnFilter({\r\n    column: { filterValue, preFilteredRows, setFilter }\r\n}) {\r\n    const count = preFilteredRows.length;\r\n\r\n    return (\r\n        <input\r\n            value={filterValue || ''}\r\n            onChange={e => {\r\n                setFilter(e.target.value || undefined); // Set undefined to remove the filter entirely\r\n            }}\r\n            placeholder={`Search ${count} records...`}/>\r\n    );\r\n}\r\n\r\nfunction fuzzyTextFilterFn(rows, id, filterValue) {\r\n    return matchSorter(rows, filterValue, { keys: [row => row.values[id]] });\r\n}\r\n\r\n// Let the table remove the filter if the string is empty\r\nfuzzyTextFilterFn.autoRemove = val => !val;\r\n\r\n// This is a custom filter UI for selecting\r\n// a unique option from a list\r\nfunction SelectColumnFilter({\r\n    column: { Header, filterValue, setFilter, preFilteredRows, id }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [selectFilter, setSelectFilter] = useState([]);\r\n    const [searchFilter, setSearchFilter] = useState('');\r\n    const options = useMemo(() => {\r\n        const options = new Set();\r\n\r\n        preFilteredRows.forEach(row => {\r\n            options.add(row.values[id]);\r\n        });\r\n\r\n        return [...options.values()];\r\n    }, [id, preFilteredRows]);\r\n\r\n    useEffect(() => {\r\n        setFilter(selectFilter);\r\n    }, [selectFilter]);\r\n\r\n    const handleFilterChange = (e, value) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        isChecked\r\n            ? setSelectFilter([\r\n                ...selectFilter,\r\n                value\r\n            ])\r\n            : setSelectFilter([...selectFilter.filter(val => val !== value)]);\r\n    };\r\n\r\n    const handleSearch = value => {\r\n        setSearchFilter(value);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter([]);\r\n        setSelectFilter([]);\r\n        setSearchFilter('');\r\n    };\r\n\r\n    // filtered column options\r\n    const choices = options.filter(opt => opt.toString().toLowerCase().includes(searchFilter.toLowerCase()));\r\n\r\n    // Render a multi-select box\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <DropdownItem header={true}>\r\n                <Input type='text' name='search' placeholder='Search...'\r\n                    bsSize='md' value={searchFilter} onChange={e => handleSearch(e.target.value)} />\r\n            </DropdownItem>\r\n            <div className='table__filter-options overflow-auto'>\r\n                {choices.map((option, i) => (\r\n                    <FormGroup key={i} check={true}>\r\n                        <Label check={true}>\r\n                            <Input type='checkbox' checked={selectFilter.includes(option.toString())} onChange={e => handleFilterChange(e, option.toString())}/>\r\n                            {option.toString()}\r\n                        </Label>\r\n                    </FormGroup>\r\n                ))}\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\n// This is a custom filter UI for selecting\r\n// a unique option from a list\r\nfunction RadioColumnFilter({\r\n    column: { setFilter }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [radioFilter, setRadioFilter] = useState(0);\r\n\r\n    useEffect(() => {\r\n        setFilter(radioFilter);\r\n    }, [radioFilter]);\r\n\r\n    const handleRadioFilterChange = (e, value) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        isChecked\r\n            ? setRadioFilter(value)\r\n            : setRadioFilter(0);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter(undefined);\r\n        setRadioFilter(0);\r\n    };\r\n\r\n    // Render a multi-select box\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <div className='table__quantity-filter-options'>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio1'\r\n                            checked={radioFilter === 1} onChange={e => handleRadioFilterChange(e, 1)} />{' '}\r\n                        Below 100K\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio2'\r\n                            checked={radioFilter === 2} onChange={e => handleRadioFilterChange(e, 2)} />{' '}\r\n                        100K - 500K\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio3'\r\n                            checked={radioFilter === 3} onChange={e => handleRadioFilterChange(e, 3)} />{' '}\r\n                        501K - 1M\r\n                    </Label>\r\n                </FormGroup>\r\n                <FormGroup check={true}>\r\n                    <Label check={true}>\r\n                        <Input type='radio' name='radio4'\r\n                            checked={radioFilter === 4} onChange={e => handleRadioFilterChange(e, 4)} />{' '}\r\n                        Above 1M\r\n                    </Label>\r\n                </FormGroup>\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\nfunction DateColumnFilter({\r\n    column: { setFilter }\r\n}) {\r\n    // Calculate the options for filtering\r\n    // using the preFilteredRows\r\n    const [dateFilter, setDateFilter] = useState(0);\r\n    const [defaultDate, setDefaultDate] = useState(new Date());\r\n    const [selectedDate, setDateChange] = useState(3);\r\n    const datepickerOpen = React.createRef();\r\n\r\n    useEffect(() => {\r\n        setFilter(dateFilter);\r\n    }, [dateFilter]);\r\n\r\n    useEffect(() => {\r\n        setFilter(selectedDate);\r\n    }, [selectedDate]);\r\n\r\n    const handleDateFilterChange = (isChecked, value) => {\r\n        isChecked\r\n            ? setDateFilter(value)\r\n            : setDateFilter(0);\r\n    };\r\n\r\n    const handleResetFilter = () => {\r\n        setFilter(undefined);\r\n        setDateFilter(3);\r\n        setDateChange(3);\r\n        setDefaultDate(new Date());\r\n    };\r\n\r\n    const handleDateChange = value => {\r\n        setDateChange(value);\r\n        setDefaultDate(value);\r\n        setDateFilter(3);\r\n    };\r\n\r\n    return (\r\n        <CustomDropdown tag='span'\r\n            toggle={<img className='table__filter-icon cursor-pointer' src={filterIcon} alt='talbe-filter-icon' />}>\r\n            <DropdownItem header={true} className='text-center'>\r\n                <img src={filterIcon} alt='talbe-filter-icon' />\r\n            </DropdownItem>\r\n            <DropdownItem divider={true} />\r\n            <div className='table__date-filter-options'>\r\n                <FormGroup tag='fieldset'>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 1} onChange={e => handleDateFilterChange(e.target.checked, 1)}/>{' '}\r\n                        Today\r\n                        </Label>\r\n                    </FormGroup>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 2} onChange={e => handleDateFilterChange(e.target.checked, 2)} />{' '}\r\n                        Last 7 Days\r\n                        </Label>\r\n                    </FormGroup>\r\n                    <FormGroup check={true} className='mb-1'>\r\n                        <Label check={true}>\r\n                            <Input type='radio' name='radio'\r\n                                checked={dateFilter === 3} onChange={e => {\r\n                                    handleDateFilterChange(e.target.checked, 3);\r\n                                }} onClick={() => datepickerOpen.current.setOpen(true)} />{' '}\r\n                            <span className='mr-2'>Specific Date</span>\r\n                        </Label>\r\n                        <FontAwesomeIcon icon='calendar-alt' size='md' className='date-picker__icon' />\r\n                        <DatePicker ref={datepickerOpen} selected={defaultDate}\r\n                            className='table__date-picker'\r\n                            dateFormat='dd MMM yyyy'\r\n                            onChange={date => {\r\n                                handleDateChange(date);\r\n                            }} />\r\n                    </FormGroup>\r\n                </FormGroup>\r\n            </div>\r\n            <DropdownItem divider={true} />\r\n            <Button label={<><Typography weight='light' variant='size-14'>Reset</Typography></>}\r\n                className='table__filter-reset-button float-right mr-2' onClick={() => handleResetFilter()}/>\r\n        </CustomDropdown>\r\n    );\r\n}\r\n\r\n// For row selection\r\nconst IndeterminateCheckbox = React.forwardRef(\r\n    ({ indeterminate, ...rest }, ref) => {\r\n        const defaultRef = React.useRef();\r\n        const resolvedRef = ref || defaultRef;\r\n\r\n        React.useEffect(() => {\r\n            resolvedRef.current.indeterminate = indeterminate;\r\n        }, [resolvedRef, indeterminate]);\r\n\r\n        return (\r\n            <>\r\n                <input type='checkbox' ref={resolvedRef} {...rest} />\r\n            </>\r\n        );\r\n    }\r\n);\r\n\r\n// Our table component\r\nfunction Table({\r\n    columns,\r\n    data,\r\n    selectableRows,\r\n    globalFilter,\r\n    pagination,\r\n    sortable\r\n}) {\r\n    const filterTypes = useMemo(\r\n        () => ({\r\n            fuzzyText: fuzzyTextFilterFn,\r\n            // Or, override the default text filter to use\r\n            // \"startWith\"\r\n            text: (rows, id, filterValue) => {\r\n                return rows.filter(row => {\r\n                    const rowValue = row.values[id];\r\n\r\n                    return rowValue !== undefined\r\n                        ? String(rowValue)\r\n                            .toLowerCase()\r\n                            .startsWith(String(filterValue).toLowerCase())\r\n                        : true;\r\n                });\r\n            }\r\n        }),\r\n        []\r\n    );\r\n\r\n    const defaultColumn = useMemo(\r\n        () => ({\r\n            // Let's set up our default Filter UI\r\n            Filter: DefaultColumnFilter\r\n        }),\r\n        []\r\n    );\r\n\r\n    const {\r\n        getTableProps,\r\n        getTableBodyProps,\r\n        headerGroups,\r\n        rows,\r\n        prepareRow,\r\n        state,\r\n        visibleColumns,\r\n        preGlobalFilteredRows,\r\n        setGlobalFilter,\r\n        page,\r\n        gotoPage,\r\n        previousPage,\r\n        nextPage,\r\n        canPreviousPage,\r\n        canNextPage\r\n    } = useTable(\r\n        {\r\n            columns,\r\n            data,\r\n            defaultColumn,\r\n            filterTypes\r\n        },\r\n        useFilters,\r\n        useGlobalFilter,\r\n        useSortBy,\r\n        usePagination,\r\n        useRowSelect,\r\n        hooks => { // push column for the checkbox\r\n            selectableRows && hooks.visibleColumns.push(columns => [\r\n                {\r\n                    id: 'selection',\r\n                    Header: ({ getToggleAllRowsSelectedProps }) => (\r\n                        <div>\r\n                            <IndeterminateCheckbox {...getToggleAllRowsSelectedProps()} />\r\n                        </div>\r\n                    ),\r\n                    Cell: ({ row }) => (\r\n                        <div>\r\n                            <IndeterminateCheckbox {...row.getToggleRowSelectedProps()} />\r\n                        </div>\r\n                    )\r\n                },\r\n                ...columns\r\n            ]);\r\n        }\r\n    );\r\n\r\n    useEffect(() => {\r\n        dispatch(setAppliedFilters(state.filters));\r\n    }, [state.filters]);\r\n\r\n    const dispatch = useDispatch();\r\n    const maxPage = 3; // max page for pagination button\r\n    const paginationLoopLength = (rows.length % state.pageSize) > 0 ? parseInt(rows.length / state.pageSize + 1) : rows.length / state.pageSize;\r\n    // collect all applied filters from table\r\n\r\n    const selectedRows = page.filter(row => row.isSelected === true).length;\r\n\r\n    useEffect(() => {\r\n        dispatch(setIsRowSelected(selectedRows > 0));\r\n    }, [selectedRows]);\r\n\r\n    return (\r\n        <>\r\n            <ReactstrapTable responsive={true} {...getTableProps()}>\r\n                <thead>\r\n                    {globalFilter &&\r\n                        <tr>\r\n                            <th\r\n                                colSpan={visibleColumns.length}\r\n                                style={{\r\n                                    textAlign: 'left'\r\n                                }}>\r\n                                <GlobalFilter\r\n                                    preGlobalFilteredRows={preGlobalFilteredRows}\r\n                                    globalFilter={state.globalFilter}\r\n                                    setGlobalFilter={setGlobalFilter}/>\r\n                            </th>\r\n                        </tr>\r\n                    }\r\n                    {headerGroups.map(headerGroup => (\r\n                        <tr {...headerGroup.getHeaderGroupProps()}>\r\n                            {headerGroup.headers.map(column => (\r\n                                <th {...column.getHeaderProps()}>\r\n                                    {/* Render the columns filter UI */}\r\n                                    <span {...column.getHeaderProps(sortable && column.getSortByToggleProps())}>\r\n                                        {column.render('Header')}\r\n                                        {sortable &&\r\n                                            column.isSorted\r\n                                            ? column.isSortedDesc\r\n                                                ? ' 🔽'\r\n                                                : ' 🔼'\r\n                                            : ''\r\n                                        }\r\n                                    </span>\r\n                                    {column.canFilter ? column.render('Filter') : null}\r\n                                </th>\r\n                            ))}\r\n                        </tr>\r\n                    ))}\r\n                </thead>\r\n                <tbody {...getTableBodyProps()}>\r\n                    {page.length > 0\r\n                        ? (\r\n                            page.map((row, i) => {\r\n                                prepareRow(row);\r\n\r\n                                return (\r\n                                    <tr {...row.getRowProps()} className={`${row.isSelected ? 'selected-row' : ''}`}>\r\n                                        {row.cells.map(cell => {\r\n                                            return <td {...cell.getCellProps()}>{cell.render('Cell')}</td>;\r\n                                        })}\r\n                                    </tr>\r\n                                );\r\n                            })\r\n                        )\r\n                        : (\r\n                            <tr>\r\n                                <th className='text-muted'>\r\n                                    No data available\r\n                                </th>\r\n                            </tr>\r\n                        )}\r\n                </tbody>\r\n            </ReactstrapTable>\r\n            {pagination &&\r\n                <div className='pagination'>\r\n                    <span className={`cursor-pointer ${!canPreviousPage ? 'text-muted' : ''}`} onClick={() => previousPage()}>Prev</span>\r\n                    {Array.from(Array(paginationLoopLength), (_, i) => {\r\n                        const dynamicPageIndex = state.pageIndex > maxPage ? state.pageIndex - 2 + i : i + 1;\r\n\r\n                        return i <= maxPage && <span className={`cursor-pointer ${state.pageIndex + 1 === dynamicPageIndex ? 'active' : ''}`} onClick={() => gotoPage(dynamicPageIndex - 1)}>{dynamicPageIndex}</span>;\r\n                    })}\r\n                    <span className={`cursor-pointer ${!canNextPage ? 'text-muted' : ''}`} onClick={() => nextPage()}>Next</span>\r\n                </div>\r\n            }\r\n        </>\r\n    );\r\n}\r\n\r\n/* Custom filter function */\r\nfunction multiSelectFilter(rows, columnIds, filterValue) {\r\n    // Filters only if filters are selected\r\n    return filterValue.length === 0 ? rows : rows.filter((row) => filterValue.includes(String(row.original[columnIds])));\r\n}\r\n\r\n// Quantity custom filter function!\r\nfunction filterGreaterThan(rows, id, filterValue) {\r\n    const result = rows.filter(row => {\r\n        const rowValue = row.values[id];\r\n\r\n        switch (filterValue) {\r\n            case 1:\r\n                return rowValue <= 100000;\r\n            case 2:\r\n                return rowValue > 100000 && rowValue <= 500000;\r\n            case 3:\r\n                return rowValue > 500001 && rowValue <= 1000000;\r\n            case 4:\r\n                return rowValue > 1000000;\r\n            default:\r\n                return rowValue;\r\n        }\r\n    });\r\n\r\n    return result;\r\n}\r\n\r\ntype Props = {\r\n    children?: string | React.Node,\r\n    className?: string,\r\n    tableData: Array,\r\n    tableColumns: Array,\r\n    selectableRows: Boolean,\r\n    globalFilter: Boolean,\r\n    viewDetails: Function,\r\n}\r\n\r\nexport default function ReactTable({\r\n    children,\r\n    className = '',\r\n    tableData,\r\n    tableColumns,\r\n    selectableRows = false,\r\n    globalFilter = false,\r\n    pagination = false,\r\n    sortable = false,\r\n    viewDetails\r\n}: Props): React$Element<any> {\r\n    const columns = useMemo(\r\n        () => tableColumns.map(column => {\r\n            const rootPath = window.location.pathname.split('/')[1];\r\n\r\n            return {\r\n                Header: column.header,\r\n                accessor: column.accessor,\r\n                disableFilters: column.disableFilters,\r\n                Filter: column.accessor !== 'quantity' ? SelectColumnFilter : RadioColumnFilter,\r\n                filter: column.accessor !== 'quantity' ? multiSelectFilter : filterGreaterThan,\r\n                Cell: e => column.accessor === 'dateCreated'\r\n                    ? <span>{moment(e.value).format('DD/MM/YY')}</span>\r\n                    : <span className={`${column.clickable\r\n                        ? 'color-link-text cursor-pointer'\r\n                        : ''}`} onClick={() => rootPath === 'alerts' && column.accessor === 'behaviourCode'\r\n                        ? viewDetails(e.cell.row.original)\r\n                        : rootPath === 'behaviours' && column.accessor === 'internalCode'\r\n                            ? viewDetails(e.cell.row)\r\n                            : column.accessor === 'name'\r\n                                ? viewDetails(e.cell.row.original)\r\n                                : null}>{column.accessor === 'quantity'\r\n                            ? kFormatter(e.value)\r\n                            : column.accessor === 'escalation'\r\n                                ? <span className='font-weight-bold'>{getTextColor(e.value)}</span>\r\n                                : column.accessor === 'status'\r\n                                    ? <Badge status={e.value} />\r\n                                    : e.value}</span>,\r\n                sortType: column.accessor === 'date'\r\n                    ? (a, b, c, d) => {\r\n                        a = new Date(a.values.date).getTime();\r\n                        b = new Date(b.values.date).getTime();\r\n\r\n                        return b > a ? -1 : 1;\r\n                    }\r\n                    : 'alphanumeric'\r\n            };\r\n        }),\r\n        []\r\n    );\r\n\r\n    return (\r\n        <div className={`w-100 ${className}`}>\r\n            <Table columns={columns} data={tableData}\r\n                selectableRows={selectableRows}\r\n                globalFilter={globalFilter}\r\n                pagination={pagination}\r\n                sortable={sortable} />\r\n        </div>\r\n    );\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Breadcrumbs\\Breadcrumbs.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Badge\\Badge.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Pagination\\Pagination.js",[],["261","262","263"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",["264"],"// @flow\nimport React, { useState } from 'react';\nimport { useDispatch } from 'react-redux';\nimport moment from 'moment';\nimport validator from 'validator';\nimport Badge from '../../components/base/Badge/Badge';\nimport Button from '../../components/base/Button/Button';\nimport Select from '../../components/base/Select/Select';\nimport Typography from '../../components/base/Typography/Typography';\nimport Breadcrumbs from '../../components/base/Breadcrumbs/Breadcrumbs';\nimport CollapsibleSidebar from '../../components/base/CollapsibleSidebar/CollapsibleSidebarContainer';\nimport withLoading from '../../components/modules/withLoading/withLoading';\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\nimport type { Menu } from '../../types';\nimport {\n    Row,\n    Col,\n    Card,\n    CardBody,\n    FormGroup,\n    FormText,\n    FormFeedback,\n    Alert,\n    Input,\n    Label,\n    Spinner\n} from 'reactstrap';\nimport './alert-detail.scss';\n\nimport { updateAlert } from '../../api/alerts';\nimport { setModalContent } from '../../redux/modules/modalEvent';\nimport { replaceAlertDetails } from '../../redux/modules/alerts';\n\ntype Props = {\n    loading: Boolean,\n    breadcrumb: Array,\n    sidebarMenu: Array<Menu>,\n    handleCloseModal: Function,\n    selectedAlert: Object,\n    assignees: Array\n}\n\nfunction AlertDetailScreen({\n    loading,\n    breadcrumb,\n    sidebarMenu,\n    handleCloseModal,\n    selectedAlert,\n    assignees\n}: Props): React$Element<any> {\n    const dispatch = useDispatch();\n    const [submit, setSubmit] = useState(false);\n    const [alert, setAlert] = useState({\n        notes: '',\n        status: '',\n        assignedUser: '',\n        escalation: '',\n        errors: {}\n    });\n\n    const showError = errMsg => {\n        dispatch(setModalContent({\n            modalContent: <ErrorMsgModal\n                errMsg={errMsg}\n                handleCloseModal={handleCloseModal} />\n        }));\n    };\n\n    const handleUpdateAlert = async () => {\n        setSubmit(true);\n        const userId = localStorage.getItem('userId');\n\n        const payload = {\n            id: selectedAlert.id,\n            ruleId: selectedAlert.ruleId,\n            currentUserId: userId,\n            behaviourId: selectedAlert.behaviourId,\n            behaviourCode: selectedAlert.behaviourCode,\n            broker: selectedAlert.broker,\n            book: selectedAlert.book,\n            ticker: selectedAlert.ticker,\n            quantity: selectedAlert.quantity,\n            client: selectedAlert.client,\n            orderType: selectedAlert.orderType,\n            details: selectedAlert.details,\n            behaviourDescription: selectedAlert.behaviourDescription,\n            assignedUserId: alert.assignedUser === '' ? null : alert.assignedUser,\n            escalation: alert.escalation === '' ? selectedAlert.escalation : alert.escalation,\n            status: alert.status === '' ? selectedAlert.status : alert.status,\n            notes: alert.notes === '' ? selectedAlert.notes : alert.notes\n        };\n\n        const result = await updateAlert(payload);\n\n        if (result.data.responseStatus === 'success') {\n            setTimeout(() => {\n                dispatch(replaceAlertDetails(result.data));\n                setSubmit(false);\n            }, 1000);\n        } else {\n            showError(result.data.exceptionMessage);\n            setSubmit(false);\n        }\n    };\n\n    const handleChange = (e, option) => {\n        let name, value;\n\n        if (option === undefined) {\n            name = e.target.name;\n            value = e.target.value;\n        } else {\n            name = option.name;\n            value = option.name === 'assignedUser' ? e.id : e.name;\n        }\n\n        if (alert.errors[name] !== undefined) alert.errors[name] = false; // remove error msg for a specific input\n\n        setAlert({\n            ...alert,\n            [name]: value\n        });\n    };\n\n    const handleValidation = () => {\n        const errors = {};\n        let formIsValid = true;\n\n        if (validator.isEmpty(alert.notes) && validator.isEmpty(selectedAlert.notes)) {\n            formIsValid = false;\n            errors.notes = true;\n            errors.notesErrMsg = 'Notes is required';\n        }\n\n        setAlert({\n            ...alert,\n            errors\n        });\n\n        return formIsValid;\n    };\n\n    return (\n        <div className='alert-detail'>\n            <CollapsibleSidebar\n                menu={sidebarMenu} />\n            <div className='w-100 overflow-auto'>\n                <Breadcrumbs links={breadcrumb} />\n                <div className='alert-detail__content'>\n                    <Card className='px-4 py-2'>\n                        <CardBody>\n                            <div className='alert-detail__header d-flex align-items-start'>\n                                <Typography color='color-3' className='alert-detail__title mr-auto'>{selectedAlert.behaviourCode}</Typography>\n                                <Button label={<>\n                                    <FontAwesomeIcon className='mr-3' icon='file-download' size='sm' />\n                                    <Typography weight='light' className='my-1 mx-2'>Download</Typography>\n                                </>}\n                                className='ml-4 d-flex align-items-center alert-detail__download-button px-4'\n                                size='lg' />\n                            </div>\n                            <Row className='mt-4'>\n                                <Col sm={12} md={12} lg={12}\n                                    xl={8}>\n                                    <div className='alert-detail__information'>\n                                        {loading || Object.keys(selectedAlert).length === 0\n                                            ? <Spinner animation='border' role='status' className='d-flex mx-auto my-5 text-center'>\n                                                <span className='sr-only'>Loading...</span>\n                                            </Spinner>\n                                            : <>\n                                                <Row>\n                                                    <Col lg={12} xl={5}>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Alert Type</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.behaviourDescription}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Date & Time</Typography>\n                                                            <Typography color='color-3'>{moment(selectedAlert.dateCreated).format('DD/MM/YY h:mm A')}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Broker</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.broker}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Ticker</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.ticker}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Quantity</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.quantity}</Typography>\n                                                        </div>\n                                                    </Col>\n                                                    <Col lg={12} xl={7}>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Client</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.client}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Order Type</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.orderType}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Reason for Flag</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.reasonForFlag}</Typography>\n                                                        </div>\n                                                        <div className='d-flex align-items-center mb-2'>\n                                                            <Typography color='color-3' className='mr-3' weight='semi-bold'>Details</Typography>\n                                                            <Typography color='color-3'>{selectedAlert.resolveReason}</Typography>\n                                                        </div>\n                                                    </Col>\n                                                </Row>\n                                                <Row className='mt-4'>\n                                                    <Col>\n                                                        <FormGroup>\n                                                            <Label for='note'><Typography color='color-3' variant='size-16' weight='bold'>Notes</Typography></Label>\n                                                            <Input type='textarea' name='notes' id='notes'\n                                                                rows={4} defaultValue={selectedAlert.notes} placeholder='Write notes...'\n                                                                onChange={handleChange} invalid={alert.errors.notes} />\n                                                            <FormFeedback className={`${alert.errors.notes ? 'd-block' : 'd-none'}`}>\n                                                                {alert.errors.notesErrMsg}\n                                                            </FormFeedback>\n                                                            <Button label={<>\n                                                                <Typography weight='light' className='my-1 mx-2'>{!submit ? 'Save' : 'Saving...'}</Typography>\n                                                            </>} className='alert-detail__save-bote-button float-right px-4 mt-3'\n                                                            size='lg' onClick={handleUpdateAlert} disabled={submit} />\n                                                        </FormGroup>\n                                                    </Col>\n                                                </Row>\n                                            </>\n                                        }\n                                    </div>\n                                </Col>\n                                <Col lg={12} xl={4} className='mt-4 mt-xl-0'>\n                                    <div className='alert-detail__assignees'>\n                                        <Card>\n                                            <CardBody>\n                                                <FormGroup row={true} className='mb-3'>\n                                                    <Label for='status' lg={12} xl={4}><Typography color='color-3' variant='size-16' weight='bold'>Status</Typography></Label>\n                                                    <Col lg={12} xl={8}>\n                                                        {loading || Object.keys(selectedAlert).length === 0\n                                                            ? <Spinner animation='border' role='status' className='d-flex my-auto text-center'>\n                                                                <span className='sr-only'>Loading...</span>\n                                                            </Spinner>\n                                                            : <Select\n                                                                name='status'\n                                                                defaultValue={{\n                                                                    label: <Badge status={selectedAlert.status} />,\n                                                                    value: <Badge status={selectedAlert.status}/>\n                                                                }}\n                                                                options={[{\n                                                                    name: 'OPEN',\n                                                                    label: <Badge status='Open' />,\n                                                                    value: <Badge status='Open'/>\n                                                                }, {\n                                                                    name: 'IN_REVIEW',\n                                                                    label: <Badge status='In Review' />,\n                                                                    value: <Badge status='In Review'/>\n                                                                }, {\n                                                                    name: 'RESOLVED',\n                                                                    label: <Badge status='Resolved' />,\n                                                                    value: <Badge status='Resolved'/>\n                                                                }, {\n                                                                    name: 'ARCHIVED',\n                                                                    label: <Badge status='Archived' />,\n                                                                    value: <Badge status='Archived'/>\n                                                                }]}\n                                                                onChangeHandler={handleChange} />\n                                                        }\n                                                        <FormText color='muted'>\n                                                            <strong className='text-dark'>Reason:</strong> Sed ut perspiciatis unde\n                                                        </FormText>\n                                                    </Col>\n                                                </FormGroup>\n                                                <FormGroup row={true} className='mb-3'>\n                                                    <Label for='assignee' lg={12} xl={4}><Typography color='color-3' variant='size-16' weight='bold'>Assign to</Typography></Label>\n                                                    <Col lg={12} xl={8}>\n                                                        {loading || Object.keys(selectedAlert).length === 0\n                                                            ? <Spinner animation='border' role='status' className='d-flex my-auto text-center'>\n                                                                <span className='sr-only'>Loading...</span>\n                                                            </Spinner>\n                                                            : <Select\n                                                                name='assignedUser'\n                                                                defaultValue={{\n                                                                    label: selectedAlert.assignedUser,\n                                                                    value: selectedAlert.assignedUser\n                                                                }}\n                                                                options={[{\n                                                                    id: null,\n                                                                    name: 'Unassigned',\n                                                                    label: 'Unassigned',\n                                                                    value: 'Unassigned'\n                                                                },\n                                                                ...assignees.map(assignee => {\n                                                                    return {\n                                                                        id: assignee.id,\n                                                                        name: assignee.fullName,\n                                                                        label: assignee.fullName,\n                                                                        value: assignee.fullName\n                                                                    };\n                                                                })]}\n                                                                onChangeHandler={handleChange} />\n                                                        }\n                                                    </Col>\n                                                </FormGroup>\n                                                <FormGroup row={true} className='mb-3'>\n                                                    <Label for='escalation' lg={12} xl={4}><Typography color='color-3' variant='size-16' weight='bold'>Escalation to</Typography></Label>\n                                                    <Col lg={12} xl={8}>\n                                                        {loading || Object.keys(selectedAlert).length === 0\n                                                            ? <Spinner animation='border' role='status' className='d-flex my-auto text-center'>\n                                                                <span className='sr-only'>Loading...</span>\n                                                            </Spinner>\n                                                            : <Select\n                                                                name='escalation'\n                                                                defaultValue={{\n                                                                    label: selectedAlert.escalation,\n                                                                    value: selectedAlert.escalation\n                                                                }}\n                                                                options={[{\n                                                                    name: 'BASE',\n                                                                    label: 'BASE',\n                                                                    value: 'BASE'\n                                                                }, {\n                                                                    name: 'MANAGER',\n                                                                    label: 'MANAGER',\n                                                                    value: 'MANAGER'\n                                                                }, {\n                                                                    name: 'CO',\n                                                                    label: 'CO',\n                                                                    value: 'CO'\n                                                                }]}\n                                                                onChangeHandler={handleChange} />\n                                                        }\n                                                    </Col>\n                                                </FormGroup>\n                                            </CardBody>\n                                        </Card>\n                                    </div>\n                                    {/* <Typography variant='size-14' className={`playfair-font mt-4 text-danger ${alert.errors.backendErr !== '' ? 'd-block' : 'd-none'}`}>{alert.errors.backendErr}</Typography> */}\n                                </Col>\n                                <Col sm={12} className='mt-4 mt-0-xl mb-2'>\n                                    <div className='alert-detail__activities'>\n                                        <Typography color='color-3' variant='size-26' className='playfair-font mb-4'>Activity</Typography>\n                                        {loading || Object.keys(selectedAlert).length === 0\n                                            ? <Spinner animation='border' role='status' className='my-auto text-center'>\n                                                <span className='sr-only'>Loading...</span>\n                                            </Spinner>\n                                            : <>\n                                                {selectedAlert.alertsActivity.data.length === 0 && <Typography color='color-2' variant='size-16' className='playfair-font mb-4'>No data to show.</Typography>}\n                                                {selectedAlert.alertsActivity.data.map(activity => {\n                                                    return (\n                                                        <div key={activity.id} className='alert-detail__activity-info d-flex align-items-center mb-3'>\n                                                            <span className='activity-icon'><span className='text-light'>{activity.description.charAt(0).toUpperCase()}</span></span>\n                                                            <div className='d-block'>\n                                                                <Typography color='color-3' variant='size-16'>{activity.description}</Typography>\n                                                                <Typography color='color-3' variant='size-12' className='text-muted'>{moment(activity.dateCreated).format('DD/MM/YY h:mm a')}</Typography>\n                                                            </div>\n                                                        </div>\n                                                    );\n                                                })}\n                                                {/* <div className='alert-detail__activity-info d-flex align-items-center'>\n                                                <span className='activity-icon'><span className='text-light'>J</span></span>\n                                                <div className='d-block'>\n                                                    <Typography color='color-3' variant='size-16'>James Allan changed the status from <strong>Open</strong> to <strong className='color-sidebar-2'>In Review</strong>.</Typography>\n                                                    <Typography color='color-3' variant='size-12' className='text-muted'>20/12/20 3:23pm</Typography>\n                                                </div>\n                                            </div> */}\n                                            </>\n                                        }\n                                    </div>\n                                </Col>\n                            </Row>\n                        </CardBody>\n                    </Card>\n                </div>\n            </div>\n        </div>\n    );\n}\n\nconst AlertDetail: any = withLoading<React$Element<Props>>(AlertDetailScreen);\n\nexport default AlertDetail;\n\nconst ErrorMsgModal = ({\n    errMsg,\n    handleCloseModal\n}) => {\n    return (\n        <div className='alert-details__error p-4'>\n            <FontAwesomeIcon className='color-sidebar-2 cursor-pointer float-right mt-2' icon='times' size='lg'\n                onClick={handleCloseModal} />\n            <Typography variant='size-26' color='color-3'\n                className='mb-5 playfair-font'>\n                Something went wrong\n            </Typography>\n            <Alert color='danger' className='mb-5'>\n                <Typography color='color-3' variant='size-16' className='playfair-font'>{errMsg}</Typography>\n            </Alert>\n            <div className='behaviour-detail__edit-parameter-buttons d-flex justify-content-center'>\n                <Button label='OK' variant='light' className='ok-button px-4 mr-2 py-2'\n                    onClick={() => {\n                        handleCloseModal();\n                        window.location.reload();\n                    }} />\n            </div>\n        </div>\n    );\n};\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Select\\Select.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\NormalTable\\NormalTable.js",[],["265","266","267"],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\table.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\makeApiCall.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\AuthenticationService.js",[],["268","269","270"],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\users.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\api\\parameters.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Notifications\\NotificationsContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Notifications\\NotificationsScreen.js",["271","272"],{"ruleId":"273","replacedBy":"274"},{"ruleId":"275","replacedBy":"276"},{"ruleId":"277","replacedBy":"278"},{"ruleId":"279","severity":1,"message":"280","line":1,"column":17,"nodeType":"281","messageId":"282","endLine":1,"endColumn":25},{"ruleId":"279","severity":1,"message":"283","line":227,"column":10,"nodeType":"281","messageId":"282","endLine":227,"endColumn":26},{"ruleId":"273","replacedBy":"284"},{"ruleId":"275","replacedBy":"285"},{"ruleId":"277","replacedBy":"286"},{"ruleId":"279","severity":1,"message":"287","line":125,"column":11,"nodeType":"281","messageId":"282","endLine":125,"endColumn":27},{"ruleId":"273","replacedBy":"288"},{"ruleId":"275","replacedBy":"289"},{"ruleId":"277","replacedBy":"290"},{"ruleId":"273","replacedBy":"291"},{"ruleId":"275","replacedBy":"292"},{"ruleId":"277","replacedBy":"293"},{"ruleId":"279","severity":1,"message":"294","line":4,"column":8,"nodeType":"281","messageId":"282","endLine":4,"endColumn":22},{"ruleId":"295","severity":1,"message":"296","line":52,"column":9,"nodeType":"297","messageId":"298","endLine":52,"endColumn":20},"valid-jsdoc",[],"no-native-reassign",["299"],"no-negated-in-lhs",["300"],"no-unused-vars","'useState' is defined but never used.","