='m-2'/>\n                    )\n                    : (\n                        links.map((link, idx) => {\n                            return <BreadcrumbItem key={idx} active={links.length === idx + 1}><a href='#'>{link}</a></BreadcrumbItem>;\n                        })\n                    )}\n            </Breadcrumb>\n        </div>\n    );\n}\n","D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\charts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\DatePicker\\DatePicker.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Tooltip\\Tooltip.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Badge\\Badge.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Pagination\\Pagination.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\notifications.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\alerts.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\behaviours.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AlertDetail\\AlertDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\BehaviourDetail\\BehaviourDetailScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Select\\Select.js",[],{"ruleId":"218","replacedBy":"219"},{"ruleId":"220","replacedBy":"221"},{"ruleId":"222","replacedBy":"223"},{"ruleId":"224","severity":1,"message":"225","line":2,"column":37,"nodeType":"226","messageId":"227","endLine":2,"endColumn":45},{"ruleId":"224","severity":1,"message":"228","line":2,"column":27,"nodeType":"226","messageId":"227","endLine":2,"endColumn":36},{"ruleId":"224","severity":1,"message":"229","line":6,"column":10,"nodeType":"226"