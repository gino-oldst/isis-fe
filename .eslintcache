ningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"167","usedDeprecatedRules":"94"},{"filePath":"168","messages":"169","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"170","messages":"171","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"172","messages":"173","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"94"},{"filePath":"174","messages":"175","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"176","messages":"177","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"94"},{"filePath":"178","messages":"179","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"94"},{"filePath":"180","messages":"181","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\Old.St Labs\\project-measure-frontend\\src\\index.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\store.js",[],["182","183","184"],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\reportWebVitals.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\App\\AppContainer.js",["185"],"import React from 'react';\r\nimport { Switch, Route, Redirect, useHistory } from 'react-router-dom';\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport Spinner from 'react-bootstrap/Spinner';\r\nimport routes from '../../config/routes';\r\nimport AppLoadingContainer from '../AppLoading/AppLoadingContainer';\r\nimport AppModal from '../../components/base/Modal/Modal';\r\nimport FlashNotification from '../../components/modules/FlashNotification/FlashNotification';\r\nimport WrapperBackground from '../../components/base/WrapperBackground/WrapperBackground';\r\nimport Typography from '../../components/base/Typography/Typography';\r\nimport Navbar from '../../components/base/Navbar/Navbar';\r\nimport { clearModalContent } from '../../redux/modules/modalEvent';\r\nimport { setLoggingOut } from '../../redux/modules/authentication';\r\nimport navbarBrand from '../../assets/logos/mariana_logo.png';\r\n\r\nimport {\r\n    Nav,\r\n    UncontrolledDropdown,\r\n    DropdownItem,\r\n    DropdownMenu,\r\n    DropdownToggle\r\n} from 'reactstrap';\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\n\r\nconst loading = () => (\r\n    <WrapperBackground>\r\n        <Spinner animation='border' role='status'>\r\n            <span className='sr-only'>Loading...</span>\r\n        </Spinner>\r\n    </WrapperBackground>\r\n);\r\n\r\nfunction App() {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n    const { modalContent, onToggle, ...modalEvent } = useSelector(({ modalEvent }) => modalEvent);\r\n    const { isAuthed } = useSelector(({ authentication }) => authentication);\r\n\r\n    const sidebarMenu = [{\r\n        label: 'Dashboard',\r\n        onClick: () => history.push('/dashboard'),\r\n        key: 'dashboard'\r\n    }, {\r\n        label: 'Alerts',\r\n        onClick: () => history.push('/alerts'),\r\n        key: 'alerts'\r\n    }, {\r\n        label: 'Behaviours',\r\n        onClick: () => history.push('/behaviours'),\r\n        key: 'behaviours'\r\n    }];\r\n\r\n    const handleCloseModal = () => {\r\n        dispatch(clearModalContent());\r\n        onToggle && onToggle();\r\n\r\n        // To show modal, do this something like this:\r\n        // dispatch(setModalContent({\r\n        //     modalContent: <LoginContainer />,\r\n        //     title: 'Login'\r\n        // }));\r\n    };\r\n\r\n    const NavbarLinks = () => {\r\n        return (\r\n            <Nav className='navlinks-right'>\r\n                <UncontrolledDropdown nav={true} direction='down' className='d-flex align-self-center mr-4'>\r\n                    <Notifications />\r\n                </UncontrolledDropdown>\r\n                <UncontrolledDropdown nav={true} direction='down' className='mr-4'>\r\n                    <NavbarAccount />\r\n                </UncontrolledDropdown>\r\n            </Nav>\r\n        );\r\n    };\r\n\r\n    return (\r\n        <AppLoadingContainer>\r\n            <div id='outer-container'>\r\n                {/* {isAuthed && <Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>} */}\r\n                {<Navbar navbarBrand={navbarBrand}><NavbarLinks /></Navbar>}\r\n                <React.Suspense fallback={loading()}>\r\n                    <Switch>\r\n                        {routes.map((route, i) => (\r\n                            route.authedRoute\r\n                                ? <PrivateRoute key={i} {...route} sidebarMenu={sidebarMenu}\r\n                                    handleCloseModal={handleCloseModal}\r\n                                    isAuthed={isAuthed} />\r\n                                : <RouteWithSubRoutes key={i} {...route} handleCloseModal={handleCloseModal} />\r\n                        ))}\r\n                    </Switch>\r\n                </React.Suspense>\r\n            </div>\r\n\r\n            <FlashNotification/>\r\n            <AppModal\r\n                {...modalEvent}\r\n                isShow={!!modalContent}\r\n                onToggle={handleCloseModal}>\r\n                {modalContent}\r\n            </AppModal>\r\n        </AppLoadingContainer>\r\n    );\r\n}\r\n\r\nconst Notifications = () => {\r\n    return (\r\n        <div className='navbar__notifications'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__notification-bell' icon='bell' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true} className='mt-2 pb-4 navbar__navbar__notifications-dropdown'>\r\n                <DropdownItem header={true} tag='div' style={{ cursor: 'default' }}>\r\n                    <Typography weight='semi-bold' className='py-2 pb-4'>Notifications</Typography>\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\nconst NavbarAccount = () => {\r\n    const history = useHistory();\r\n    const dispatch = useDispatch();\r\n\r\n    const logout = () => {\r\n        localStorage.clear();\r\n        dispatch(setLoggingOut());\r\n        history.push('/login');\r\n    };\r\n\r\n    return (\r\n        <div className='navbar__account'>\r\n            <DropdownToggle nav={true} className='d-flex'>\r\n                <FontAwesomeIcon className='navbar__user-icon' icon='user-circle' size='lg'\r\n                    color='gray' />\r\n            </DropdownToggle>\r\n            <DropdownMenu right={true}>\r\n                <DropdownItem onClick={() => history.push('/reset-password')}>\r\n                    Change Password\r\n                </DropdownItem>\r\n                <DropdownItem onClick={logout}>\r\n                    Logout\r\n                </DropdownItem>\r\n            </DropdownMenu>\r\n        </div>\r\n    );\r\n};\r\n\r\n// A special wrapper for <Route> that knows how to\r\n// handle \"sub\"-routes by passing them in a `routes`\r\n// prop to the component it renders.\r\nfunction RouteWithSubRoutes({ component: Component, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route\r\n            {...rest}\r\n            render={props => (\r\n                // pass the sub-routes down to keep nesting\r\n                <Component {...props} routes={props.routes} handleCloseModal={handleCloseModal} />\r\n            )} />\r\n    );\r\n}\r\n\r\nfunction PrivateRoute({ component: Component, isAuthed, sidebarMenu, handleCloseModal, ...rest }) {\r\n    return (\r\n        <Route {...rest} render={(routeProps) => (\r\n            <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            // isAuthed\r\n            //     ? <Component {...routeProps} sidebarMenu={sidebarMenu} handleCloseModal={handleCloseModal} />\r\n            //     : <Redirect to={{\r\n            //         pathname: '/login',\r\n            //         state: { from: routeProps.location }\r\n            //     }}/>\r\n        )}/>\r\n    );\r\n}\r\n\r\nexport default App;\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\reducers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\AppLoading\\AppLoadingContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\modalEvent.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\routes.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\WrapperBackground\\WrapperBackground.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Modal\\Modal.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Navbar\\Navbar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\FlashNotification\\FlashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\authentication.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\redux\\modules\\flashNotification.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Auth.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Storage.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\config\\constants.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Typography\\Typography.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginContainer.js",["186","187","188","189"],"// @flow\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useDispatch } from 'react-redux';\r\nimport { useHistory } from 'react-router-dom';\r\n\r\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome';\r\nimport { faCoffee } from '@fortawesome/free-solid-svg-icons';\r\nimport Login from './LoginScreen';\r\nimport { isValidEmail } from '../../utils/helpers';\r\nimport { authUser } from '../../redux/modules/authentication';\r\nimport { saveAuthorizationToken, checkAuthorization } from '../../utils/Auth';\r\nimport { setFlashNotification } from '../../redux/modules/flashNotification';\r\n\r\ntype Props = {\r\n    handleCloseModal: Function\r\n}\r\n\r\nexport default function LoginContainer({\r\n    handleCloseModal\r\n}: Props): React$Element<any> {\r\n    const dispatch = useDispatch();\r\n    const history = useHistory();\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [errMsg, setErrMsg] = useState('');\r\n    const [loginForm, setLoginForm] = useState({\r\n        email: '',\r\n        password: ''\r\n    });\r\n\r\n    // check if user is logged in\r\n    // useEffect(() => {\r\n    //     checkAuth();\r\n    // }, []);\r\n\r\n    // const checkAuth = async () => {\r\n    //     const auth = await checkAuthorization();\r\n\r\n    //     if (auth) history.push('/dashboard');\r\n    // };\r\n\r\n    const onSubmit = async e => {\r\n        setIsLoading(true);\r\n        setErrMsg('');\r\n        e.preventDefault();\r\n\r\n        try {\r\n            if (isValidEmail(loginForm.email) && loginForm.password) {\r\n                // const response = await userLogin(loginForm);\r\n\r\n                // if (Object.keys(response).length === 0) {\r\n                //     setErrMsg('Invalid email!');\r\n                // } else if (response.data.message) {\r\n                //     setErrMsg(response.data.message);\r\n                // } else {\r\n                //     const { data } = response;\r\n\r\n                //     localStorage.setItem('userId', data.userId);\r\n                //     saveAuthorizationToken(data.token);\r\n                //     dispatch(authUser({\r\n                //         email: loginForm.email\r\n                //     }));\r\n\r\n                //     history.replace('/dashboard');\r\n                // }\r\n\r\n                localStorage.setItem('userId', 1);\r\n                saveAuthorizationToken('temp_token');\r\n                dispatch(authUser({\r\n                    email: loginForm.email\r\n                }));\r\n\r\n                history.replace('/dashboard');\r\n            }\r\n        } catch (err) {\r\n            dispatch(setFlashNotification({\r\n                message: 'ERROR',\r\n                isError: true\r\n            }));\r\n        }\r\n    };\r\n\r\n    const onChange = e => {\r\n        const { name, value } = e.target;\r\n\r\n        setLoginForm({\r\n            ...loginForm,\r\n            [name]: value\r\n        });\r\n    };\r\n\r\n    return <Login\r\n        onSubmit={onSubmit}\r\n        onChange={onChange}\r\n        isLoading={isLoading}\r\n        errMsg={errMsg}\r\n        setErrMsg={setErrMsg}\r\n        handleCloseModal={handleCloseModal} />;\r\n}\r\n","D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\Button\\Button.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Login\\LoginScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\helpers.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\NotFound\\NotFoundScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Dashboard\\DashboardScreen.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebarContainer.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\modules\\withLoading\\withLoading.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\utils\\Route.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\components\\base\\CollapsibleSidebar\\CollapsibleSidebar.js",[],"D:\\Old.St Labs\\project-measure-frontend\\src\\containers\\Alerts\\Ale